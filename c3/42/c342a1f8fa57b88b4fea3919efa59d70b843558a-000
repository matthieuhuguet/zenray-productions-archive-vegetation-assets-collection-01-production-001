def iteration3(net, h, c):
    """ITERATION 3 (64 nodes). Zoom 2x on the reference: (a) the light petal is made of broad vertical STRIPES of different brightness (about 0.012 wide) whose fine lines slant and CONVERGE toward the bottom of the arch edge; (b) the surface is covered with small round BUBBLES (8 px), bright with a dark rim, on the dark band and the light petal; (c) a column of beads runs along the arch axis. Ours had straight hug lines, big irregular blobs and a bare arch."""
    lv, ax, wA, ma, q, r = c['lv'], c['ax'], c['wA'], c['ma'], c['q'], c['r']
    n0 = len(net.children()); b = V.box(net, 'J', 'BAND 1 V2 ITERATION 3 : 64 nodes, stripes, converging lines, bubbles', (0.8, 1.0, 0.8))
