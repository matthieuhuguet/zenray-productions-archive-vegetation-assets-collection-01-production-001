    outside = T.mix(net, 'C03c_outside', light_t, T.mix(net, 'C03d_band_delta', T.mix(net, 'C03e_band_minus_light', ql, light_t, 4), T.smooth(net, 'C03f_band_blend', q, 0.93, 1.0), 5), 3)
    arch = T.curve(net, 'C04_arch__tone', r, AR, 1.0, 0.0, 1.0, T.SMOOTH)
    h = T.mix(net, 'C05_composition', outside, T.mix(net, 'C05a_arch_delta', T.mix(net, 'C05b_delta', arch, outside, 4), ma, 5), 3)
    ctx = dict(lv=lv, ax=ax, wA=wA, ma=ma, q=q, r=r, d_arch=d_arch, zero=zero, rx=rx)
    if UPTO >= 1: h = iteration1(net, h, ctx)
