    wA = T.curve(net, 'B01_arch__halfwidth', lv, [(x, y / 0.1) for x, y in WA], 1.0, 0.0, 0.1, T.SMOOTH)
    d_arch = T.mix(net, 'B02_arch__distance_inside', wA, ax, 4); ma = T.smooth(net, 'B03_arch__mask', d_arch, -EDGE, EDGE)
    span = T.mix(net, 'B04_light__span', T.curve(net, 'B04a_band_edge_curve', lv, [(x, y / 0.2) for x, y in DBC], 1.0, 0.0, 0.2, T.SMOOTH), wA, 4)
    q = T.node(net, 'clamp', 'B06_light__q', [T.mix(net, 'B05_light__q_raw', T.mix(net, 'B05a_ax_minus_wa', ax, wA, 4), T.mix(net, 'B05b_span_floor', span, T.const(net, 'B05c_floor', lv, 0.004), 12), 6)])
    q = T.mix(net, 'B07_light__q_limited', q, T.const(net, 'B07a_const__qmax', lv, 1.0), 13) if False else q
    r = T.node(net, 'clamp', 'B08_arch__r', [T.mix(net, 'B08a_ax_over_wa', ax, T.mix(net, 'B08b_wa_floor', wA, T.const(net, 'B08c_floor', lv, 0.004), 12), 6)])
    # tone of the outside (light petal and dark band) and of the arch, each from a measured table
    # light petal = level(lv) + ribbon profile(q): the ribbons are level curves of q (row to row correlation 0.79 in q against 0.23 in |dx|, measured), tabulated on the symmetrised cell at 41 points; the dark band keeps the coarse table QL
