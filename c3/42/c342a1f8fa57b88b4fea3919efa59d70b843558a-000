    lv, ax, wA, ma, q, r = c['lv'], c['ax'], c['wA'], c['ma'], c['q'], c['r']
    n0 = len(net.children()); b = V.box(net, 'G', 'BAND 1 V2 ITERATION 1 : 64 nodes, fibres', (0.7, 0.9, 1.0))
    soft = T.node(net, 'fractalnoise', 'G00_soft_phase_noise', [lv], amp=0.5, center=0.0, elementsize=0.16)
    d_out = T.mix(net, 'G01_light__distance_outside', ax, wA, 4)
    light = T.mix(net, 'G02_light__mask', T.lin(net, 'G02a_not_arch', ma, 0.0, 1.0, 1.0, 0.0), T.lin(net, 'G02b_not_band', T.smooth(net, 'G02c_band', q, 0.92, 0.99), 0.0, 1.0, 1.0, 0.0), 5)
    lm = T.mix(net, 'G04_light__modulated', light, V.modulation(net, 'G03_light__modulation', lv, 0.10, 0.5, 2.5, 8.8, 0.2), 5)
    h = V.lines_layer(net, 'G11_hug_lines_main', h, d_out, 75, soft, 0.12, 0.07, 0.30, lm, lv)
    h = V.lines_layer(net, 'G12_hug_lines_bold', h, d_out, 28, soft, 0.12, 0.08, 0.28, lm, lv)
