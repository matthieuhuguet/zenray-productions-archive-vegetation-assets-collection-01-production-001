def iteration4(net, h, c):
    """ITERATION 4 (64 nodes): crisp ribbon edges and fine striation. The ribbon profile in q is smooth (mean over rows); the reference ribbons end on THIN lines that converge with them: dark lines where the profile drops (q 0.44, 0.79, 0.07), bright lines where it rises (q 0.22, 0.62), plus two scales of fine striation along q (the lines are level curves of q, not of |dx|), lines in the arch that start and stop, and a bright line in the middle of the dark band."""
    lv, ax, wA, ma, q, r = c['lv'], c['ax'], c['wA'], c['ma'], c['q'], c['r']
    n0 = len(net.children()); b = V.box(net, 'K', 'BAND 1 V2 ITERATION 4 : 64 nodes, crisp ribbon edges, striation', (1.0, 0.85, 0.85))
    soft = net.node('G00_soft_phase_noise'); light = T.mix(net, 'K01_light__mask', T.lin(net, 'K01a_not_arch', ma, 0.0, 1.0, 1.0, 0.0), T.lin(net, 'K01b_not_band', T.smooth(net, 'K01c_band', q, 0.92, 0.99), 0.0, 1.0, 1.0, 0.0), 5)
    for tag, q0, amp in (('K11_dark_a', 0.44, -0.10), ('K12_dark_b', 0.79, -0.10), ('K13_bright_a', 0.22, 0.09)):
