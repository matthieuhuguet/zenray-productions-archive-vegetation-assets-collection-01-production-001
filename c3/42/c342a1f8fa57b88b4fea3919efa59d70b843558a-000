    am = T.mix(net, 'G22_arch__modulated', ma, V.modulation(net, 'G21_arch__modulation', lv, 0.10, 0.3, 3.0, 3.3, 0.2), 5)
    h = V.lines_layer(net, 'G23_arch_streaks', h, ax, 160, soft, 0.20, 0.03, 0.45, am, lv)
