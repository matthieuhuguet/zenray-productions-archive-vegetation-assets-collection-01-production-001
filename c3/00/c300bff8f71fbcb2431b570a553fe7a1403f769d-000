# 5 October 2026 : closes the measuring loop of the trim sheet without a human: runs TrimLab.py, reads the per band statistics of the generated height against the reference, and updates ref-maps/trim_calib.json (a detail multiplier from the gradient energy ratio, a level gain from the standard deviation ratio and an offset from the mean) with damping, N rounds. The reference is only read by the lab, never by the graph. Usage: python3 Calibrate.py [rounds=3]. FR : boucle de calage automatique sur les mesures.
import json, subprocess, sys, os
B = '/Users/zenray/Create/Build/Productions/ZenRayHoudini/VegetationCollection01/'
P = B + 'ref-maps/trim_calib.json'
cal = json.load(open(P)) if os.path.exists(P) else {'detail': [1.0] * 7, 'gain': [1.0] * 7, 'offset': [0.0] * 7}
rounds = int(sys.argv[1]) if len(sys.argv) > 1 else 3
for rd in range(rounds):
    json.dump(cal, open(P, 'w'), indent=1)
    out = subprocess.run(['python3', B + 'Scripts/TrimLab.py', 'cal%d' % rd, '1024'], capture_output=True, text=True).stdout
    rows = json.load(open(B + 'previews/trim_lab_cal%d.json' % rd)); err = []
    for i, r in enumerate(rows):
        g, f = r['gen'], r['ref']
        ratio = f['grad'] / max(g['grad'], 1e-4)
        m0 = (g['mean'] - cal['offset'][i]) / cal['gain'][i]; s0 = g['std'] / cal['gain'][i]          # statistics before the level stage
        cal['detail'][i] = float(min(6.0, max(0.5, cal['detail'][i] * min(2.0, max(0.5, ratio)) ** 0.5)))
        gain = min(2.0, max(0.5, f['std'] / max(s0, 1e-3))); cal['gain'][i] = float(gain); cal['offset'][i] = float(f['mean'] - gain * m0)
        err.append(abs(f['mean'] - g['mean']) + abs(f['std'] - g['std']) + abs(f['grad'] - g['grad']))
    print('round', rd, 'error per band', [round(e, 3) for e in err], 'total %.3f' % sum(err), flush=True)
json.dump(cal, open(P, 'w'), indent=1); print(json.dumps(cal))
