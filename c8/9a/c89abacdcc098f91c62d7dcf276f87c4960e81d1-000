# 6 October 2026 : runs in the ZenRayShards editor (queue). Renders a whole Cinematics sequence of L_LilyBed through the Movie Render Queue, everything from lily_params.json 'bed_render' (sequence, frames, res, samples, output). No level or light is modified. FR : rendu MRQ d'une sequence de L_LilyBed.
import unreal, json
B = '/Users/zenray/Create/Build/Productions/ZenRayHoudini/VegetationCollection01/'
P = json.load(open(B + 'unreal/lily_params.json')); R = P['bed_render']; les = unreal.get_editor_subsystem(unreal.LevelEditorSubsystem)
if unreal.EditorLevelLibrary.get_editor_world().get_name() != 'L_LilyBed': les.load_level(P['bed']['level'])
world = unreal.EditorLevelLibrary.get_editor_world(); assert world.get_name() == 'L_LilyBed'
sub = unreal.get_editor_subsystem(unreal.MoviePipelineQueueSubsystem); queue = sub.get_queue(); queue.delete_all_jobs(); j = queue.allocate_new_job(unreal.MoviePipelineExecutorJob); j.sequence = unreal.SoftObjectPath(R['sequence'])
j.map = unreal.SoftObjectPath(world.get_path_name().split('.')[0] + '.' + world.get_name()); j.job_name = R['prefix']; cfg = j.get_configuration()
out = cfg.find_or_add_setting_by_class(unreal.MoviePipelineOutputSetting); out.output_resolution = unreal.IntPoint(R['res'], R['res']); out.output_directory = unreal.DirectoryPath(R['out']); out.file_name_format = R['prefix'] + '_{frame_number}'; out.zero_pad_frame_numbers = 4; out.override_existing_output = True; out.use_custom_playback_range = True; out.custom_start_frame = 0; out.custom_end_frame = R['frames']
cfg.find_or_add_setting_by_class(unreal.MoviePipelineDeferredPassBase); cfg.find_or_add_setting_by_class(unreal.MoviePipelineImageSequenceOutput_PNG)
aa = cfg.find_or_add_setting_by_class(unreal.MoviePipelineAntiAliasingSetting); aa.override_anti_aliasing = True; aa.anti_aliasing_method = unreal.AntiAliasingMethod.AAM_NONE; aa.spatial_sample_count = R['spatial']; aa.temporal_sample_count = 1; aa.render_warm_up_count = R['warmup']; aa.engine_warm_up_count = R['warmup']
cv = cfg.find_or_add_setting_by_class(unreal.MoviePipelineConsoleVariableSetting); cv.add_or_update_console_variable('r.DepthOfFieldQuality', 0)
sub.render_queue_with_executor(unreal.MoviePipelinePIEExecutor); print('render started', R['sequence'], R['res'])
