json.dump(dict(movie=tag, fps=FPS, size=[SQ, SQ], picture=[W, H], seconds=round(total_s, 3), turn_over_included=turn, title=TITLE, music=MUSIC, timeline=[dict(start=round(a, 3), end=round(b, 3), shot=n, source=s) for a, b, n, s in rows]), open(OUT + tag + '.manifest.json', 'w'), indent=1)
shutil.rmtree(WORK); print(tag, round(total_s, 2), 's', 'turn over' if turn else 'WITHOUT turn over')
