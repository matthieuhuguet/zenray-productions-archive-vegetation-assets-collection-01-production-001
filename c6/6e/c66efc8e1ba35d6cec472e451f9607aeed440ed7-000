run(['ffmpeg', '-y', '-f', 'concat', '-safe', '0', '-i', WORK + 'segs.txt', '-c', 'copy', WORK + 'body.mp4'])
total_frames = frames_abc; total_s = total_frames / float(FPS)
# the title: opaque cream movie, YELLOW text with a soft black shadow. Alpha rebuilt per frame: text = red minus blue is large (yellow), shadow = red darker than the cream.
for f in glob.glob(WORK + 'title/*.png'): os.remove(f)
run(['ffmpeg', '-y', '-i', TITLE, '-t', '5', '-vf', 'fps=%d,scale=1920:1080:flags=lanczos' % FPS, WORK + 'title/raw_%04d.png'])
for f in sorted(glob.glob(WORK + 'title/raw_*.png')):
    a = np.asarray(Image.open(f).convert('RGB'), float); R, G, B = a[..., 0], a[..., 1], a[..., 2]
    text = np.clip(((R - B) - 12.0) / (255.0 - 12.0), 0, 1)
    shadow = np.clip((243.0 - 2.0 - R) / (243.0 - 2.0), 0, 1) * (1 - np.clip(text * 3, 0, 1))
    alpha = np.maximum(text, shadow * 0.9)
    col = np.dstack([np.where(text > 0.02, 255.0, 0.0), np.where(text > 0.02, 255.0, 0.0), np.zeros_like(R)])
    rgba = np.dstack([col, alpha * 255.0]).astype('uint8'); Image.fromarray(rgba).save(f.replace('raw_', 't_')); os.remove(f)
vf = "[0:v][1:v]overlay=0:%d:eof_action=pass,format=yuv420p[v]" % ((SQ - 1080) // 2)
af = 'afade=t=in:st=0:d=0.4,afade=t=out:st=%.3f:d=1.5' % (total_s - 1.5)
base = ['ffmpeg', '-y', '-i', WORK + 'body.mp4', '-framerate', str(FPS), '-i', WORK + 'title/t_%04d.png', '-i', MUSIC, '-filter_complex', vf, '-map', '[v]', '-map', '2:a', '-af', af, '-t', '%.3f' % total_s, '-r', str(FPS)]
tag = 'LilyHeightToRender_' + VER + ('' if turn else '_placeholderhook')
run(base + ['-c:v', 'hevc_videotoolbox', '-b:v', '18M', '-tag:v', 'hvc1', '-color_primaries', 'bt709', '-color_trc', 'bt709', '-colorspace', 'bt709', '-c:a', 'aac', '-b:a', '320k', '-movflags', '+faststart', OUT + tag + '.mov'])
run(base + ['-c:v', 'libx264', '-crf', '17', '-pix_fmt', 'yuv420p', '-c:a', 'aac', '-b:a', '320k', '-movflags', '+faststart', OUT + tag + '.mp4'])
# index: every file of the movie, where it comes from, and its time on the timeline
