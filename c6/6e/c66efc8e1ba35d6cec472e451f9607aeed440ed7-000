import os, sys, glob, json, subprocess, shutil
import numpy as np
from PIL import Image
P = '/Users/zenray/Create/Build/Productions/ZenRayHoudini/VegetationCollection01/'
TMP = '/Users/zenray/.claude/tmp/tmp-vegetation-assets-collection-01/'
VER = sys.argv[1] if len(sys.argv) > 1 else 'v001'
OUT = P + 'video/'; WORK = OUT + '_work/'
