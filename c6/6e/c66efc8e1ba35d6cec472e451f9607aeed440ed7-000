def run(cmd): subprocess.run(cmd, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
def prep(src, name):
    """a shot on the SQUARE canvas: a square picture (trim sheet) fills it, any other picture is fitted to 1920 x 1112 with black bars above and below."""
    im = Image.open(src)
    if im.mode == 'RGBA': bg = Image.new('RGBA', im.size, (118, 118, 118, 255)); bg.alpha_composite(im); im = bg
    im = im.convert('RGB'); canvas = Image.new('RGB', (SQ, SQ), (0, 0, 0))
    if abs(im.size[0] - im.size[1]) < 4: canvas = im.resize((SQ, SQ), Image.LANCZOS)
    else: canvas.paste(im.resize((W, H), Image.LANCZOS), (0, (SQ - H) // 2))
    p = WORK + 'imgs/' + name + '.png'; canvas.save(p); return p
HOOK = 144                                         # 6 s: the 72 turn over frames at HALF speed (Matthieu, 6 October 2026), in-between frames by motion interpolation
tf = sorted(glob.glob(P + 'render/turntable_top/turn_*.png')); turn = len(tf) >= 72 and not subprocess.run(['pgrep', '-x', 'husk'], capture_output=True).stdout.strip()
hook = []; rest = []
if not turn: hook.append(('hook_top_render_placeholder', P + 'render/lily_4views_top_4k.png', HOOK))
rest.append(('trimsheet_basecolor', P + 'maps/trim/lily_trim_basecolor.png', 36)); rest.append(('trimsheet_height', P + 'maps/trim/lily_trim_height.png', 36))
