def seg_from_shots(shots, out):
    lst = ['ffconcat version 1.0']
    for name, src, n in shots: lst += ["file '%s'" % prep(src, name), 'duration %.6f' % (n / float(FPS))]
    lst.append("file '%s'" % (WORK + 'imgs/' + shots[-1][0] + '.png'))
    open(out + '.txt', 'w').write('\n'.join(lst))
    run(['ffmpeg', '-y', '-f', 'concat', '-safe', '0', '-i', out + '.txt', '-vf', 'fps=%d,format=yuv420p' % FPS, '-frames:v', str(sum(n for _, _, n in shots)), '-c:v', 'libx264', '-crf', '8', out])      # 6 October 2026: bounded to the exact frame count, a concat of one image otherwise lasts twice as long
segs = []
if hook: seg_from_shots(hook, WORK + 'seg_hook.mp4')
else:
    os.makedirs(WORK + 'turn', exist_ok=True)
    for k in range(1, 73):      # the Karma frames are transparent: put them on the grey 118 of the other renders
        im = Image.open(P + 'render/turntable_top/turn_%04d.png' % k).convert('RGBA'); bg = Image.new('RGBA', im.size, (118, 118, 118, 255)); bg.alpha_composite(im)
        bg.convert('RGB').resize((W, H), Image.LANCZOS).save(WORK + 'turn/g_%04d.png' % k)
    run(['ffmpeg', '-y', '-framerate', str(FPS), '-i', WORK + 'turn/g_%04d.png', '-vf', 'setpts=2*PTS,minterpolate=fps=%d:mi_mode=mci:mc_mode=aobmc:me_mode=bidir:vsbmc=1,pad=%d:%d:0:%d:color=black,format=yuv420p' % (FPS, SQ, SQ, (SQ - H) // 2), '-frames:v', str(HOOK), '-c:v', 'libx264', '-crf', '8', WORK + 'seg_hook.mp4'])
