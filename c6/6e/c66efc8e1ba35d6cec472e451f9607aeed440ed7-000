seg_from_shots(rest, WORK + 'seg_rest.mp4'); segs.append(WORK + 'seg_rest.mp4')
shots = (hook if hook else [('hook_turn_over_72_frames_half_speed', P + 'render/turntable_top/turn_0001..0072.png', HOOK)]) + rest
frames_abc = sum(n for _, _, n in shots)
