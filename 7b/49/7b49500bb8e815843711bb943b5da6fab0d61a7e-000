    for c, v in zip(ch[:9], (pos.x, pos.y, pos.z, rot.roll, rot.pitch, rot.yaw, 1.0, 1.0, 1.0)): c.add_key(unreal.FrameNumber(i), v, interpolation=unreal.MovieSceneKeyInterpolation.CONSTANT)
