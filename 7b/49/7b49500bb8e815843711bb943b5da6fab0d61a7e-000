# 6 October 2026 : runs in the ZenRayShards editor (queue). STORYBOARD of the lily orbit: one frame per (elevation, azimuth) keyed on a camera in LS_LilyStoryboard, rendered by the Movie Render Queue at low resolution (Matthieu: "3 propositions d'angle, 5 images sur 5 secondes"). Everything is in lily_params.json 'storyboard'. FR : planche de 15 images basse resolution, 3 elevations x 5 azimuts, puis arret.
import unreal, json, math
B = '/Users/zenray/Create/Build/Productions/ZenRayHoudini/VegetationCollection01/'
P = json.load(open(B + 'unreal/lily_params.json')); S = P['storyboard']; C = P['camera']; V = unreal.Vector
les = unreal.get_editor_subsystem(unreal.LevelEditorSubsystem); eas = unreal.get_editor_subsystem(unreal.EditorActorSubsystem); eal = unreal.EditorAssetLibrary
if unreal.EditorLevelLibrary.get_editor_world().get_name() != P['level'].rsplit('/', 1)[1]: les.load_level(P['level'])
world = unreal.EditorLevelLibrary.get_editor_world()
for a in eas.get_all_level_actors():
    if a.get_actor_label() == 'LilyStoryCam': eas.destroy_actor(a)
aim = V(*P['aim_cm']); cam = eas.spawn_actor_from_class(unreal.CineCameraActor, V(0, 0, 0)); cam.set_actor_label('LilyStoryCam')
cc = cam.get_cine_camera_component(); cc.set_editor_property('current_focal_length', C['focal_mm']); fb = cc.filmback; fb.sensor_width = C['sensor_width_mm']; fb.sensor_height = C['sensor_height_mm']; cc.set_editor_property('filmback', fb)
SD, SN = '/Game/ZenRayShards/Cinematics', 'LS_LilyStoryboard'
if eal.does_asset_exist(SD + '/' + SN):
    seq = eal.load_asset(SD + '/' + SN)
    for b in list(unreal.MovieSceneSequenceExtensions.get_bindings(seq)): unreal.MovieSceneBindingExtensions.remove(b)
