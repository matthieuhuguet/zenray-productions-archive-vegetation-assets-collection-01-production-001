    return dict(rx=rx, lv=lv, soft=soft, Hc=Hc, P=P, cells=cells)
def ellipse(net, tag, c, h, x0, y0, rx_c, ry_lv, tone_keys, shear=0.0, edge=0.04):
    """a vertical ellipse of the periodic cell: centre (x0 cell local canvas fraction, y0 lv), half axes rx_c (canvas) and ry_lv (lv units), domed tone against r, composited over h. 8 nodes (+2 with shear). Returns (h, mask)."""
    P, Hc = c['P'], c['Hc']
    dx = T.lin(net, '%s_dx' % tag, c['rx'], 0.0, 1.0, (-P / 2 - x0) / rx_c, (P / 2 - x0) / rx_c)
    dy = T.lin(net, '%s_dy' % tag, c['lv'], 0.0, 1.0, -y0 / ry_lv, (1 - y0) / ry_lv)
    if shear: dx = T.mix(net, '%s_dx_sheared' % tag, dx, T.lin(net, '%s_shear' % tag, dy, -4.0, 4.0, -4.0 * shear, 4.0 * shear), 4)
    r = T.mix(net, '%s_r' % tag, dx, dy, 8)
    mask = T.smooth(net, '%s_mask' % tag, r, 1 - edge, 1 + edge, 1.0, 0.0)
    tone = T.curve(net, '%s_tone' % tag, r, tone_keys, 1.4, 0.0, 1.0, T.SMOOTH)
    return T.mix(net, '%s_composited' % tag, h, T.mix(net, '%s_delta_masked' % tag, T.mix(net, '%s_delta' % tag, tone, h, 4), mask, 5), 3), mask
