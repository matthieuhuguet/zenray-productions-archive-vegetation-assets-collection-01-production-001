def stem(net):
    """STEM: hairs. Tone profile (darker top and bottom edges), tiling streak noise, two crossing families of thin oblique hair lines made of Ramp-based coordinates (period exact, so the band tiles), sparse bright bumps."""
    c = prelude(net, 4); lv = c['lv']; rx = c['rx']; one = T.const(net, 'B02_one', lv, 1.0)
    h = T.curve(net, 'B00_tone_vertical', lv, [(0.0, 0.28), (0.08, 0.40), (0.2, 0.46), (0.8, 0.44), (0.95, 0.36), (1.0, 0.30)], 1.0)
    for i, (size, amp, sx, sy, seed) in enumerate([(0.03, 0.05, 1.0, 0.4, 2.2), (0.012, 0.05, 1.0, 0.3, 5.5), (0.004, 0.05, 1.0, 0.25, 9.1)]): h = V.grain(net, 'C1%d_streaks' % i, h, lv, one, size, seed, amp, sx, sy)
    dens = V.modulation(net, 'C20_hair_density', lv, 0.03, 0.5, 0.5, 7.7, 0.1)
    for i, (sl, cnt, depth) in enumerate([(0.9, 380, 0.10), (-0.9, 330, 0.09), (0.35, 520, 0.07)]):
        coord = T.mix(net, 'C3%d_hair_coord' % i, T.lin(net, 'C3%da_x' % i, rx, 0.0, 1.0, 0.0, 1.0), T.lin(net, 'C3%db_y' % i, lv, 0.0, 1.0, 0.0, sl * c['Hc']), 3)
        h = V.lines_layer(net, 'C4%d_hair_lines' % i, h, coord, cnt, c['soft'], 0.8, depth, 0.30, dens, lv)
    h = V.dots_layer(net, 'C50_bumps', h, lv, one, 0.006, 4.1, 0.60, 0.22)
    return h
