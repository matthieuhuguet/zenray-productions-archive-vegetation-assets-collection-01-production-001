# 5 October 2026 : MASK based measurement of the reference trim height, per band. The foreground of each band (the petal, wedge, anther, leaf, bud as opposed to the dark ground between them) is segmented by a local threshold between the ground level and the object level (Otsu on the band), cleaned, then folded on the band's repeat period (cells per width: A 3, B 3, C 3, D 7, E 1, F 2, G 3) to give a MEAN PROFILE of the outline: for 64 samples across one cell, the top and the bottom edge of the object (as fractions of the band height) and the fill ratio. These few numbers (not the image) parametrise the generated shapes. Output ref-maps/trim_profiles.json and previews/trim_masks.png. FR : mesure des contours par masques, repliee sur la periode.
import numpy as np, json
from PIL import Image
from scipy import ndimage as ndi
B = '/Users/zenray/Create/Build/Productions/ZenRayHoudini/VegetationCollection01/'
im = np.asarray(Image.open('/Users/zenray/.claude/tmp/tmp-vegetation-assets-collection-01/refs/flower-sheets/03_gen_trimsheet-height_v1.png').convert('L').resize((1024, 1024), Image.LANCZOS), np.float32) / 255.0
N = 1024
BANDS = [('tepal_inner', 0.0, 0.193, 3), ('tepal_outer', 0.193, 0.388, 3), ('stamens', 0.388, 0.507, 3), ('calyx', 0.507, 0.609, 7), ('stem', 0.609, 0.725, 1), ('leaf', 0.725, 0.837, 2), ('bud', 0.837, 1.0, 3)]
def otsu(x):
    h, e = np.histogram(x, 128, (0, 1)); p = h / h.sum(); w = np.cumsum(p); m = np.cumsum(p * (e[:-1] + e[1:]) / 2); mt = m[-1]
    s = (mt * w - m) ** 2 / (w * (1 - w) + 1e-9); return float(e[np.argmax(s)])
out = {}; tiles = []
for name, a, b, cells in BANDS:
    y0, y1 = int(a * N) + 4, int(b * N) - 4; band = im[y0:y1]; H = band.shape[0]
    sm = ndi.gaussian_filter(band, 2.0); t = otsu(sm); fg = sm > t
    fg = ndi.binary_opening(fg, iterations=2); fg = ndi.binary_closing(fg, iterations=3); fg = ndi.binary_fill_holes(fg)
    lab, n = ndi.label(fg); sizes = ndi.sum(fg, lab, range(1, n + 1)); keep = [i + 1 for i, s_ in enumerate(sizes) if s_ > 0.003 * fg.size]; fg = np.isin(lab, keep)
    # fold on the period; the cell origin is the cell boundary u = k / cells
    W = N // cells; top = np.zeros(64); bot = np.zeros(64); fill = np.zeros(64)
    for i in range(64):
        cols = [int((c + (i + 0.5) / 64.0) * W) % N for c in range(cells)]; ts = []; bs = []; fs = []
        for x in cols:
            col = fg[:, x]
            if col.any(): ys = np.nonzero(col)[0]; ts.append(ys.min() / H); bs.append(ys.max() / H); fs.append(col.mean())
            else: fs.append(0.0)
        top[i] = np.mean(ts) if ts else 1.0; bot[i] = np.mean(bs) if bs else 1.0; fill[i] = np.mean(fs)
    ground = float(np.median(band[~fg])) if (~fg).any() else float(np.percentile(band, 10)); obj = float(np.median(band[fg])) if fg.any() else float(np.percentile(band, 90))
    out[name] = dict(cells=cells, threshold=t, fg_fraction=float(fg.mean()), ground=ground, object=obj, top=[round(float(v), 4) for v in top], bottom=[round(float(v), 4) for v in bot], fill=[round(float(v), 4) for v in fill])
    print('%-12s threshold %.2f fg %.2f ground %.2f object %.2f' % (name, t, fg.mean(), ground, obj))
    tiles.append(np.concatenate([band, np.ones((H, 6), np.float32), fg.astype(np.float32)], 1))
json.dump(out, open(B + 'ref-maps/trim_profiles.json', 'w'), indent=1)
Hh = sum(t.shape[0] + 4 for t in tiles); sheet = np.zeros((Hh, tiles[0].shape[1]), np.float32); y = 0
for t in tiles: sheet[y:y + t.shape[0]] = t; y += t.shape[0] + 4
Image.fromarray((sheet * 255).astype(np.uint8)).save(B + 'previews/trim_masks.png')
