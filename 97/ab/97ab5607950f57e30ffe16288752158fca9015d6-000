@fig('timeline', 'How the three videos are cut. The two 2048 px cuts share the same hook; the third one is 4096 px and walks through the seven steps.',
     'Timeline diagram of the three videos with their segments, title, sound effect and music.', section='videos')
def timeline():
    S = 2; W, Hh = 2560 * S, 1290 * S; im = Image.new('RGB', (W, Hh), (246, 246, 248)); d = ImageDraw.Draw(im)
    fl, fs, ft_ = ft(38 * S, 'sans', 500), ft(28 * S), ft(26 * S)
    dark = (24, 24, 28); grey = (110, 110, 118); line = (214, 214, 220)
    L, Rm, T = 80, 2500, 62.0; X = lambda t: (L + (Rm - L) * t / T) * S
    for t in range(0, 61, 10):
        d.line((X(t), 84 * S, X(t), 1262 * S), fill=line, width=2 * S); d.text((X(t) + 8 * S, 40 * S), '%d s' % t, font=ft_, fill=grey)
    rows = [
        ('How did I create these shots?', '38 s, 4096 px, 30 fps', 100, [(0, 10, 'Side by side', P['coral']), (10, 38, 'Seven numbered steps, 4 s each', P['blue'])], 'Music: Feverkin (Alternate Realities Part I), 2:16 to 2:54'),
        ('Petals Height', '42.67 s, 2048 px, 24 fps', 500, [(0, 6, 'Hook', P['coral']), (6, 34.67, '84 height images, 0.33 s each', P['blue']), (34.67, 37.67, 'Petals', P['pink']), (37.67, 42.67, 'Close orbit', P['green'])], 'Music: Sonic Riots (Grandbrothers)'),
        ('Trim Sheet Height', '61.33 s, 2048 px, 24 fps', 900, [(0, 6, 'Hook', P['coral']), (6, 56.33, 'Height evolution, 160 states of the full sheet', P['blue']), (56.33, 61.33, 'Close orbit', P['green'])], 'Music: Butterfly Effect (fox capture plan) from 2:24'),
    ]
    for (name, spec, y, segs, music) in rows:
        d.text((L * S, y * S), name, font=fl, fill=dark); d.text(((L + 700) * S, (y + 6) * S), spec, font=ft_, fill=grey)
        yb = (y + 128) * S; hb = 120 * S
        d.polygon([(X(1.0), yb - 4 * S), (X(1.0) - 13 * S, yb - 26 * S), (X(1.0) + 13 * S, yb - 26 * S)], fill=dark); d.text((X(1.0) + 22 * S, yb - 48 * S), 'sound effect at 1.0 s', font=ft_, fill=dark)
        for (a, b, label, col) in segs:
            rbox(d, (X(a) + 2 * S, yb, X(b) - 2 * S, yb + hb), col, r=16 * S, w=0)
            f_ = fs if (X(b) - X(a)) > 140 * S else ft_
            if d.textlength(label, font=f_) < (X(b) - X(a)) - 26 * S: d.text((X(a) + 16 * S, yb + 40 * S), label, font=f_, fill=(255, 255, 255))
        rbox(d, (X(1.0), yb + hb + 16 * S, X(6.0), yb + hb + 46 * S), P['yellow'], r=8 * S, w=0); d.text((X(6.0) + 14 * S, yb + hb + 14 * S), 'title, 1.0 to 6.0 s', font=ft_, fill=dark)
        d.text((L * S, (y + 128 + 120 + 66) * S), music + ', normalised to -14 LUFS', font=ft_, fill=grey)
    return im.resize((2560, 1290), Image.LANCZOS)
