# ---------------------------------------------------------------- helpers
SRC = []   # every source file opened while one figure is built (provenance, written to the private index)
def rgb(path): SRC.append(path); return Image.open(path).convert('RGB')
def src(path): return R + path if not path.startswith('/') else path
def ft(size, kind='sans', weight=400):
    if kind == 'sans':
        f = ImageFont.truetype(FONTS + 'InterVariable.ttf', size); f.set_variation_by_axes([14, weight]); return f
    if kind == 'serif': return ImageFont.truetype(FONTS + 'AnthropicSerif-Light.ttf', size)
    if kind == 'mono': return ImageFont.truetype(FONTS + 'AnthropicMono-Regular.ttf', size)
    if kind == 'vogun': return ImageFont.truetype(P['vogun'], size)
def fit_w(im, w):
    if im.width <= w: return im
    return im.resize((w, round(im.height * w / im.width)), Image.LANCZOS)
def fit_box(im, w, h):
    s = min(w / im.width, h / im.height); return im.resize((max(1, round(im.width * s)), max(1, round(im.height * s))), Image.LANCZOS)
def cover_box(im, w, h):
    s = max(w / im.width, h / im.height); im = im.resize((max(1, round(im.width * s)), max(1, round(im.height * s))), Image.LANCZOS)
    x = (im.width - w) // 2; y = (im.height - h) // 2; return im.crop((x, y, x + w, y + h))
def frame(video, t, name, size=None):
    os.makedirs(FRAMES, exist_ok=True); out = FRAMES + name + '.png'
    cmd = ['ffmpeg', '-y', '-loglevel', 'error', '-ss', str(t), '-i', video, '-frames:v', '1'] + (['-vf', 'scale=%d:%d' % size] if size else []) + [out]
    subprocess.run(cmd, check=True); SRC.append(video); return Image.open(out).convert('RGB')
def window_crop(path):          # the application window only (no macOS menu bar, no Dock): 3456 x 2234 screenshots of Matthieu
    im = rgb(path); return im.crop((0, 66, im.width, 2086))
def grid(cells, cols, cw, ch=None, gap=None, bg=None, labels=None, label_size=34, pad=0):
    gap = P['gap'] if gap is None else gap; bg = bg or P['bg']; ch = ch or cw
    rows = (len(cells) + cols - 1) // cols
    W = pad * 2 + cols * cw + (cols - 1) * gap; H = pad * 2 + rows * ch + (rows - 1) * gap
    sh = Image.new('RGB', (W, H), bg); d = ImageDraw.Draw(sh); f = ft(label_size)
    for i, c in enumerate(cells):
        x = pad + (i % cols) * (cw + gap); y = pad + (i // cols) * (ch + gap)
        c = fit_box(c, cw, ch); sh.paste(c, (x + (cw - c.width) // 2, y + (ch - c.height) // 2))
        if labels and labels[i]: tag(d, f, labels[i], x + 14, y + 12)
    return sh
def tag(d, f, text, x, y, fg=(255, 255, 255), bgc=(0, 0, 0, 150)):
    w = d.textlength(text, font=f); h = f.size
    d.rounded_rectangle((x - 8, y - 4, x + w + 8, y + h + 10), radius=10, fill=(14, 14, 16))
    d.text((x, y), text, font=f, fill=fg)
def save(im, name, max_w=None, budget=None):
    im = im.convert('RGB'); mw = max_w or P['max_w']
    if im.width > mw: im = im.resize((mw, round(im.height * mw / im.width)), Image.LANCZOS)
    budget = budget or (P['budget_small'] if im.width <= P['small_w'] else P['budget_big']); path = OUT + name
    q = P['q_start']
    while True:
        im.save(path, 'WEBP', quality=q, method=6)
        if os.path.getsize(path) <= budget or q <= P['q_min']: break
        q -= 3
    return dict(file=name, width=im.width, height=im.height, bytes=os.path.getsize(path), quality=q, over_budget=os.path.getsize(path) > budget)
def title_overlay(img, lines, top, size=190, max_w=0.80, gap=1.10, shadow=0.55, blur=9):
    W = img.width; d0 = ImageDraw.Draw(img)
    while max(d0.textlength(t, font=ft(size, 'vogun')) for t in lines) > max_w * W: size -= 4
    f = ft(size, 'vogun'); sh = Image.new('L', img.size, 0); sd = ImageDraw.Draw(sh); y = top
    for t in lines: sd.text(((W - d0.textlength(t, font=f)) / 2, y), t, font=f, fill=int(255 * shadow)); y += int(size * gap)
    sh = sh.filter(ImageFilter.GaussianBlur(blur)); img.paste(Image.new('RGB', img.size, (0, 0, 0)), mask=sh)
    d = ImageDraw.Draw(img); y = top
    for t in lines: d.text(((W - d.textlength(t, font=f)) / 2, y), t, font=f, fill=P['yellow']); y += int(size * gap)
    return img
def rbox(d, box, fill, outline=None, r=26, w=3): d.rounded_rectangle(box, radius=r, fill=fill, outline=outline, width=w)
def centered(d, text, cx, cy, f, fill):
    w = d.textlength(text, font=f); d.text((cx - w / 2, cy - f.size * 0.62), text, font=f, fill=fill)
def arrow(d, x0, y0, x1, y1, color, w=8, head=26):
    d.line((x0, y0, x1 - head * 0.6, y1), fill=color, width=w); d.polygon([(x1, y1), (x1 - head, y1 - head * 0.62), (x1 - head, y1 + head * 0.62)], fill=color)


