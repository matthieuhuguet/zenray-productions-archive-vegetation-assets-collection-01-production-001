# ================================================================ driver
# Reading order of the numbered figures (6 October 2026). It is the ONLY place that sets the numbers: Article.py checks that the text uses them in this order.
ORDER = ['pipeline', 'step1-hda-in-houdini', 'hda-versions', 'uv-check', 'step2-copernicus', 'seven-bands', 'sheet-growth', 'petal-moments', 'vault-tests', 'petal-band-4096',
         'step3-karma', 'three-petals', 'ao-before-after', 'six-maps', 'lookdev-iterations', 'step4-unreal-import', 'first-lumen',
         'step5-studio', 'orbit-storyboard', 'orbit-five-frames', 'first-lighting', 'step6-render-queue', 'close-orbit-frames',
         'step7-scattering', 'five-variations', 'colourways', 'first-bed', 'bed-lighting', 'bed-frames', 'timeline', 'title-reveal', 'covers', 'last-frame']

def plan():
    fig_no = 0; out = []
    assert sorted(r['slug'] for r in REG if r['kind'] == 'figure') == sorted(ORDER), 'ORDER and the registered figures differ'
    reg = [r for r in REG if r['kind'] != 'figure'] + sorted([r for r in REG if r['kind'] == 'figure'], key=lambda r: ORDER.index(r['slug']))
    for r in reg:
        r = dict(r)
        if r['kind'] == 'figure': fig_no += 1; r['number'] = fig_no; r['file'] = '%02d-%s.webp' % (fig_no, r['slug'])
        else: r['number'] = None; r['file'] = '%s.webp' % r['slug'] if r['kind'] != 'card' else 'thumb.webp'
        out.append(r)
    return out

def main():
    args = sys.argv[1:]; items = plan()
    if '--list' in args:
        for r in items: print('%-8s %-34s %s' % (r['number'] or '-', r['file'], r['caption'][:80]))
        return
    only = None
    if '--only' in args: only = set(int(x) for x in args[args.index('--only') + 1].split(','))
    os.makedirs(OUT, exist_ok=True); os.makedirs(FRAMES, exist_ok=True); rec = {}
    old = {}
    if os.path.exists(WORK + 'images-index.json'):
        for it in json.load(open(WORK + 'images-index.json'))['images']: old[it['slug']] = it
    for r in items:
        if only is not None and (r['number'] is None or r['number'] not in only): 
            if r['slug'] in old: rec[r['slug']] = old[r['slug']]
            continue
        SRC.clear(); im = r['fn']()
        mw = 1600 if r['kind'] == 'poster' else None
        info = save(im, r['file'], max_w=mw)
        info.update(dict(slug=r['slug'], number=r['number'], kind=r['kind'], section=r['section'], caption=r['caption'], alt=r['alt'],
                         sources=sorted({s[len(R):] if s.startswith(R) else s for s in SRC})))
        data = open(OUT + r['file'], 'rb').read(); info['sha256'] = hashlib.sha256(data).hexdigest()
        rec[r['slug']] = info; print('%-6s %-36s %5dx%-5d %7.0f KB q%d%s' % (r['number'] or '-', r['file'], info['width'], info['height'], info['bytes'] / 1024, info['quality'], '  OVER BUDGET' if info['over_budget'] else ''))
    images = [rec[r['slug']] for r in items if r['slug'] in rec]
    # remove stale files: anything in OUT that is not a current image
    keep = {i['file'] for i in images}
    for f in glob.glob(OUT + '*.webp'):
        if os.path.basename(f) not in keep: os.remove(f); print('removed stale', os.path.basename(f))
    total = sum(i['bytes'] for i in images)
    index = dict(schema='article.images.index.v1', article=SLUG, built='6 October 2026', budget=dict(max_width=P['max_w'], big=P['budget_big'], small=P['budget_small'], total=P['total_budget']),
                 totals=dict(files=len(images), bytes=total), images=images)
    json.dump(index, open(WORK + 'images-index.json', 'w'), indent=1, ensure_ascii=False)
    pub = dict(index); pub['images'] = [{k: v for k, v in i.items() if k not in ('sha256', 'sources')} for i in images]
    json.dump(pub, open(OUT + 'images-index.json', 'w'), indent=1, ensure_ascii=False)
    md = ['# Images of the Fleur de Lys article (6 October 2026)', '',
          'Built by `Scripts/ArticleLily/Figures.py`. %d files, %.1f MB, every width at most %d px. Public copy without sources: `public/projects/%s/images-index.json`. (6 October 2026)' % (len(images), total / 1e6, P['max_w'], SLUG), '',
          '| No | File | Size px | KB | Caption | Sources (6 October 2026) |', '|---|---|---|---|---|---|']
    for i in images:
        md.append('| %s | `%s` | %d x %d | %.0f | %s | %s |' % (i['number'] or i['kind'], i['file'], i['width'], i['height'], i['bytes'] / 1024, i['caption'].replace('|', '/'), '<br>'.join('`%s`' % s for s in i.get('sources', []))))
    open(WORK + 'ImagesIndex.md', 'w').write('\n'.join(md) + '\n')
    print('TOTAL %d files, %.1f MB (budget %.0f MB)' % (len(images), total / 1e6, P['total_budget'] / 1e6))

if __name__ == '__main__':
    main()
