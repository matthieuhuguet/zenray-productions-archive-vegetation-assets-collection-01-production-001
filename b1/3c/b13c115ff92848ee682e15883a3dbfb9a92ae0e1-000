# 6 October 2026 : blue and WHITE lily variant of the trim sheet BASE COLOUR. Only the pink/magenta hues (290 to 360 degrees and 0 to 12) are moved to blue (about 220 degrees), leaves, stems and stamens keep their colour, saturation and value are untouched so the pattern is exactly the same. Usage: python3 MakeBlueBaseColour.py <in.png> <out.png> [blue|white] (white = the pink hues lose 94 percent of their saturation, a slight warm cream, value kept). FR : variante bleue de la base color, seules les teintes roses changent.
import sys, numpy as np
from PIL import Image
MODE = sys.argv[3] if len(sys.argv) > 3 else 'blue'
im = Image.open(sys.argv[1]).convert('RGB'); a = np.asarray(im, np.float32) / 255
r, g, b = a[..., 0], a[..., 1], a[..., 2]; mx = a.max(-1); mn = a.min(-1); d = mx - mn + 1e-9
h = np.where(mx == r, ((g - b) / d) % 6, np.where(mx == g, (b - r) / d + 2, (r - g) / d + 4)) * 60; s = d / (mx + 1e-9)
hs = np.where(h > 180, h - 360, h)                                  # -70 .. 12 for pinks
mask = ((hs >= -70) & (hs <= 12) & (s > 0.04)).astype(np.float32)
w = np.clip((hs + 70) / 82.0, 0, 1)                                 # 0 = magenta side, 1 = red side
new_h = 232.0 - 22.0 * w                                           # magenta to royal blue, reds to a lighter blue
h2 = np.where(mask > 0, new_h if MODE == 'blue' else 48.0, h)
if MODE == 'white': s = np.where(mask > 0, s * 0.06, s)
c = mx * s; x = c * (1 - np.abs((h2 / 60) % 2 - 1)); m = mx - c
k = (h2 // 60).astype(int) % 6; z = np.zeros_like(c)
R = np.choose(k, [c, x, z, z, x, c]); G = np.choose(k, [x, c, c, x, z, z]); B = np.choose(k, [z, z, x, c, c, x])
o = np.stack([R + m, G + m, B + m], -1); out = a * (1 - mask[..., None]) + o * mask[..., None]
Image.fromarray((np.clip(out, 0, 1) * 255 + 0.5).astype(np.uint8)).save(sys.argv[2]); print('blue pixels share', float(mask.mean()))
