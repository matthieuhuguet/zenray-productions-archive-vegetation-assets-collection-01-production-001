import os, textwrap
from PIL import Image, ImageDraw, ImageFont
R = '/Users/zenray/.claude/tmp/tmp-vegetation-assets-collection-01/refs/'
os.makedirs(R + 'materials', exist_ok=True)
FONT = '/Users/zenray/Library/Fonts/InterVariable.ttf'
def font(px):
    f = ImageFont.truetype(FONT, px)
    try: f.set_variation_by_name('Regular')
    except Exception: pass
    return f
F60, F34, F26 = font(60), font(34), font(26)
W, M, GAP, CW, CH = 3600, 60, 40, 1100, 800
BG, FG, DIM, ACC, LINE = (24, 24, 24), (240, 240, 240), (170, 170, 170), (255, 214, 120), (70, 70, 70)
def wrap(d, text, f, width):
    words, lines, cur = text.split(), [], ''
    for w in words:
        t = (cur + ' ' + w).strip()
        if d.textlength(t, font=f) <= width: cur = t
        else: lines.append(cur); cur = w
    return lines + [cur]

