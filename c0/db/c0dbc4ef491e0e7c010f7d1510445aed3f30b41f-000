# 5 October 2026 : components of the Eucalyptus: trunk, main branches, hanging twigs, leaf cards. One deterministic generator (tree_data) feeds every component so that twigs and cards always agree. Appended after the generic helpers of LilyLib.py. FR : composants de l'eucalyptus.
BARK = (0.62, 0.58, 0.5); TWIG = (0.4, 0.35, 0.25); LEAF = (0.35, 0.5, 0.32)
def tree_data():
    rnd = random.Random(int(PRM('seed'))); H = PRM('trunk_height'); lean = PRM('trunk_lean'); R0 = PRM('trunk_radius'); out = {'trunk': None, 'branches': [], 'twigs': []}
    tp = bez(V3(0, 0, 0), V3(0, H * 0.35, 0), V3(lean * 0.6, H * 0.7, lean * 0.1), V3(lean, H, lean * 0.25), 22)
    out['trunk'] = (tp, [R0 * (1.0 + 0.55 * math.exp(-i * 0.8)) * (1.0 - 0.62 * i / 21.0) for i in range(22)])
    def grow(P, d, L, r0, level, K):
        pts = [P]; radii = [r0]; cur = P; dd = d
        for k in range(1, K):
            f = k / float(K - 1)
            if level == 0: dd = (dd + V3(0, 0.10 * (0.5 - f), 0) + V3(rnd.uniform(-1, 1), rnd.uniform(-1, 1), rnd.uniform(-1, 1)) * 0.10).normalized()
            else: dd = (dd + V3(0, -PRM('twig_droop') * 0.22 * f, 0) + V3(rnd.uniform(-1, 1), rnd.uniform(-1, 1), rnd.uniform(-1, 1)) * 0.14).normalized()
            cur = cur + dd * (L / (K - 1)); pts.append(cur); radii.append(max(0.003, r0 * (1.0 - 0.7 * f)))
        return pts, radii, dd
    nb = int(PRM('branch_count')); crown = PRM('crown_radius')
    for i in range(nb):
        f = 0.5 + 0.5 * i / float(max(1, nb - 1)); idx = min(20, int(f * 21)); P = tp[idx]; az = rnd.uniform(0, 2 * math.pi) + i * 2.4; out_d = V3(math.cos(az), 0, math.sin(az))
        d = (out_d * rnd.uniform(0.5, 0.9) + V3(0, rnd.uniform(0.5, 1.0), 0)).normalized(); L = crown * rnd.uniform(0.7, 1.1) * (1.15 - 0.5 * f)
        pts, radii, dd = grow(P, d, L, out['trunk'][1][idx] * 0.42, 0, 12); out['branches'].append((pts, radii, 0))
        for j in range(int(PRM('sub_branches'))):
            q = rnd.uniform(0.35, 1.0); k = min(10, int(q * 11)); P2 = pts[k]; tang = (pts[k + 1] - pts[k]).normalized(); az2 = rnd.uniform(0, 2 * math.pi); e1, e2 = frame_perp(tang)
            d2 = (tang * 0.7 + (e1 * math.cos(az2) + e2 * math.sin(az2)) * 0.6 + V3(0, 0.1, 0)).normalized(); p2, r2, dd2 = grow(P2, d2, L * 0.6, radii[k] * 0.55, 1, 9); out['branches'].append((p2, r2, 1))
            for t in range(int(PRM('twigs_per_branch'))):
                q2 = rnd.uniform(0.3, 1.0); k2 = min(7, int(q2 * 8)); P3 = p2[k2]; tg = (p2[k2 + 1] - p2[k2]).normalized(); az3 = rnd.uniform(0, 2 * math.pi); a1, a2 = frame_perp(tg)
                d3 = (tg * 0.5 + (a1 * math.cos(az3) + a2 * math.sin(az3)) * 0.5 + V3(0, -0.6, 0)).normalized(); p3, r3, dd3 = grow(P3, d3, L * 0.45, r2[k2] * 0.5, 2, 7); out['twigs'].append((p3, r3, 2))
    return out
def trunk(geo):
    pts, radii = tree_data()['trunk']; tube(geo, pts, radii, 14, 'bark', 'trunk', BARK)
def branches(geo):
    for i, (pts, radii, lv) in enumerate(tree_data()['branches']): tube(geo, pts, radii, 8 if lv == 0 else 6, 'bark', 'branch%d' % i, BARK)
def twigs(geo):
    for i, (pts, radii, lv) in enumerate(tree_data()['twigs']): tube(geo, pts, radii, 4, 'twig', 'twig%d' % i, TWIG)
def leaf_cards(geo):
    rnd = random.Random(int(PRM('seed')) + 9); S = PRM('card_size')
    for i, (pts, radii, lv) in enumerate(tree_data()['twigs']):
        for k in (3, 5, 6):
            P = pts[k]; tg = (pts[min(k + 1, len(pts) - 1)] - pts[k - 1]).normalized(); side = tg.cross(V3(0, 1, 0)); side = side.normalized() if side.length() > 1e-6 else V3(1, 0, 0)
            side = rot(side, tg, rnd.uniform(0, math.pi)); nrm = side.cross(tg).normalized(); w = S * rnd.uniform(0.7, 1.0) * 0.5; hang = V3(0, -1, 0) * (S * 0.15)
            rows = [[(P + tg * (S * 0.5 * q) + side * (w * t) + hang * (q * q), ((t + 1) * 0.5, q)) for t in (-1.0, 0.0, 1.0)] for q in (0.0, 0.5, 1.0)]
            grid(geo, rows, 'leaf', 'card%d_%d' % (i, k), LEAF)
