for i, n in enumerate(('HowDoICreateThoseShots', 'PetalsHeight', 'TrimSheetHeight')): s.paste(Image.open(OUT + 'Thumbnail_%s_9x16.png' % n).resize((540, 960), Image.LANCZOS), (i * 540, 0))
