def lines_layer(net, tag, base, coord, count, soft, wob, depth, power, mask, lv):
    """thin DARK lines on a pale surface: abs(sin(coord * count)) ^ power (a small power gives a narrow dip), relief from -depth to 0 so a line only darkens, masked, added. 10 nodes."""
    k = T.mix(net, '%s_phase' % tag, coord, T.const(net, '%s_count' % tag, lv, count), 5)
    w = T.mix(net, '%s_wobble' % tag, soft, T.const(net, '%s_wobble_amount' % tag, lv, wob), 5)
    sn = T.node(net, 'function', '%s_sin' % tag, [T.mix(net, '%s_phase_wobbled' % tag, k, w, 3)], func=2, func_trig=0, angleunit=2)
    ab = T.node(net, 'function', '%s_abs' % tag, [sn], func=0, func_math=0); pw = T.node(net, 'function', '%s_pow' % tag, [ab], func=1, func_pow=1)
    if pw.parm('exponent'): pw.parm('exponent').set(power)
    rel = T.lin(net, '%s_relief' % tag, pw, 0.0, 1.0, -depth, 0.0)
    return T.mix(net, '%s_added' % tag, base, T.mix(net, '%s_masked' % tag, rel, mask, 5), 3)
def modulation(net, tag, ref, size, sx, sy, seed, lo):
    """a slow noise that makes the lines unequal (some strong, some faint): remapped to lo..1, used to multiply a mask. 2 nodes."""
    nz = T.node(net, 'fractalnoise', '%s_noise' % tag, [ref], amp=0.5, center=0.5, elementsize=size, offx=seed); nz.parm('elementscalex').set(sx); nz.parm('elementscaley').set(sy)
    return T.lin(net, '%s_range' % tag, nz, 0.15, 0.85, lo, 1.0)
