    wing = T.mix(net, 'H04_wing__region', T.mix(net, 'H04a_wing__big_minus_tongue', mb, mt, 4), zone, 5)
    tmask = T.mix(net, 'H05_tongue__fibre_region', mb, wing, 4)
    tm = T.mix(net, 'H07_tongue__modulated_mask', tmask, modulation(net, 'H06_tongue__modulation', lv, 0.12, 0.25, 3.0, 11.3, 0.25), 5)
    wm = T.mix(net, 'H09_wing__modulated_mask', T.mix(net, 'H09a_wing__fade_at_fan_origin', wing, T.lin(net, 'H09b_fade', T.smooth(net, 'H09c_fade_s', lv, 0.86, 0.95), 0.0, 1.0, 1.0, 0.0), 5), modulation(net, 'H08_wing__modulation', lv, 0.10, 3.0, 0.4, 5.7, 0.25), 5)
    h = lines_layer(net, 'H11_tongue_fibre_main', h, tt, 91, soft, 0.15, 0.10, 0.30, tm, lv)
    h = lines_layer(net, 'H13_tongue_fibre_bold', h, tt, 36, soft, 0.30, 0.09, 0.28, tm, lv)
    # wing fibres: rays from the point P = (|cx| 0.144, y 0.178 = lv 0.92), the lower OUTER corner of the wing (least squares fit of the measured line orientations, median residual 0.012); coordinate = angle of the ray (arc tangent of the slope), in turns
    dxn = T.mix(net, 'H23_wing__dx_floor', T.mix(net, 'H23a_wing__px_minus_ax', T.const(net, 'H23b_const__px', lv, WING_PX), ax, 4), T.const(net, 'H23c_const__floor', lv, 0.004), 12)
    dyn = T.lin(net, 'H24_wing__dy', lv, 0.0, 1.0, WING_PY, WING_PY - BAND_V1)
    phi = T.node(net, 'function', 'H25_wing__ray_angle', [T.mix(net, 'H25a_wing__slope', dyn, dxn, 6)], func=2, func_trig=5, angleunit=2)
    h = lines_layer(net, 'H21_wing_fibre_main', h, phi, 28, soft, 0.20, 0.10, 0.30, wm, lv)
    c.update(tt=tt, phi=phi, tm=tm, wm=wm, soft=soft, wing=wing, tmask=tmask)
    h = pads(net, 'H', h, n0); close(net, b, 'H', n0); return h
def dots_layer(net, tag, base, ref, mask, size, seed, thr, amp):
    """sparse dots (water droplets): a fractal noise thresholded by a curve, scaled by amp (negative = dark dots), masked, added: 4 nodes."""
    nz = T.node(net, 'fractalnoise', '%s_noise' % tag, [ref], amp=0.5, center=0.5, elementsize=size, offx=seed)
    d = T.curve(net, '%s_threshold' % tag, nz, [(0.0, 0.0), (thr, 0.0), (thr + 0.12, 1.0), (1.0, 1.0)], 1.0, min(0.0, amp), max(0.0, amp))
    return T.mix(net, '%s_added' % tag, base, T.mix(net, '%s_masked' % tag, d, mask, 5), 3)
def grain(net, tag, base, ref, mask, size, seed, amp, sx=1.0, sy=1.0):
    nz = T.node(net, 'fractalnoise', '%s_noise' % tag, [ref], amp=amp, center=0.0, elementsize=size, offx=seed); nz.parm('elementscalex').set(sx); nz.parm('elementscaley').set(sy)
    return T.mix(net, '%s_added' % tag, base, T.mix(net, '%s_masked' % tag, nz, mask, 5), 3)
def iteration3(net, h, c):
    """ITERATION 3 (64 nodes): the fine detail. After iterations 1 and 2 the band matches the reference in structure (cell error 0.054) but its detail energy is 0.013 against 0.041: three times too smooth. So: fine fibre lines on the tongue and on the wings (same coordinates as the main ones), water droplets on the tongue, the neck and the wings, two grains, a streak noise along the tongue fibres and a very soft low frequency fold shading."""
    lv, mb, mt, tt, phi, tm, wm, soft = c['lv'], c['mb'], c['mt'], c['tt'], c['phi'], c['tm'], c['wm'], c['soft']
    n0 = len(net.children()); b = box(net, 'J', 'BAND 0 V2 ITERATION 3 : 64 nodes, fine detail', (1.0, 0.9, 0.7))
    h = lines_layer(net, 'J11_tongue_fibre_fine', h, tt, 180, soft, 0.20, 0.030, 0.50, tm, lv)
    h = lines_layer(net, 'J21_wing_fibre_fine', h, phi, 90, soft, 0.20, 0.030, 0.50, wm, lv)
