    shm = T.mix(net, 'K03_shoulder__modulated', sh, modulation(net, 'K01_shoulder__modulation', lv, 0.10, 0.5, 2.0, 15.3, 0.2), 5)
    h = lines_layer(net, 'K11_shoulder_lines', h, phi, 24, soft2, 0.25, 0.08, 0.30, shm, lv)
    tm2 = T.mix(net, 'K05_tongue__modulated_b', tm, modulation(net, 'K04_tongue__modulation_b', lv, 0.07, 0.2, 4.0, 31.7, 0.0), 5)
