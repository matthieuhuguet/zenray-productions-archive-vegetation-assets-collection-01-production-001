def box(net, tag, comment, color):
    b = net.createNetworkBox('Iteration_' + tag); b.setComment(comment); b.setColor(hou.Color(color)); return b
def close(net, b, tag, n0):
    assert len(net.children()) - n0 <= 150, 'iteration %s holds %d nodes' % (tag, len(net.children()) - n0)
    for n in net.children():
        if n.name().startswith(tag): b.addNode(n)
    b.fitAroundContents()
def profile(net, tag, dist, keys, lo, hi, vmin, vmax):
    """signed distance profile: remap the distance to 0..1 over [lo, hi] then a SMOOTH curve whose values run vmin..vmax (2 nodes)."""
    d = T.lin(net, '%s_scaled' % tag, dist, lo, hi)
    return T.curve(net, '%s_profile' % tag, d, [((x - lo) / (hi - lo), (y - vmin) / (vmax - vmin)) for x, y in keys], 1.0, vmin, vmax, T.SMOOTH)
