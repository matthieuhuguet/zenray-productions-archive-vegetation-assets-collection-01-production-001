    h = dots_layer(net, 'J32_droplets_wings', h, lv, wm, 0.0035, 7.7, 0.62, 0.04)
    h = grain(net, 'J41_grain_fine', h, lv, mb, 0.0022, 5.3, 0.020)
    h = grain(net, 'J42_grain_mid', h, lv, mb, 0.0060, 9.1, 0.020)
    h = grain(net, 'J43_streaks_tongue', h, lv, tm, 0.02, 4.4, 0.030, 0.10, 3.0)
