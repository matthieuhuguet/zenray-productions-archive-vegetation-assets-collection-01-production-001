def small_petal(net, ground, c):
    """THE BACK PETAL (Matthieu, 5 October 2026: perfectly straight, the pattern of the big petal but narrower, symmetric). The same measured neck pattern as the big petal, evaluated on the distance to the CELL BOUNDARY: silhouette = KS x the big silhouette, neck tone, the lane near the edge (QN scaled by 1/KS), the central rib, vertical fibre lines, rim with a ground halo. It lives behind the big petal; the wings hide its lower part. Returns the ground with the back petal painted on it."""
    lv, ax, wb, mb, mtop, zero = c['lv'], c['ax'], c['wb'], c['mb'], c['mtop'], c['zero']
    n0 = len(net.children()); b = box(net, 'I', 'BAND 0 V2 : the back petal, 64 nodes', (1.0, 0.85, 0.85))
    dsb = T.mix(net, 'I01_cell__distance_to_boundary', T.const(net, 'I00_const__half_cell', lv, 1.0 / 6), ax, 4)
    ws = T.mix(net, 'I02_back__halfwidth', T.lin(net, 'I02a_back__halfwidth_scaled', wb, 0.0, 1.0, 0.0, KS), T.curve(net, 'I02b_back__taper', lv, [(0.0, 1.0), (0.45, 1.0), (0.75, 0.55), (1.0, 0.12)], 1.0, 0.0, 1.0, T.SMOOTH), 5)   # the back petal narrows to the V at the bottom, as the sliver between the wings does in the reference
    d_in = T.mix(net, 'I03_back__distance_inside', ws, dsb, 4)
    ms = T.mix(net, 'I05_back__mask', T.mix(net, 'I05a_back__edge_top', T.smooth(net, 'I04_back__edge', d_in, -EDGE, EDGE), mtop, 5), T.const(net, 'I05b_const__one', lv, 1.0), 5)   # the sliver between the wings goes to the ground colour at the bottom, like the V of the reference
    vn = T.curve(net, 'I06_back__tone_vertical', lv, VW, 1.0)
    dsn = T.lin(net, 'I07_back__scaled_distance', dsb, 0.0, 1.0, 0.0, 1.0 / KS)
    qn = T.curve(net, 'I08_back__neck_cross', dsn, [(x, (y + 0.2) / 0.4) for x, y in QN], 0.17, -0.2, 0.2, T.SMOOTH)
    fade = T.lin(net, 'I09_back__neck_zone', T.smooth(net, 'I09a_back__neck_fade', lv, 0.34, 0.52), 0.0, 1.0, 1.0, 0.0)
    tone = T.mix(net, 'I11_back__tone', vn, T.mix(net, 'I10b_back__neck_cross_halved', T.mix(net, 'I10_back__neck_cross_faded', qn, fade, 5), T.const(net, 'I10a_const__half', lv, 0.5), 5), 3)
    under = T.mix(net, 'I14_back__over_ground', ground, T.mix(net, 'I13_back__delta_masked', T.mix(net, 'I12_back__delta', tone, ground, 4), ms, 5), 3)
    # silhouette rim (ground halo outside, white line inside) and the central rib, same profiles as the big petal
    notbig = T.lin(net, 'I20_back__not_under_big', mb, 0.0, 1.0, 1.0, 0.0)
    rim = profile(net, 'I21_back_rim', d_in, [(-0.02, 0.0), (-0.008, -0.05), (-0.002, -0.12), (0.0, -0.02), (0.0008, 0.30), (0.004, 0.05), (0.010, 0.0), (0.05, 0.0)], -0.02, 0.05, -0.15, 0.35)
    under = T.mix(net, 'I23_back__rim_added', under, T.mix(net, 'I22_back__rim_masked', rim, notbig, 5), 3)
    rib = profile(net, 'I24_back_rib', dsb, [(0.0, 0.0), (0.0015, -0.015), (0.0035, 0.035), (0.006, 0.01), (0.010, -0.04), (0.015, -0.015), (0.03, 0.0)], 0.0, 0.03, -0.15, 0.15)
    under = T.mix(net, 'I26_back__rib_added', under, T.mix(net, 'I25_back__rib_masked', rib, ms, 5), 3)
    soft = T.node(net, 'fractalnoise', 'I30_back__soft_phase_noise', [lv], amp=0.5, center=0.0, elementsize=0.16)
    mod = T.mix(net, 'I32_back__fibre_mask', ms, modulation(net, 'I31_back__modulation', lv, 0.12, 0.25, 3.0, 23.9, 0.25), 5)
    under = lines_layer(net, 'I33_back_fibre_main', under, dsb, 91, soft, 0.15, 0.070, 0.35, mod, lv)
