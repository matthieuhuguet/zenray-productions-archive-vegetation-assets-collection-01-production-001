def build(net):
    rx = T.node(net, 'ramp', 'A00_ramp__cycles_x', signature='f1', cycles=float(CELLS), method=1); ry = T.node(net, 'ramp', 'A01_ramp__down_y', signature='f1', rotation=90.0)
    lv = T.lin(net, 'A03_band__lv_0_top_1_bottom', ry, V0, V1); one = T.const(net, 'A04_one', lv, 1.0); s = rx
    top = T.curve(net, 'B01_top_edge', s, TOP, 1.0, 0.0, 1.0, T.SMOOTH); bot = T.curve(net, 'B02_bottom_edge', s, BOT, 1.0, 0.0, 1.0, T.SMOOTH)
    d_top = T.mix(net, 'B03_inside_top', lv, top, 4); d_bot = T.mix(net, 'B04_inside_bottom', bot, lv, 4)
    d_in = T.mix(net, 'B05_distance_inside', d_top, d_bot, 13)               # min of the two: >0 inside the bud, in lv units (band 0.163 of the canvas)
    mask = T.smooth(net, 'B06_mask', d_in, -EDGE / HC, EDGE / HC)
    span = T.mix(net, 'B07_span', bot, top, 4); q = T.node(net, 'clamp', 'B09_q', [T.mix(net, 'B08_q_raw', d_top, T.mix(net, 'B08a_floor', span, T.const(net, 'B08b', lv, 0.05), 12), 6)])
    across = T.curve(net, 'C01_tone_across', q, QT, 1.0, 0.0, 1.0, T.SMOOTH); along = T.curve(net, 'C02_tone_along', s, [(x, (y - 0.5) / 0.5 + 0.5) for x, y in ES], 1.0, 0.0, 1.0, T.SMOOTH)
    tone = T.mix(net, 'C03_tone', across, T.lin(net, 'C03a_along_delta', along, 0.0, 1.0, -0.36, 0.20), 3)
    ground = T.const(net, 'C04_ground', lv, 0.41)
    h = T.mix(net, 'C05_over_ground', ground, T.mix(net, 'C05a_delta_masked', T.mix(net, 'C05b_delta', tone, ground, 4), mask, 5), 3)
    c = dict(lv=lv, s=s, one=one, mask=mask, q=q, d_in=d_in, d_top=d_top, d_bot=d_bot)
    if UPTO >= 1: h = iteration1(net, h, c)
    if UPTO >= 2: h = iteration2(net, h, c)
