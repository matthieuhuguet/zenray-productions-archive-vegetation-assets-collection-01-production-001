    h = fibre('E13_fibres_dark', 0.0014, 12.9, 0.66, 80, 1.0, -1); h_cur[0] = h
    h = fibre('E14_scuffs', 0.0010, 17.5, 0.74, 22, 1.4, 1)
    edge = V.profile(net, 'E21_edge_dark', T.lin(net, 'E21a_d', d_in, 0.0, 1.0, 0.0, HC), [(-0.02, 0.0), (0.0, 0.0), (0.004, -0.05), (0.016, -0.03), (0.04, 0.0), (0.08, 0.0)], -0.02, 0.08, -0.1, 0.05)
    h = T.mix(net, 'E23_edge__added', h, T.mix(net, 'E22_edge__masked', edge, mask, 5), 3)
    h = V.pads(net, 'E', h, n0); V.close(net, b, 'E', n0); return h
def opacity(net, ry, rx):
    """bud mask alone for the opacity map. FR : masque d'opacite du bouton."""
    lv = T.lin(net, 'OP6_lv', ry, V0, V1); s = T.node(net, 'ramp', 'OP6_rx', signature='f1', cycles=float(CELLS), method=1)
