def iteration1(net, h, c):
    """ITERATION 1 (64 nodes): outline and fibres. Double outline (bright rim, dark groove, second thin rim) at the two edges, dark creases between the lobes, fibres running along the bud that follow the outline (coordinate q), speckles, fine grain, contact shadow on the ground."""
    lv, s, one, mask, q, d_in = c['lv'], c['s'], c['one'], c['mask'], c['q'], c['d_in']
    n0 = len(net.children()); b = V.box(net, 'D', 'BAND 6 V2 ITERATION 1 : 64 nodes', (0.8, 1.0, 0.8))
    soft = T.node(net, 'fractalnoise', 'D00_soft_phase_noise', [lv], amp=0.5, center=0.0, elementsize=0.16)
    din = T.lin(net, 'D01_dist_lv_to_canvas', d_in, 0.0, 1.0, 0.0, HC)
    rim = V.profile(net, 'D02_rim', din, [(-0.03, 0.0), (-0.012, -0.08), (-0.004, -0.14), (0.0, 0.0), (0.0008, 0.24), (0.003, 0.05), (0.006, -0.10), (0.009, 0.12), (0.014, 0.0), (0.04, 0.0)], -0.03, 0.04, -0.2, 0.3)
    h = T.mix(net, 'D03_rim__added', h, rim, 3)
    fm = T.mix(net, 'D04_fibre_mask', mask, V.modulation(net, 'D04a_modulation', lv, 0.08, 3.0, 0.5, 5.7, 0.25), 5)
    h = V.lines_layer(net, 'D11_fibres_main', h, q, 60, soft, 0.12, 0.09, 0.30, fm, lv)
    h = V.lines_layer(net, 'D12_fibres_fine', h, q, 190, soft, 0.12, 0.045, 0.45, fm, lv)
    h = V.lines_layer(net, 'D13_fibres_bright', h, q, 120, soft, 0.12, -0.035, 0.40, fm, lv)
    for tag, qc in (('D21_crease_a', 0.30), ('D22_crease_b', 0.48), ('D23_crease_c', 0.68)):
        d = T.lin(net, tag + '_dist', q, qc - 0.05, qc + 0.05)
        ln = T.curve(net, tag + '_profile', d, [(0.0, 0.0), (0.38, 0.0), (0.5, 1.0), (0.62, 0.0), (1.0, 0.0)], 1.0, 0.0, -0.13, T.SMOOTH)
        h = T.mix(net, tag + '_added', h, T.mix(net, tag + '_masked', ln, mask, 5), 3)
    h = V.dots_layer(net, 'D31_speckles', h, lv, mask, 0.0022, 6.6, 0.62, 0.10)
    sh = V.profile(net, 'D41_contact', din, [(-0.05, 0.0), (-0.025, -0.05), (-0.01, -0.10), (-0.003, -0.06), (0.0, 0.0), (0.05, 0.0)], -0.05, 0.05, -0.15, 0.05)
    h = T.mix(net, 'D43_contact__added', h, T.mix(net, 'D42_contact__outside', sh, T.lin(net, 'D42a', mask, 0.0, 1.0, 1.0, 0.0), 5), 3)
    h = V.pads(net, 'D', h, n0); V.close(net, b, 'D', n0); return h
def iteration2(net, h, c):
    """ITERATION 2 (64 nodes): the fibrous skin. Matthieu: the bud must be perfect and seamless. The reference skin is made of fine fibres running along the bud, short and broken, plus pale veins in the lobes and small scuffs. Here: sparse seeds smeared along the bud axis with STREAK BLUR (a horizontal direction, tiled noise, wrapped border, so seamless), at three lengths, bright and dark, only inside the bud; a darker band along the two edges; a soft sheen where the lobe is highest."""
    lv, s, one, mask, q, d_in = c['lv'], c['s'], c['one'], c['mask'], c['q'], c['d_in']
    n0 = len(net.children()); b = V.box(net, 'E', 'BAND 6 V2 ITERATION 2 : 64 nodes, fibrous skin', (0.9, 0.85, 1.0))
    hx = T.node(net, 'rgbatouv', 'E00_direction', [T.node(net, 'channeljoin', 'E00a_vector', [one, T.const(net, 'E00b_zero', lv, 0.0), T.const(net, 'E00c_zero', lv, 0.0)])])
    def fibre(tag, size, seed, thr, length, gain, sign):
        nz = T.node(net, 'fractalnoise', tag + '_noise', [lv], amp=0.5, center=0.5, elementsize=size, noisetype=1, offx=seed)
        sd = T.curve(net, tag + '_cut', nz, [(0.0, 0.0), (thr, 0.0), (thr + 0.06, 1.0), (1.0, 1.0)], 1.0, 0.0, 1.0)
        st = T.node(net, 'streakblur', tag + '_streak', [sd, hx], dirtype=1, normalizedir=1, units=1, length_pixels=length, border=4)
        return T.mix(net, tag + '_added', h_cur[0], T.mix(net, tag + '_masked', T.lin(net, tag + '_gain', st, 0.0, 1.0, 0.0, gain), mask, 5), 3 if sign > 0 else 4)
    h_cur = [h]
    h = fibre('E11_fibres_long', 0.0016, 3.7, 0.70, 120, 1.7, 1); h_cur[0] = h
