# 5 October 2026 : measures the AI generated trim sheet height (03_gen_trimsheet-height_v1.png): band boundaries from the row profile, horizontal seam error of every band (left column against right column, and the half width wrap test), and the content of every band. Output ref-maps/trim_measure.json. FR : mesure de la height de la trim sheet.
import numpy as np, json
from PIL import Image
B = '/Users/zenray/Create/Build/Productions/ZenRayHoudini/VegetationCollection01/'
im = np.asarray(Image.open('/Users/zenray/.claude/tmp/tmp-vegetation-assets-collection-01/refs/flower-sheets/03_gen_trimsheet-height_v1.png').convert('L'), np.float32) / 255.0
H, W = im.shape
row = im.mean(1); g = np.abs(np.diff(row)); rowstd = im.std(1)
# separators are thin dark horizontal lines: rows much darker than both neighbours at +-6 px
dark = [y for y in range(8, H - 8) if row[y] < row[y - 6] - 0.035 and row[y] < row[y + 6] - 0.035 and row[y] <= row[y - 1] and row[y] <= row[y + 1]]
# merge neighbours
bounds = []
for y in dark:
    if not bounds or y - bounds[-1][-1] > 6: bounds.append([y])
    else: bounds[-1].append(y)
bounds = [int(np.mean(b)) for b in bounds]
print('size', W, H, 'separator rows', bounds, 'fractions', [round(b / H, 3) for b in bounds])
edges = [0] + bounds + [H]; res = []
for a, b in zip(edges[:-1], edges[1:]):
    band = im[a + 3:b - 3]
    if band.shape[0] < 20: continue
    seam = float(np.abs(band[:, 0] - band[:, -1]).mean()); inner = float(np.abs(band[:, 1:] - band[:, :-1]).mean())
    res.append(dict(y0=a, y1=b, v0=round(a / H, 4), v1=round(b / H, 4), mean=round(float(band.mean()), 3), std=round(float(band.std()), 3), seam_err=round(seam, 4), neighbour_err=round(inner, 4)))
    print('band y %4d-%4d  mean %.3f std %.3f  seam %.4f vs neighbour column %.4f' % (a, b, band.mean(), band.std(), seam, inner))
vtop = float(np.abs(im[0] - im[-1]).mean()); print('vertical wrap error top row vs bottom row %.4f' % vtop)
json.dump(dict(size=[W, H], separators=bounds, bands=res, vertical_wrap_error=vtop), open(B + 'ref-maps/trim_measure.json', 'w'), indent=1)
