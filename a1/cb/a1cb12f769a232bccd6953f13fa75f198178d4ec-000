import unreal, json
B = '/Users/zenray/Create/Build/Productions/ZenRayHoudini/VegetationCollection01/'
P = json.load(open(B + 'unreal/lily_params.json')); tools = unreal.AssetToolsHelpers.get_asset_tools(); eal = unreal.EditorAssetLibrary; mel = unreal.MaterialEditingLibrary
src = eal.load_asset(P['tex_dir'] + '/MI_LilyTrim'); ns = mel.get_material_instance_scalar_parameter_value(src, 'NormalStrength')
for key, tn, mn in (('pink', 'T_LilyBaseColorLive', 'MI_LilyTrimLive'), ('blue', 'T_LilyBaseColorLiveBlue', 'MI_LilyTrimLiveBlue')):
    t = unreal.AssetImportTask(); t.filename = B + P['variants']['live_textures'][key]; t.destination_path = P['tex_dir']; t.destination_name = tn; t.replace_existing = True; t.automated = True; t.save = True; tools.import_asset_tasks([t])
