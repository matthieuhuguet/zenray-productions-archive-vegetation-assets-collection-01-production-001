    ip = P['tex_dir'] + '/' + mn; mi = eal.load_asset(ip) if eal.does_asset_exist(ip) else tools.create_asset(mn, P['tex_dir'], unreal.MaterialInstanceConstant, unreal.MaterialInstanceConstantFactoryNew())
