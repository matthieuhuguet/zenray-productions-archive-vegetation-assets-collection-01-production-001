node.type().definition().updateFromNode(node)
if hou.node('/obj/Eucalyptus_replay_probe'):hou.node('/obj/Eucalyptus_replay_probe').destroy()
probe=hou.node('/obj').createNode('zenray_eucalyptus::2.0','Eucalyptus_replay_probe');proof=len(probe.displayNode().geometry().prims());assert proof==report['primitives'];probe.destroy()
hou.hipFile.save(str(BASE/'hip/VegetationCollection01.hiplc'))
result={'node':node.path(),'hda':library,'replay_primitives':proof,'report':str(WORK/'measurements/tree/fit-report.json'),'saved':hou.hipFile.path()}
