# 5 October 2026 13:35 Europe/Paris: apply only the verified tree candidate to the live scene, with a separate HDA definition.
import hou,json
from pathlib import Path
WORK=Path('/Users/zenray/.claude/tmp/tmp-vegetation-assets-collection-01')
BASE=Path('/Users/zenray/Create/Build/Productions/ZenRayHoudini/VegetationCollection01')
report=json.loads((WORK/'measurements/tree/fit-report.json').read_text())
assert not report['errors']; assert sum(x['envelope_iou'] for x in report['after'].values())>sum(x['envelope_iou'] for x in report['before'].values())
node=hou.node('/obj/Eucalyptus'); assert node is not None
if node.isLockedHDA():node.allowEditingOfContents()
hou.hipFile.save(str(BASE/'hip/VegetationCollection01.hiplc'))
folder=hou.FolderParmTemplate('hda_foliage','HDA Foliage',folder_type=hou.folderType.Simple)
for name,label,value,minimum,maximum in [('leaves_per_twig','Leaves Per Twig',16,3,32),('leaf_width_ratio','Leaf Width Ratio',.17,.06,.4),('leaf_curl','Leaf Curl',.14,0.,.4)]:
    folder.addParmTemplate((hou.IntParmTemplate if isinstance(value,int) else hou.FloatParmTemplate)(name,label,1,default_value=(value,),min=minimum,max=maximum))
ptg=node.parmTemplateGroup()
if not node.parm('leaves_per_twig'):ptg.append(folder);node.setParmTemplateGroup(ptg)
for name,value in report['parameters'].items():node.parm(name).deleteAllKeyframes();node.parm(name).set(value)
node.node('C4_leaf_cards').parm('python').set((WORK/'measurements/tree/leaf-generator.py').read_text())
node.layoutChildren()
for index,label in enumerate(('Trunk','Branches','Twigs','Leaves'),1):
    component=next(c for c in node.children() if c.name().startswith('C%d_'%index));box=next((b for b in node.networkBoxes() if b.name()=='component_%d'%index),None) or node.createNetworkBox('component_%d'%index);box.setComment('C%d %s'%(index,label));box.addItem(component);box.fitAroundContents();box.setColor(hou.Color((.38,.46,.39)))
out=node.displayNode();geometry=out.geometry();assert len(geometry.prims())==report['primitives']
# 5 October 2026: centralize defaults before creating a reusable object HDA, without touching Lily's definition.
ptg=node.parmTemplateGroup()
for name,value in report['parameters'].items():
    template=ptg.find(name);template.setDefaultValue((value,));ptg.replace(name,template)
node.setParmTemplateGroup(ptg)
library=str(BASE/'otls/ZenRay_Eucalyptus_v002.hda')
if node.canCreateDigitalAsset():node=node.createDigitalAsset(name='zenray_eucalyptus::2.0',hda_file_name=library,description='ZenRay Eucalyptus Mask Fit v002')
