def iteration1(net, h, c):
    """ITERATION 1 (64 nodes): the spongy surface. Anthers and stigma head are covered by a network of bright bumps separated by dark pits (about 0.0045 canvas), plus a dark central groove down each anther, a fine grain on the stem, a bright ridge line along each tube and filament."""
    lv, ax, anthers, ms = c['lv'], c['ax'], c['anthers'], c['ms']
    n0 = len(net.children()); b = V.box(net, 'D', 'BAND 2 V2 ITERATION 1 : 64 nodes, spongy surface', (0.8, 1.0, 0.8))
    def maze(tag, size, radius_px, seed, mask, lo, hi):
        """a labyrinth of ridges and crevices: tiled noise fed to Turing Patterns (a real Copernicus node), remapped to lo..hi, masked, added. 5 nodes."""
        nz = T.node(net, 'fractalnoise', '%s_seed' % tag, [lv], amp=0.5, center=0.5, elementsize=size, noisetype=1, offx=seed, tilesizex=2.0 / CELLS)   # the seed tiles once per cell, so the labyrinth repeats with the cells
        tp = T.node(net, 'turingpatterns', '%s_turing' % tag, [nz], iterations=40, radius_pixel=radius_px, units=1)
        bl = T.node(net, 'blur', '%s_soften' % tag, [tp], units=1, size_pixel=1.6)
        return T.mix(net, '%s_added' % tag, h_cur[0], T.mix(net, '%s_masked' % tag, T.lin(net, '%s_range' % tag, bl, 0.0, 1.0, lo, hi), mask, 5), 3)
    h_cur = [h]
    h = maze('D11_maze_big', 0.010, 4.2, 3.3, anthers, -0.16, 0.22)
    h_cur[0] = h; h = maze('D12_maze_fine', 0.006, 2.4, 8.8, anthers, -0.05, 0.08)
    h_cur[0] = h; h = maze('D14_maze_stem', 0.004, 2.0, 5.5, ms, -0.08, 0.14)
    h_cur[0] = h; h = maze('D13_maze_head', 0.012, 5.0, 13.3, c['mhead'], -0.10, 0.16)
    h = V.grain(net, 'D21_grain_anthers', h, lv, anthers, 0.0016, 6.1, 0.07)
    h = V.pads(net, 'D', h, n0); V.close(net, b, 'D', n0); return h
