      '| Storyboard sheet | `petal_movie/storyboard_sheet.png` |',
      '| 3 petal base colours | `maps/trim/petals/lily_petal_01_basecolor.png`, `02`, `03` |',
      '| 4 Karma renders (RGBA, put on grey 118 for the movie) | `render/lily_4views_front_4k.png`, `side`, `three_quarter`, `top` (and `_grey` copies) |',
      '| Turn over frames | `render/turntable_top/turn_0001.png` to `turn_0072.png` (Karma CPU, 1866 x 1080, 16 samples) |',
      '| Title | `maps/trim/petals/title-animation/vogun-pop/vogun-mixed-pop-1s.mov` (opaque cream background rebuilt into an alpha: white text above the cream, shadow below it) |',
      '| Music | `~/.claude/tmp/tmp-vegetation-assets-collection-01/audio/Grandbrothers - Sonic Riots (3m59 to end).mp3` |', '',
      '## Timeline of the latest movie', '']
ms = sorted(glob.glob(V + '*.manifest.json'), key=os.path.getmtime)
if ms:
    d = json.load(open(ms[-1])); L += ['6 October 2026 : `%s`, %.2f s.' % (d['movie'], d['seconds']), '', '| Start | End | Shot | Source |', '|---|---|---|---|']
    for r in d['timeline']: L.append('| %.2f | %.2f | %s | `%s` |' % (r['start'], r['end'], r['shot'], r['source'].replace(P, '')))
