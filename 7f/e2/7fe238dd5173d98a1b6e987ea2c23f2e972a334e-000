import json, glob, os
P = '/Users/zenray/Create/Build/Productions/ZenRayHoudini/VegetationCollection01/'
V = P + 'video/'
L = ['# Lily movie, height map evolution to Karma renders (6 October 2026)', '',
     '6 October 2026 : project `vegetation-assets-collection-01` (ZenRay Assets V2), folder `ZenRayHoudini/VegetationCollection01/video/`. Built by `Scripts/AssembleLilyMovie.py`, this index by `Scripts/WriteMovieIndex.py`.', '',
