# 5 October 2026 : measure the CENTRAL big petal of the reference band 0 (cell 2, mirror symmetric about x = 0.5), averaged with its mirror image to remove noise: silhouette half width, tongue edge half width, tone profiles in the tongue, the wings and the ground. Writes ref-maps/big_petal.json. The reference is used only here, never inside the graph. FR : mesure du grand petale central.
import numpy as np, json
from PIL import Image
from scipy import ndimage as ndi
B = '/Users/zenray/Create/Build/Productions/ZenRayHoudini/VegetationCollection01/'
N = 2048; H = int(0.193 * N)
R = np.asarray(Image.open('/Users/zenray/.claude/tmp/tmp-vegetation-assets-collection-01/refs/flower-sheets/trimsheet-height-flower.png').convert('L').resize((N, N), Image.LANCZOS), np.float32)[:H] / 255
M = (R + R[:, ::-1]) / 2                      # mirror symmetric about x = 0.5
cell = M[:, N // 3: 2 * N // 3 + 1]            # cell 2, centre column at index (cell.shape[1]-1)/2
W = cell.shape[1]; c0 = (W - 1) / 2.0
S = ndi.gaussian_filter(cell, 1.5)
dx = np.gradient(S, axis=1)
rows = np.arange(H)
def canvas(px): return px / N                  # pixels to canvas fraction
sil = []; ton = []
for y in rows:
    lv = y / H
    left = dx[y, : int(c0)]
    # silhouette: the strongest dark to bright step going right, searched in the outer part of the cell
    i = int(np.argmax(left[: int(c0 - 6)])) if lv < 0.7 else None
    sil.append((lv, canvas(c0 - i) if i is not None else None))
    # tongue edge: strongest step between 0.012 and 0.095 canvas fractions from the centre
    lo, hi = int(c0 - 0.095 * N), int(c0 - 0.012 * N)
    seg = left[lo:hi]; j = lo + int(np.argmin(seg)) if lv > 0.40 else None    # bright (tongue) to dark (wing) when going left means a negative step going right
    ton.append((lv, canvas(c0 - j) if j is not None else None))
out = dict(silhouette=[(round(a, 3), round(b, 4)) for a, b in sil[::8] if b is not None], tongue=[(round(a, 3), round(b, 4)) for a, b in ton[::8] if b is not None])
json.dump(out, open(B + 'ref-maps/big_petal.json', 'w'))
print('silhouette'); [print(a, b) for a, b in out['silhouette'][::2]]
print('tongue'); [print(a, b) for a, b in out['tongue'][::2]]
