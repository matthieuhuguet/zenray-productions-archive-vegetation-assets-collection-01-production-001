import TrimNodes as T, BuildBand0V2 as V
RES = 1024; H = int(0.193 * RES)
hou.hipFile.clear(suppress_save_prompt=True)
net = hou.node('/obj').createNode('copnet', 'abl'); out = V.build(net)
ref = np.asarray(Image.open('/Users/zenray/.claude/tmp/tmp-vegetation-assets-collection-01/refs/flower-sheets/trimsheet-height-flower.png').convert('L').resize((RES, RES), Image.LANCZOS), np.float32)[:H] / 255
ref = (ref + ref[:, ::-1]) / 2; a, b = RES // 3, 2 * RES // 3 + 1; refc = ref[:, a:b]
def render():
    p = '/tmp/ablv2.png'; os.path.exists(p) and os.remove(p)
    r = net.node('abl_rop') or net.createNode('rop_image', 'abl_rop'); r.setInput(0, out); r.parm('copoutput').set(p); r.parm('colorconversion').set(2); r.parm('setres').set(1); r.parm('res1').set(RES); r.parm('res2').set(RES); r.parm('execute').pressButton()
    return np.asarray(Image.open(p).convert('L'), np.float32)[:H, a:b] / 255
def grad(x): return float(np.abs(np.diff(x, axis=1)).mean() + np.abs(np.diff(x, axis=0)).mean())
def err(x): return float(np.abs(blur(x, 2) - blur(refc, 2)).mean())
base = render(); m0, g0, e0 = base.mean(), grad(base), err(base)
