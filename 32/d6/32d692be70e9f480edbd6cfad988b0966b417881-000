from PIL import Image
from PIL import ImageFilter
def blur(x, sg): return np.asarray(Image.fromarray(np.clip(x * 255, 0, 255).astype(np.uint8)).filter(ImageFilter.GaussianBlur(sg)), np.float32) / 255
