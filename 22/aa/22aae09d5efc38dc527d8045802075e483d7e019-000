# 6 October 2026 : vibrance grade for the Cycles frames so they match the Karma look (mean saturation 0.32, top 10 percent 0.55). Saturation x SAT, value x VAL, applied on HSV in float. Usage: python3 GradeVivid.py <in_dir> <out_dir> <glob> [sat] [val]. FR : etalonnage vif des rendus Cycles.
import sys, glob, os
import numpy as np
from PIL import Image
src, dst, pat = sys.argv[1], sys.argv[2], sys.argv[3]; SAT = float(sys.argv[4]) if len(sys.argv) > 4 else 1.45; VAL = float(sys.argv[5]) if len(sys.argv) > 5 else 0.93
os.makedirs(dst, exist_ok=True)
def grade(rgb):
    r, g, b = rgb[..., 0], rgb[..., 1], rgb[..., 2]; mx = rgb.max(-1); mn = rgb.min(-1); d = mx - mn
    v = mx; s = np.where(mx > 0, d / np.maximum(mx, 1e-6), 0.0)
    s2 = np.clip(s * SAT, 0, 1); v2 = np.clip(v * VAL, 0, 1)
    # keep hue: rescale the distance of each channel from the max
    k = np.where(s > 1e-6, s2 / np.maximum(s, 1e-6), 1.0)
    out = v2[..., None] * (1 - k[..., None] * (1 - rgb / np.maximum(mx, 1e-6)[..., None]))
    return np.clip(out, 0, 1)
for f in sorted(glob.glob(os.path.join(src, pat))):
    a = np.asarray(Image.open(f).convert('RGB'), float) / 255.0
    Image.fromarray((grade(a) * 255 + 0.5).astype('uint8')).save(os.path.join(dst, os.path.basename(f)))
print('graded', len(glob.glob(os.path.join(dst, '*.png'))))
