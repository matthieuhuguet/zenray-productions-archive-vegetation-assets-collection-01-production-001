# 5 October 2026 : derive a colour ramp for each band by QUANTILE MATCHING: the generated band height at its percentile p gets the colour of the base colour reference (region assigned to that band) at the same luminance percentile p. Output ref-maps/band_palettes.json = for each band a list of (driver value, r, g, b). The base colour reference is used only here, never in the graph. FR : palettes par appariement des quantiles.
import json, numpy as np
from PIL import Image
B = '/Users/zenray/Create/Build/Productions/ZenRayHoudini/VegetationCollection01/'
REF = np.asarray(Image.open('/Users/zenray/.claude/tmp/tmp-vegetation-assets-collection-01/refs/flower-sheets/04_gen_trimsheet-basecolor_v1.png').convert('RGB'), np.float64) / 255
N = REF.shape[0]
# base colour sheet rows (fraction of height) assigned to each height band: 0 tepal inner <- 0..0.195, 1 tepal outer <- 0.195..0.375, 2 stamens <- 0.375..0.555, 3 calyx <- smooth green stalk 0.555..0.67, 4 stem <- speckled stem 0.67..0.815, 5 leaf <- 0.815..0.985, 6 bud <- smooth green stalk (pink tinged) 0.555..0.67
ROWS = {0: (0.003, 0.192), 1: (0.198, 0.372), 2: (0.378, 0.552), 3: (0.558, 0.665), 4: (0.675, 0.812), 5: (0.822, 0.982), 6: (0.558, 0.665)}
GEN = {0: ('previews/band0v3_nodes.png', 0.0, 0.193), 1: ('previews/band1v2_nodes.png', 0.193, 0.388), 2: ('previews/band2v2_nodes.png', 0.388, 0.507), 3: ('previews/band3v2_nodes.png', 0.507, 0.609), 4: ('previews/band4v3_nodes.png', 0.609, 0.725), 5: ('previews/band5_nodes.png', 0.725, 0.837), 6: ('previews/band6v2_nodes.png', 0.837, 1.0)}
P = [0, 3, 8, 15, 25, 35, 45, 55, 65, 75, 85, 92, 97, 100]
out = {}
for k, (f, a, b) in GEN.items():
    g = np.asarray(Image.open(B + f).convert('L'), np.float64) / 255; Hh = g.shape[0]
    gb = g[int(a * Hh) + 3:int(b * Hh) - 3]; ra, rb = ROWS[k]; rb_ = REF[int(ra * N):int(rb * N)]
    lum = rb_ @ np.array([0.2126, 0.7152, 0.0722]); order = np.argsort(lum.ravel()); flat = rb_.reshape(-1, 3)[order]
    keys = []
    for p in P:
        dv = float(np.percentile(gb, p)); lo = max(0, int(len(flat) * (p - 2) / 100)); hi = min(len(flat), max(lo + 1, int(len(flat) * (p + 2) / 100)))
        col = flat[lo:hi].mean(0); keys.append((round(dv, 4), *[round(float(c), 4) for c in col]))
    # keep keys strictly increasing in the driver
    clean = []
    for kk in keys:
        if not clean or kk[0] > clean[-1][0] + 1e-4: clean.append(kk)
    out[k] = clean; print(k, [(round(x[0], 2), tuple(int(c * 255) for c in x[1:])) for x in clean][::2])
json.dump(out, open(B + 'ref-maps/band_palettes.json', 'w'))
