// 6 October 2026 14:00: Render HTML glyph motion once per moving frame, reuse the static hold.
const fs=require('fs'),path=require('path'),{spawn}=require('child_process'),{once}=require('events');
const {chromium}=require('playwright');
const output=path.resolve(__dirname,'../maps/trim/petals/title-animation');
const config=JSON.parse(fs.readFileSync(path.join(output,'Animation.json')));
(async()=>{const browser=await chromium.launch({headless:true});try{await Promise.all(config.variants.map(async variant=>{
 const page=await browser.newPage({viewport:{width:config.width,height:config.height},deviceScaleFactor:1});await page.goto('file://'+path.join(output,'Animation.html'));const layout=await page.evaluate(async({config,variant})=>await setup(config,variant),{config,variant});
 const file=path.join(output,variant.id+'.mov');const log=fs.openSync(path.join(output,variant.id+'.log'),'w');const encoder=spawn('ffmpeg',['-y','-hide_banner','-loglevel','error','-f','image2pipe','-framerate',String(config.fps),'-vcodec','png','-i','pipe:0','-an','-c:v','hevc_videotoolbox','-b:v','6000k','-tag:v','hvc1','-pix_fmt','yuv420p','-movflags','+faststart',file],{stdio:['pipe',log,log]});const completion=once(encoder,'close');let holdFrame;let samples=[];
 for(let i=0;i<config.fps*(config.appear+config.hold+config.disappear);i++){const t=i===149?5:i/config.fps;let buffer;if(t>=1&&t<4&&holdFrame){buffer=holdFrame}else{await page.evaluate(t=>renderFrame(t),t);buffer=await page.screenshot({type:'png'});if(t===1)holdFrame=buffer;}if([0,9,18,30,120,149].includes(i)){const sample=variant.id+'-'+String(i).padStart(3,'0')+'.png';fs.writeFileSync(path.join(output,sample),buffer);samples.push(sample)}if(!encoder.stdin.write(buffer))await once(encoder.stdin,'drain');}
 encoder.stdin.end();const [code]=await completion;if(code!==0)throw Error('Encoder failed '+variant.id);await page.close();return {id:variant.id,layout,samples,bytes:fs.statSync(file).size};})).then(result=>fs.writeFileSync(path.join(output,'RenderReport.json'),JSON.stringify({date:'6 October 2026',result},null,2)));}finally{await browser.close();}})().catch(e=>{console.error(e);process.exitCode=1});
