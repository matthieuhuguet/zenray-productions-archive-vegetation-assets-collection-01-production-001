# 6 October 2026 16:05: Create an isolated USD scene to verify Solaris render delegates.
from pathlib import Path
from pxr import Usd, UsdGeom, UsdLux, UsdShade, UsdRender, Gf, Sdf

CONFIG = {
    "root": "/Users/zenray/.claude/tmp/tmp-vegetation-assets-collection-01/renderers/tests",
    "resolution": 128,
    "samples": 8,
}
root = Path(CONFIG["root"])
root.mkdir(parents=True, exist_ok=True)
stage = Usd.Stage.CreateNew(str(root / "Smoke.usda"))
UsdGeom.SetStageUpAxis(stage, UsdGeom.Tokens.y)
UsdGeom.SetStageMetersPerUnit(stage, 1.0)
world = UsdGeom.Xform.Define(stage, "/World")
stage.SetDefaultPrim(world.GetPrim())
sphere = UsdGeom.Sphere.Define(stage, "/World/Sphere")
sphere.CreateRadiusAttr(1)
sphere.AddTranslateOp().Set(Gf.Vec3d(0, 1, 0))
plane = UsdGeom.Mesh.Define(stage, "/World/Ground")
plane.CreatePointsAttr([(-5, 0, -5), (-5, 0, 5), (5, 0, 5), (5, 0, -5)])
plane.CreateFaceVertexCountsAttr([4])
plane.CreateFaceVertexIndicesAttr([0, 1, 2, 3])
plane.CreateSubdivisionSchemeAttr("none")
material = UsdShade.Material.Define(stage, "/World/Material")
shader = UsdShade.Shader.Define(stage, "/World/Material/Surface")
shader.CreateIdAttr("UsdPreviewSurface")
shader.CreateInput("diffuseColor", Sdf.ValueTypeNames.Color3f).Set(Gf.Vec3f(0.15, 0.55, 0.2))
shader.CreateInput("roughness", Sdf.ValueTypeNames.Float).Set(0.4)
shader.CreateOutput("surface", Sdf.ValueTypeNames.Token)
material.CreateSurfaceOutput().ConnectToSource(shader.ConnectableAPI(), "surface")
UsdShade.MaterialBindingAPI.Apply(sphere.GetPrim()).Bind(material)
light = UsdLux.DomeLight.Define(stage, "/World/Light")
light.CreateIntensityAttr(0.7)
camera = UsdGeom.Camera.Define(stage, "/World/Camera")
camera.AddTransformOp().Set(Gf.Matrix4d().SetLookAt(Gf.Vec3d(4,3,6), Gf.Vec3d(0,1,0), Gf.Vec3d(0,1,0)).GetInverse())
camera.CreateFocalLengthAttr(45)
camera.CreateClippingRangeAttr(Gf.Vec2f(0.1,100))
settings = UsdRender.Settings.Define(stage, "/Render/Settings")
settings.CreateCameraRel().SetTargets([camera.GetPath()])
settings.CreateResolutionAttr(Gf.Vec2i(CONFIG["resolution"]))
settings.GetPrim().CreateAttribute("cycles:device", Sdf.ValueTypeNames.String).Set("METAL")
settings.GetPrim().CreateAttribute("cycles:samples", Sdf.ValueTypeNames.Int).Set(CONFIG["samples"])
settings.GetPrim().CreateAttribute("karma:global:pixel_samples", Sdf.ValueTypeNames.Int).Set(CONFIG["samples"])
product = UsdRender.Product.Define(stage, "/Render/Product")
product.CreateProductNameAttr(str(root / "Smoke.exr"))
product.CreateProductTypeAttr("raster")
product.CreateCameraRel().SetTargets([camera.GetPath()])
product.CreateResolutionAttr(Gf.Vec2i(CONFIG["resolution"]))
aov = UsdRender.Var.Define(stage, "/Render/Beauty")
aov.GetPrim().CreateAttribute("driver:parameters:aov:husk:name", Sdf.ValueTypeNames.String).Set("color")
aov.CreateSourceNameAttr("color")
aov.CreateSourceTypeAttr("raw")
aov.CreateDataTypeAttr("color4f")
product.CreateOrderedVarsRel().SetTargets([aov.GetPath()])
settings.CreateProductsRel().SetTargets([product.GetPath()])
stage.SetMetadata("renderSettingsPrimPath", str(settings.GetPath()))
stage.GetRootLayer().Save()
print(stage.GetRootLayer().realPath)

# 6 October 2026 16:16: Preserve a matching Karma scene for before-and-after comparison.
karma_path = root / "KarmaSmoke.usda"
stage.GetRootLayer().Export(str(karma_path))
karma_stage = Usd.Stage.Open(str(karma_path))
karma_aov = karma_stage.GetPrimAtPath("/Render/Beauty")
karma_aov.GetAttribute("sourceName").Set("C.*[LO]")
karma_aov.GetAttribute("sourceType").Set("lpe")
karma_aov.CreateAttribute("driver:parameters:aov:husk:format", Sdf.ValueTypeNames.Token).Set("color4h")
karma_aov.CreateAttribute("driver:parameters:aov:husk:clearValue", Sdf.ValueTypeNames.Float).Set(0)
karma_aov.CreateAttribute("driver:parameters:aov:husk:multiSampled", Sdf.ValueTypeNames.Bool).Set(True)
karma_aov.GetAttribute("driver:parameters:aov:husk:name").Set("C")
karma_stage.GetRootLayer().Save()
