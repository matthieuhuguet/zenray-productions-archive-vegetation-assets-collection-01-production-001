# 5 October 2026 : shared segmentation of a trim band into object and ground (same recipe for the reference and for the generated height, so the two masks are comparable): Gaussian 2 px, Otsu threshold, opening, closing, hole fill, small blobs removed. Used by TrimLab.py and FitTrim.py. FR : segmentation commune reference / genere.
import numpy as np
from scipy import ndimage as ndi
def otsu(x):
    h, e = np.histogram(x, 128, (0, 1)); p = h / max(h.sum(), 1); w = np.cumsum(p); m = np.cumsum(p * (e[:-1] + e[1:]) / 2); mt = m[-1]
    s = (mt * w - m) ** 2 / (w * (1 - w) + 1e-9); return float(e[np.argmax(s)])
def seg(band, thr=None):
    sm = ndi.gaussian_filter(band, 2.0 * band.shape[1] / 1024.0); t = otsu(sm) if thr is None else thr; fg = sm > t
    fg = ndi.binary_opening(fg, iterations=2); fg = ndi.binary_closing(fg, iterations=3); fg = ndi.binary_fill_holes(fg)
    lab, n = ndi.label(fg)
    if n:
        sizes = ndi.sum(fg, lab, range(1, n + 1)); fg = np.isin(lab, [i + 1 for i, s_ in enumerate(sizes) if s_ > 0.003 * fg.size])
    return fg
def iou(a, b): return float((a & b).sum()) / max(float((a | b).sum()), 1.0)
