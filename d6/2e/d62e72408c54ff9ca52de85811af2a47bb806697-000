def Q(s): B.append({'type': 'quote', 'props': {}, 'content': inline(s)})
def CODE(s): B.append({'type': 'codeBlock', 'props': {}, 'content': [text(s)]})
def TABLE(columns, rows, caption=''): B.append({'type': 'table', 'props': {'columns': columns, 'rows': rows, **({'caption': caption} if caption else {})}})
def IMG(slug):
    it = IDX[slug]; USED.append(slug)
    B.append({'id': 'i-%02d' % it['number'], 'type': 'image', 'props': {'url': URL + it['file'], 'caption': 'Figure %d. %s' % (it['number'], it['caption']), 'alt': it['alt'], 'width': it['width'], 'height': it['height']}})
