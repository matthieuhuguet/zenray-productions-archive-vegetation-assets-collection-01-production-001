# ---------------------------------------------------------------- inline markup:  **bold**  *italic*  `code`  [text](url)
TOKEN = re.compile(r'(\*\*[^*]+\*\*|`[^`]+`|\[[^\]]+\]\([^)]+\)|\*[^*\s][^*]*\*)')
def text(s, **st): return {'type': 'text', 'text': s, 'styles': {k: True for k, v in st.items() if v}}
def inline(s):
    out = []
    for part in TOKEN.split(s):
        if not part: continue
        if part.startswith('**'): out.append(text(part[2:-2], bold=True))
        elif part.startswith('`'): out.append(text(part[1:-1], code=True))
        elif part.startswith('['):
            m = re.match(r'\[([^\]]+)\]\(([^)]+)\)', part); out.append({'type': 'link', 'href': m.group(2), 'content': [text(m.group(1))]})
        elif part.startswith('*') and part.endswith('*') and len(part) > 2: out.append(text(part[1:-1], italic=True))
        else: out.append(text(part))
    return out

B = []   # the blocks, in order
def P(s): B.append({'type': 'paragraph', 'props': {}, 'content': inline(s)})
def H2(s, anchor): B.append({'id': anchor, 'type': 'heading', 'props': {'level': 2}, 'content': inline(s)})
def H3(s): B.append({'type': 'heading', 'props': {'level': 3}, 'content': inline(s)})
def UL(items):
