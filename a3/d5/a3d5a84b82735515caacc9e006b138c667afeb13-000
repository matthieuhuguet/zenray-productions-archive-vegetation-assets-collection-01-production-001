    am = T.mix(net, 'D23_arch__modulated', ma, V.modulation(net, 'D22_arch__modulation', lv, 0.05, 0.5, 2.0, 3.3, 0.1), 5)
    h = V.lines_layer(net, 'D24_chevrons', h, chev, 230, soft, 0.15, 0.05, 0.40, am, lv)
    def maze(tag, size, rad, seed, mask, lo, hi, base):
        nz = T.node(net, 'fractalnoise', '%s_seed' % tag, [lv], amp=0.5, center=0.5, elementsize=size, noisetype=1, offx=seed, tilesizex=2.0 / CELLS)
        tp = T.node(net, 'turingpatterns', '%s_turing' % tag, [nz], iterations=40, radius_pixel=rad, units=1); bl = T.node(net, 'blur', '%s_soften' % tag, [tp], units=1, size_pixel=1.4)
        return T.mix(net, '%s_added' % tag, base, T.mix(net, '%s_masked' % tag, T.lin(net, '%s_range' % tag, bl, 0.0, 1.0, lo, hi), mask, 5), 3)
    h = maze('D31_mottle_funnel', 0.006, 3.0, 5.1, fun, -0.04, 0.07, h)
    side = V.profile(net, 'D42_block_side', T.mix(net, 'D42a_wB_minus_dsb', net.node('B04_block__halfwidth'), c['dsb'], 4), [(-0.02, 0.0), (-0.004, -0.12), (-0.001, -0.14), (0.0007, 0.12), (0.004, 0.04), (0.012, 0.0), (0.03, 0.0)], -0.02, 0.03, -0.2, 0.25)
    h = T.mix(net, 'D43_block_side__added', h, T.mix(net, 'D43a_masked', T.mix(net, 'D43c_near_block', side, T.smooth(net, 'D43d_near', T.mix(net, 'D43e_wB_minus_dsb', net.node('B04_block__halfwidth'), c['dsb'], 4), -0.010, -0.006), 5), T.smooth(net, 'D43b_below_top', lv, 0.665, 0.70), 5), 3)
