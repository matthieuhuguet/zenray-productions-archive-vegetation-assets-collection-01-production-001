    for k, slot in enumerate(flower_slots()):
        if slot[3]: continue
        B, d = flower_frame(slot); e1, e2 = frame_perp(d); roll = rnd.uniform(0, 2 * math.pi); Ls = PRM('stamen_length') * slot[4]
        for j in range(6):
            a = roll + j * math.pi / 3.0 + 0.2; r = e1 * math.cos(a) + e2 * math.sin(a); l = d.cross(r).normalized(); sp = rnd.uniform(0.008, 0.022)
            pts = bez(B + r * 0.003, B + d * Ls * 0.4 + r * 0.004, B + d * Ls * 0.8 + r * sp * 0.7, B + d * Ls * 0.97 + r * sp, 7)
            tube(geo, pts, [0.0011 - 0.0003 * i / 6.0 for i in range(7)], 5, 'stamen', 'filament%d_%d' % (k, j), OLIVE)
            tip = pts[-1]; tdir = (pts[-1] - pts[-2]).normalized(); ax = (l * 0.6 + tdir * 0.5 + r * 0.2 * rnd.uniform(-1, 1)).normalized(); ac = [tip - ax * 0.007 + ax * (0.021 * i / 6.0) for i in range(7)]
            tube(geo, ac, [0.0034 * (math.sin(math.pi * (0.08 + 0.84 * i / 6.0)) ** 0.5) + 0.0003 for i in range(7)], 8, 'anther', 'anther%d_%d' % (k, j), ORANGE)
