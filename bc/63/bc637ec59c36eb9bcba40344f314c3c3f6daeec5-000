# fibre orientation: structure tensor angle, mean over blocks
def orient(img, ins, dd):
    gy, gx = np.gradient(hp(img, 1.2)); out = np.full((H // 20, 1254 // 20), np.nan)
    for i in range(H // 20):
        for j in range(1254 // 20):
            sl = (slice(i * 20, i * 20 + 20), slice(j * 20, j * 20 + 20))
            if ins[sl].all() and (dd[sl] > 14).all():
                jxx = (gx[sl] ** 2).sum(); jyy = (gy[sl] ** 2).sum(); jxy = (gx[sl] * gy[sl]).sum()
                out[i, j] = 0.5 * np.degrees(np.arctan2(2 * jxy, jxx - jyy))
    return out
