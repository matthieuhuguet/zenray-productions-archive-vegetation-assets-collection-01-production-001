def edges(img, y):
    """distance from the nominal cell centre to the left and right edge (steep crossing of 0.55 going inward), per petal: [(dL, dR), ...]."""
    row = img[y]; out = []
    for c in range(3):
        cx = c * W + W // 2; pair = []
        for sgn in (-1, 1):
            e = None
            for d in range(int(W / 2) - 1, 3, -1):
                x = cx + sgn * d
                if 0 <= x < 1254 and row[x] > 0.55 and row[max(0, x - sgn * 3)] > 0.5: e = d; break
            pair.append(e)
        out.append(tuple(pair))
    return out
def maps(img):
    """half width per row and petal, and the horizontal offset of the true axis of each petal (the AI sheet is not exactly periodic: the axes sit a few px away from the nominal centres). Offset = median over rows 60..140 of (dR - dL) / 2."""
    hw = np.zeros((H, 3)); offs = [[] for _ in range(3)]
    for y in range(H):
        e = edges(img, y)
        for c in range(3):
            dl, dr = e[c]
            if dl is not None and dr is not None:
                hw[y, c] = (dl + dr) / 2.0
                if 60 <= y <= 140: offs[c].append((dr - dl) / 2.0)
            elif dl is not None or dr is not None: hw[y, c] = dl if dl is not None else dr
    off = np.array([np.median(o) if o else 0.0 for o in offs])
    return hw, off
