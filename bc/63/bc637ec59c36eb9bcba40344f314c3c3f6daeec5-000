def coords(hw, off):
    Y, X = np.mgrid[0:H, 0:1254]; C = (X // W).clip(0, 2); cx = C * W + W // 2 + off[C]
    h = hw[Y, C]; dx = np.abs(X - cx); t = dx / np.maximum(h, 1); d = h - dx
    return Y, t, d, h
