SIG = float(sys.argv[2]) if len(sys.argv) > 2 else 1.2
def otable(img, ins, dd, tt, side):
    gy, gx = np.gradient(hp(img, SIG)); X = np.arange(1254)[None, :].repeat(H, 0); right = ((X % W) > W // 2) if side > 0 else ((X % W) < W // 2)
    out = []
    for r0, r1 in [(20, 60), (60, 100), (100, 140), (140, 180), (180, 232)]:
        line = []
        for t0, t1 in [(0.1, 0.25), (0.25, 0.4), (0.4, 0.55), (0.55, 0.7), (0.7, 0.9)]:
            m = ins & (dd > 14) & (tt >= t0) & (tt < t1) & right; m[:r0] = False; m[r1:] = False
            if m.sum() < 200: line.append(None); continue
            jxx = (gx[m] ** 2).sum(); jyy = (gy[m] ** 2).sum(); jxy = (gx[m] * gy[m]).sum(); line.append(round(float(0.5 * np.degrees(np.arctan2(2 * jxy, jxx - jyy))), 0))
        out.append(line)
    return out
