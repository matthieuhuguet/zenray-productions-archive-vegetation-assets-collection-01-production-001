# 5 October 2026 : numbers for one generated band against the reference: mean, std, percentiles, gradient energy (detail density), vertical profile correlation and horizontal structure period, plus the seam error between the first and last columns. Usage: python3 BandStats.py <png> <v0> <v1>. FR : mesures d'une bande.
import sys, numpy as np
from PIL import Image
g = np.asarray(Image.open(sys.argv[1]).convert('L'), np.float32) / 255; N = g.shape[0]
r = np.asarray(Image.open('/Users/zenray/.claude/tmp/tmp-vegetation-assets-collection-01/refs/flower-sheets/trimsheet-height-flower.png').convert('L').resize((N, N)), np.float32) / 255
a, b = int(float(sys.argv[2]) * N) + 2, int(float(sys.argv[3]) * N) - 2; G, R = g[a:b], r[a:b]
def st(x): return dict(mean=x.mean(), std=x.std(), p10=np.percentile(x, 10), p90=np.percentile(x, 90), grad=np.abs(np.diff(x, axis=1)).mean() + np.abs(np.diff(x, axis=0)).mean())
for n, x in (('ref', R), ('gen', G)): print(n, {k: round(float(v), 3) for k, v in st(x).items()})
pc = np.corrcoef(R.mean(1), G.mean(1))[0, 1]; col = np.abs(np.diff(G, axis=1)).mean(0); seam = np.abs(G[:, 0] - G[:, -1]).mean()
print('vertical profile corr %.2f   seam percentile %.0f (0 = best)' % (pc, (col < seam).mean() * 100))
