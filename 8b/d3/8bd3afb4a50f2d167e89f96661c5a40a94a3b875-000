# 5 October 2026 : OPTIMISATION step of the iteration protocol. For every detail layer of a band (the node whose name contains "_added"), bypass it, re-export the band and measure how much the band changes (mean absolute difference in 8 bit grey levels). Layers below the threshold are listed for removal. Also prints the band statistics against the reference. Usage: hython Ablate.py <band module name e.g. BuildTrimBand0> [threshold=1.0]. FR : optimisation par ablation.
import hou, sys, os, importlib
import numpy as np
from PIL import Image
sys.path.insert(0, '/Users/zenray/Create/Build/Productions/ZenRayHoudini/VegetationCollection01/Scripts')
import TrimNodes as T
mod = importlib.import_module(sys.argv[1]); thr = float(sys.argv[2]) if len(sys.argv) > 2 else 1.0
RES = 512
hou.hipFile.clear(suppress_save_prompt=True)
net = hou.node('/obj').createNode('copnet', 'abl'); net.parm('res1').set(RES); net.parm('res2').set(RES)
out = mod.build(net)
def render():
    p = '/tmp/abl.png'; os.path.exists(p) and os.remove(p)
    r = net.node('abl_rop') or net.createNode('rop_image', 'abl_rop'); r.setInput(0, out); r.parm('copoutput').set(p); r.parm('colorconversion').set(2); r.parm('execute').pressButton()
    return np.asarray(Image.open(p).convert('L').resize((RES, RES), Image.LANCZOS), np.float32)   # the ROP writes 1024 whatever the net resolution
base = render(); H = int(0.193 * RES); b0 = base[:H]
ref = np.asarray(Image.open('/Users/zenray/.claude/tmp/tmp-vegetation-assets-collection-01/refs/flower-sheets/03_gen_trimsheet-height_v1.png').convert('L').resize((RES, RES)), np.float32)[:H]
print('band stats  mean ref/gen %.0f/%.0f  std %.0f/%.0f' % (ref.mean(), b0.mean(), ref.std(), b0.std()))
def grad(a): return float(np.abs(np.diff(a, axis=1)).mean() + np.abs(np.diff(a, axis=0)).mean()) / 255.0
from PIL import ImageFilter
def soft(a): return np.asarray(Image.fromarray(np.clip(a, 0, 255).astype(np.uint8)).filter(ImageFilter.GaussianBlur(3)), np.float32)
refS = soft(ref); err0 = float(np.abs(soft(b0) - refS).mean()); g0 = grad(b0)
print('base structure error %.2f  grad %.4f (reference grad %.4f)' % (err0, g0, grad(ref)))
# 5 October 2026 (fix): the candidates are the nodes that ADD or SUBTRACT a layer (_added and _subtracted); each is judged on three things: mean change, detail energy change (gradient) and the structure error to the reference (blurred), so a layer that only adds noise is told apart from one that builds structure.
res = []
for n in [c for c in net.children() if ('_added' in c.name() or '_subtracted' in c.name())]:
    n.bypass(True); a = render()[:H]; n.bypass(False)
    res.append((float(np.abs(a - b0).mean()), grad(a) - g0, float(np.abs(soft(a) - refS).mean()) - err0, n.name()))
print('%6s %8s %8s  node' % ('dmean', 'dgrad', 'derr'))
for d, dg, de, nm in sorted(res, reverse=True):
    useless = d < thr and abs(dg) < 0.001 and abs(de) < 0.1       # changes nothing
    harmful = de < -0.5                                              # removing it LOWERS the structure error to the reference
    print('%6.2f %+8.4f %+8.2f  %s %s' % (d, dg, de, nm, '  <- remove (useless)' if useless else ('  <- remove (harmful)' if harmful else '')))
