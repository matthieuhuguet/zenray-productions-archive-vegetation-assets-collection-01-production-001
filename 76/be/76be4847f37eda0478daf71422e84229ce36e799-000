LEVEL = [(0, .80), (.08, .90), (.15, .88), (.22, .83), (.30, .80), (.38, .76), (.46, .74), (.55, .73), (.65, .72), (.75, .68), (.82, .66), (.90, .66), (.95, .65), (1.0, .64)]
