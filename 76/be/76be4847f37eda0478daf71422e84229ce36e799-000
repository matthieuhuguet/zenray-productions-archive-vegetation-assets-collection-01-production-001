    return lv, ax, wb, mb
def build(net):
    rx = T.node(net, 'ramp', 'A00_ramp__three_cycles_x', signature='f1', cycles=3.0, method=1); ry = T.node(net, 'ramp', 'A01_ramp__down_y', signature='f1', rotation=90.0)
    lv, ax, wb, mb = coords(net, ry, rx)
    t = T.node(net, 'clamp', 'C01_across_ratio', [T.mix(net, 'C01a_ax_over_wb', ax, T.mix(net, 'C01b_floor', wb, T.const(net, 'C01c', lv, 0.01), 12), 6)])
    # 6 October 2026: THE VAULTED TONE SURFACE, measured (median tone per row band and per t bin on ref 06): flat 0.78 at the top, a growing dark valley toward the axis at the bottom (0.51 at t 0.12). Six curves across the petal, blended along the petal by six hat functions.
    cs = MEAS['tone_rows_lv']; tc = MEAS['tone_t_centres']; tone = None
    for k, row in enumerate(MEAS['tone']):
        vals = [v if v is not None else row[-2] for v in row]
        vals = [vals[-1] - VAULT * (vals[-1] - v) for v in vals]      # 6 October 2026: VAULT x scales the dark valley toward the axis against the edge tone of the same row (1.0 = measured on ref 06)
        keys = [(0.0, vals[0] - 0.01)] + list(zip(tc, vals)) + [(1.0, vals[-1])]
        ck = T.curve(net, 'C02_tone_row%d' % k, t, keys, 1.0, 0.0, 1.0, T.SMOOTH)
        hk = [(0.0, 1.0 if k == 0 else 0.0)] + ([(cs[k - 1], 0.0)] if k > 0 else []) + [(cs[k], 1.0)] + ([(cs[k + 1], 0.0)] if k < 5 else []) + [(1.0, 1.0 if k == 5 else 0.0)]
        hw_ = T.curve(net, 'C02_hat_row%d' % k, lv, hk, 1.0, 0.0, 1.0, None)
        term = T.mix(net, 'C02_row%d_weighted' % k, ck, hw_, 5); tone = term if tone is None else T.mix(net, 'C02_sum%d' % k, tone, term, 3)
    tone = T.mix(net, 'C03_tone_plus_bias', tone, T.const(net, 'C03a_bias', lv, 0.025), 3)      # 6 October 2026: the dark layers (grooves, pits) lower the mean by 0.055 against the measured median, so the base is raised by the same amount
    ground = T.const(net, 'C05_ground', lv, GROUND)
    h = T.mix(net, 'C06_over_ground', ground, T.mix(net, 'C06a_delta_masked', T.mix(net, 'C06b_delta', tone, ground, 4), mb, 5), 3)
    c = dict(lv=lv, ax=ax, wb=wb, mb=mb, t=t, rx=rx)
    if UPTO >= 1: h = iteration1(net, h, c)
    if UPTO >= 2: h = iteration2(net, h, c)
    return h
