    lv, ax, wb, mb = c['lv'], c['ax'], c['wb'], c['mb']
    n0 = len(net.children()); b = V.box(net, 'H', 'BAND 0 V3 ITERATION 2 : 64 nodes, speckles', (1.0, 0.8, 0.85))
    spk = speckles(net, lv, ax, wb, mb, rx=c['rx'])
    h = T.mix(net, 'H11_speckles__added', h, T.lin(net, 'H11a_gain', spk, 0.0, 1.0, 0.0, -0.42), 3)
    # 6 October 2026 (Matthieu): the 3D effect of the dots = a small WHITE POINT inside a BLACK SPHERE (the first bead shading was coarse): a second, tiny round mask from the same dot field (Worley distance under 0.022) pulled to a bright tone.
    hl = speckles(net, lv, ax, wb, mb, 'SH', hot=True)
    h = T.mix(net, 'H11b_white_point__added', h, T.mix(net, 'H11c_pull', T.mix(net, 'H11d_gap', T.const(net, 'H11e_white', lv, 0.84), h, 4), hl, 5), 3)   # 6 October 2026: the dots of the v2 reference are dark PITS (p1 of the petal 0.34 against 0.55 before), not raised bumps
    h = V.dots_layer(net, 'H21_pores', h, lv, mb, 0.0022, 9.9, 0.66, 0.045)
    h = V.dots_layer(net, 'H22_pores_dark', h, lv, mb, 0.0017, 14.1, 0.70, -0.04)
    h = V.pads(net, 'H', h, n0); V.close(net, b, 'H', n0); return h
def opacity(net, ry, rx):
    """the petal mask alone (1 inside a petal, 0 on the ground between petals) for the opacity map. FR : masque d'opacite."""
    lv = T.lin(net, 'OP0_lv', ry, 0.0, BAND_V1); cx = T.lin(net, 'OP0_cx', rx, 0.0, 1.0, -1.0 / 6, 1.0 / 6); ax = T.mix(net, 'OP0_ax', cx, T.const(net, 'OP0_zero', lv, 0.0), 9)
    wb = T.curve(net, 'OP0_wb', lv, [(x, y / 0.2) for x, y in SIL], 1.0, 0.0, 0.2, T.SMOOTH)
    wb = scallop(net, 'OP0s', lv, wb)
    return T.mix(net, 'OP0_mask', T.smooth(net, 'OP0_edge', T.mix(net, 'OP0_dist', wb, ax, 4), -EDGE * 0.6, EDGE * 0.6), T.smooth(net, 'OP0_top', lv, 0.0, 0.002), 5)
