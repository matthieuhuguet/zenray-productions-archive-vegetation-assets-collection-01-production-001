    rough = T.node(net, 'null', 'ROUGHNESS', [T.node(net, 'clamp', 'R40_clamp', [T.mix(net, 'R31_rough', lvl, crev, 3)])])
    hard = []                                                       # opacity must NOT cross fade between bands: hard windows of 2 px
    for k, (a_, b_) in enumerate(EDGES):
        eh = 0.0010
        up = T.smooth(net, 'OW%d_in' % k, ry, a_ - eh, a_ + eh) if k > 0 else T.const(net, 'OW%d_in' % k, ry, 1.0)
        dn = T.smooth(net, 'OW%d_out' % k, ry, b_ - eh, b_ + eh, 1.0, 0.0) if k < 6 else T.const(net, 'OW%d_out' % k, ry, 1.0)
        hard.append(T.mix(net, 'OW%d' % k, up, dn, 5))
    masks = {0: B0.opacity(net, ry, rx3), 5: B56.leaf_opacity(net, ry, rx3), 6: B6.opacity(net, ry, rx3)}      # petals, leaf lens and buds are cut out; every other band is opaque
    acc = None
    for k in range(7):
        mk = masks.get(k, T.const(net, 'O1%d_one' % k, ry, 1.0)); c = T.mix(net, 'O2%d_mask_band%d' % (k, k), mk, hard[k], 5); acc = c if acc is None else T.mix(net, 'O3%d_plus_band%d' % (k, k), acc, c, 3)
    opac = T.node(net, 'null', 'OPACITY', [acc])
    maps = dict(height=fin, basecolor=base, normal=nrm, ao=ao, roughness=rough, opacity=opac)
    sw_in = []
    for nm in ('height', 'basecolor', 'normal', 'ao', 'roughness', 'opacity'):
        src = maps[nm]; sw_in.append(src if nm in ('basecolor', 'normal') else T.node(net, 'monotorgb', 'V0_%s_as_rgb' % nm, [src]))      # one signature (RGB) so the switch can flip between all maps
    view = T.node(net, 'switch', 'VIEW_switch_between_maps', sw_in)
    maps['view'] = view
    tidy(net, bands, maps)
