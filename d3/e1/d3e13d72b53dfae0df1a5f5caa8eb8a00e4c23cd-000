def color_ramp(keys): return hou.Ramp([hou.rampBasis.Linear] * len(keys), [k[0] for k in keys], [tuple(k[1:]) for k in keys])
def flat_colour(net, name, like, rgb):
    n = T.node(net, 'monotorgb', name, [T.const(net, name + '_src', like, 0.5)]); n.parm('ramp').set(color_ramp([(0.0,) + rgb, (1.0,) + rgb])); return n
def subnet_band(net, k):
    sn = net.createNode('subnet', 'Band%d' % k); out = BUILDERS[k](sn)
    out = T.node(sn, 'channelextract', 'OUT_mono', [out], channel=0)   # a subnet hands back RGBA: keep the first channel so every consumer reads MONO
    on = sn.createNode('null', 'OUT'); on.setInput(0, out); [c for c in sn.children() if c.type().name() == 'output'][0].setInput(0, on); return sn
def tidy(net, bands, maps):
    """6 October 2026 (Matthieu: tidy the graph, align the final maps in one column to flip between them quickly). Columns, left to right: the seven band subnets (x 0), the windows and assembly (x 8 to 18), the colour chain (x 26), the FINAL MAPS column (x 40: height, base colour, normal, AO, roughness, opacity, then the VIEW switch). Network boxes named per column. FR : rangement du graphe."""
    for n in list(net.networkBoxes()): n.destroy()
    for k, sn in enumerate(bands): sn.setPosition(hou.Vector2(0, -3.2 * k))
    groups = {'T': (8, 4.0, 'WINDOWS AND HEIGHT ASSEMBLY'), 'O': (18, 3.0, 'OPACITY MASKS'), 'U': (26, 4.0, 'BASE COLOUR'), 'N': (34, 3.0, 'NORMAL AND AO'), 'R': (34, 3.0, 'ROUGHNESS')}
    col = {}
    for n in net.children():
        if n in bands or n.name().startswith('Band') or n.name() in [m.name() for m in maps.values()]: continue
        ch = n.name()[0]; x, dy, title = groups.get(ch, (14, 2.5, 'OTHER'))
        i = col.setdefault(ch, 0); col[ch] = i + 1; n.setPosition(hou.Vector2(x + 2.5 * (i // 28), -dy * 0.35 * (i % 28)))
    for j, nm in enumerate(('height', 'basecolor', 'normal', 'ao', 'roughness', 'opacity')): maps[nm].setPosition(hou.Vector2(44, -3.2 * j)); maps[nm].setColor(hou.Color((0.4, 0.75, 0.45)))
    maps['view'].setPosition(hou.Vector2(52, -8)); maps['view'].setColor(hou.Color((1.0, 0.75, 0.2)))
    for nm, (title, color, nodes) in {'bands': ('SEVEN BAND SUBNETS, ONE PER BAND', (0.5, 0.7, 1.0), bands), 'maps': ('FINAL MAPS: height, base colour, normal, AO, roughness, opacity (aligned) and the VIEW switch', (0.4, 0.85, 0.5), list(maps.values()))}.items():
        b = net.createNetworkBox(nm); b.setComment(title); b.setColor(hou.Color(color))
        for n in nodes: b.addNode(n)
        b.fitAroundContents()
def build(net, with_maps=True):
    ry = T.node(net, 'ramp', 'T00_ramp__down_y', signature='f1', rotation=90.0); rx3 = T.node(net, 'ramp', 'T01_ramp__three_cycles_x', signature='f1', cycles=3.0, method=1)
    EJ = {0: 0.0, 1: 0.016, 2: 0.008, 3: 0.008, 4: 0.008, 5: 0.008, 6: 0.008, 7: 0.0}     # half width of the cross fade at each junction (canvas): wide between the petal band and the outer petal band (Matthieu, 6 October 2026: soft transition between the two pinks)
    bands = []; wins = []
    for k, (a, b) in enumerate(EDGES):
        bands.append(T.node(net, 'channelextract', 'Band%d_mono' % k, [subnet_band(net, k)], channel=0))   # a subnet hands back RGBA
        up = T.smooth(net, 'T1%d_w%d_in' % (k, k), ry, a - EJ[k], a + EJ[k]) if k > 0 else T.const(net, 'T1%d_w%d_in' % (k, k), ry, 1.0)
        dn = T.smooth(net, 'T1%d_w%d_out' % (k, k), ry, b - EJ[k + 1], b + EJ[k + 1], 1.0, 0.0) if k < 6 else T.const(net, 'T1%d_w%d_out' % (k, k), ry, 1.0)
        wins.append(T.mix(net, 'T1%d_w%d' % (k, k), up, dn, 5))
    tot = None
    for k in range(7):
        bw = T.mix(net, 'T2%d_band%d_windowed' % (k, k), bands[k], wins[k], 5); tot = bw if tot is None else T.mix(net, 'T3%d_height_plus_band%d' % (k, k), tot, bw, 3)
    fin = T.node(net, 'null', 'FINAL_HEIGHT', [tot])
    if not with_maps: return dict(height=fin)
    pal = json.load(open(B + 'ref-maps/band_palettes.json')); rgb = None
    pal['5'] = [[0.0, 0.24, 0.43, 0.14], [0.38, 0.24, 0.43, 0.14], [0.43, 0.11, 0.28, 0.08], [0.52, 0.15, 0.36, 0.11], [0.60, 0.26, 0.48, 0.17], [0.72, 0.52, 0.70, 0.30], [1.0, 0.80, 0.88, 0.50]]      # 6 October 2026: leaf from ref 07 (ground 0.24 0.43 0.14 LIGHTER than the lens 0.15 0.35 0.11, rib and veins pale yellow green)
    pal['2'] = [[0.0, 0.18, 0.28, 0.07], [0.34, 0.22, 0.32, 0.09], [0.42, 0.45, 0.30, 0.07], [0.50, 0.78, 0.30, 0.05], [0.62, 0.93, 0.47, 0.07], [0.80, 0.98, 0.60, 0.12], [1.0, 1.0, 0.72, 0.22]]      # 6 October 2026: band 2 from the v2 reference: dark green ground, deep orange anthers (measured 0.95 0.5 0.1)
    for k in range(7):
        keys = [tuple(x) for x in pal[str(k)]]
        if keys[0][0] > 0.0: keys = [(0.0,) + keys[0][1:]] + keys
        if keys[-1][0] < 1.0: keys = keys + [(1.0,) + keys[-1][1:]]
        if k == 6:      # the creases are as low as the ground in height, so the bud is coloured with a LIGHT ramp and the dark ground comes from the bud mask
            lite = [kk for kk in keys if kk[0] >= 0.42]; keys = [(0.0,) + lite[0][1:]] + lite
        m = T.node(net, 'monotorgb', 'U1%d_colour_band%d' % (k, k), [bands[k]]); m.parm('ramp').set(color_ramp(keys))
        if k == 6:
            gmask = T.lin(net, 'U60_ground_mask', B6.opacity(net, ry, rx3), 0.0, 1.0, 1.0, 0.0)
            m = T.node(net, 'blend', 'U61_ground', [m, flat_colour(net, 'U61a_dark', ry, (0.62, 0.66, 0.40)), gmask], mode=0)
        if k == 2:
            ax = T.mix(net, 'U20_ax', T.lin(net, 'U20a_cx', rx3, 0.0, 1.0, -1.0 / 6, 1.0 / 6), T.const(net, 'U20b_zero', ry, 0.0), 9)
            lvb = T.lin(net, 'U21_lv_band2', ry, 0.388, 0.507, 0.0, 1.0)
            hb = T.node(net, 'blur', 'U22_height_soft', [bands[2]], units=1, size_pixel=3.0)
            obj = T.smooth(net, 'U23_object_mask', hb, 0.47, 0.52)
            green = T.mix(net, 'U24_filament_mask', obj, T.smooth(net, 'U24a_lower', lvb, 0.56, 0.66), 5)
            head = T.mix(net, 'U25_head_mask', T.lin(net, 'U25a_near_axis', T.smooth(net, 'U25b', ax, 0.032, 0.040), 0.0, 1.0, 1.0, 0.0), T.lin(net, 'U25c_top', T.smooth(net, 'U25d', lvb, 0.28, 0.34), 0.0, 1.0, 1.0, 0.0), 5)
            m = T.node(net, 'blend', 'U26_with_green', [m, flat_colour(net, 'U26a_green', ry, GREEN), green], mode=0)
            head = T.mix(net, 'U25e_head_on_object', head, obj, 5)       # the head colour only where the head really is (the tone says object), not a rectangle
            m = T.node(net, 'blend', 'U27_with_purple', [m, flat_colour(net, 'U27a_purple', ry, PURPLE), head], mode=0)
        if k == 0:
            lv0 = T.lin(net, 'U05_lv_band0', ry, 0.0, 0.193, 0.0, 1.0)
            m = T.node(net, 'blend', 'U06_pink_to_base', [m, flat_colour(net, 'U06a_pink', ry, (0.80, 0.50, 0.58)), T.lin(net, 'U06b_amount', T.smooth(net, 'U06c', lv0, 0.45, 1.0), 0.0, 1.0, 0.0, 0.55)], mode=0)   # the petal turns pink toward its base, where it meets the outer petal
        if k == 0:      # THREE PETALS, THREE PINKS (Matthieu, 6 October 2026): white pink, pink, deep fuchsia, with a deeper centre, a pale edge and dark speckles like the photo
            lv0, ax0, wb0, mb0 = B0.coords(net, ry, rx3); spk = B0.speckles(net, lv0, ax0, wb0, mb0, 'SC')
            rx1 = T.node(net, 'ramp', 'U80_ramp__one_cycle_x', signature='f1')
            # measured on the reference photo (05_photo_petal-colour-reference.webp): the OUTER EDGE of the petal is almost white, the colour is carried by the inside, saturated and deeper toward the centre. Palettes: edge white, body, deep, speckle.
            PET = [dict(edge=(0.97, 0.94, 0.93), body=(0.99, 0.78, 0.86), deep=(0.95, 0.56, 0.62), dot=(0.72, 0.08, 0.28)),      # pale pink (white pink lily)
                   dict(edge=(0.98, 0.94, 0.92), body=(0.98, 0.64, 0.76), deep=(0.95, 0.40, 0.58), dot=(0.62, 0.04, 0.22)),      # pink (top petal of the photo)
                   dict(edge=(0.98, 0.94, 0.93), body=(0.97, 0.62, 0.74), deep=(0.91, 0.42, 0.58), dot=(0.66, 0.06, 0.25), wash=(0.985, 0.88, 0.91))]      # WASHED pink: a variation of the middle pink, bleached in patches like the centre lily of the photo (Matthieu, 6 October 2026)
            d_sil = T.mix(net, 'U82_distance_to_edge', wb0, ax0, 4)
            d_top = T.lin(net, 'U82a_distance_to_top', lv0, 0.017, 1.017, 0.0, 0.193)
            d_in = T.mix(net, 'U82b_distance_inside', d_sil, d_top, 13)
            edge_amt = T.curve(net, 'U83_edge_white_amount', T.lin(net, 'U83a_scaled', d_in, 0.0, 0.12, 0.0, 1.0), [(0.0, 1.0), (0.04, 0.97), (0.08, 0.62), (0.14, 0.14), (0.20, 0.0), (1.0, 0.0)], 1.0, 0.0, 1.0, T.SMOOTH)      # 1 at the contour, white until 0.011 canvas, gone by 0.066
            deepmask = T.mix(net, 'U81_deep_mask', T.lin(net, 'U81a_near_axis', T.smooth(net, 'U81b', ax0, 0.0, 0.17), 0.0, 1.0, 1.0, 0.0), T.smooth(net, 'U81c_below_neck', lv0, 0.10, 0.70), 5)
            cols = None
            for i, pc in enumerate(PET):
                wi = T.mix(net, 'U9%d_petal_window' % i, T.smooth(net, 'U9%da_in' % i, rx1, i / 3.0 - 0.0006, i / 3.0 + 0.0006) if i > 0 else T.const(net, 'U9%da_in' % i, ry, 1.0), T.smooth(net, 'U9%db_out' % i, rx1, (i + 1) / 3.0 - 0.0006, (i + 1) / 3.0 + 0.0006, 1.0, 0.0) if i < 2 else T.const(net, 'U9%db_out' % i, ry, 1.0), 5)
                mi = flat_colour(net, 'U9%dc_body' % i, ry, pc['body'])
                mi = T.node(net, 'blend', 'U9%dd_deeper' % i, [mi, flat_colour(net, 'U9%de_deep' % i, ry, pc['deep']), T.lin(net, 'U9%df_amount' % i, deepmask, 0.0, 1.0, 0.0, 1.0)], mode=0)
                mi = T.node(net, 'blend', 'U9%dg_dots' % i, [mi, flat_colour(net, 'U9%dh_dot' % i, ry, pc['dot']), T.lin(net, 'U9%di_dotamount' % i, spk, 0.0, 1.0, 0.0, 1.0)], mode=0)
                mi = T.node(net, 'blend', 'U9%dl_white_edge' % i, [mi, flat_colour(net, 'U9%dm_edge' % i, ry, pc['edge']), edge_amt], mode=0)
                if 'wash' in pc:
                    wn = T.node(net, 'fractalnoise', 'U9%dn_wash_noise' % i, [lv0], amp=0.5, center=0.5, elementsize=0.16, noisetype=1, offx=3.7, tilesizex=2.0 / 3.0, oct=3)
                    wp = T.curve(net, 'U9%do_wash_patches' % i, wn, [(0.0, 0.0), (0.30, 0.0), (0.75, 1.0), (1.0, 1.0)], 1.0, 0.0, 1.0, T.SMOOTH)
                    mi = T.node(net, 'blend', 'U9%dp_washed' % i, [mi, flat_colour(net, 'U9%dq_wash' % i, ry, pc['wash']), T.lin(net, 'U9%dr_wash_amount' % i, wp, 0.0, 1.0, 0.0, 0.70)], mode=0)
                ci = T.mix(net, 'U9%dj_petal_colour' % i, mi, wi, 5); cols = ci if cols is None else T.mix(net, 'U9%dk_plus' % i, cols, ci, 3)
            hp = T.mix(net, 'U84_height_detail', bands[0], T.node(net, 'blur', 'U84a_height_soft', [bands[0]], units=1, size_pixel=14.0), 4)      # high pass of the height: fibres, rib, rim
            shade = T.lin(net, 'U85_shade', hp, -0.12, 0.12, 0.82, 1.12)
            m = T.mix(net, 'U86_colour_shaded', cols, shade, 5)
        if k == 1:      # GREEN CORE of the outer tepal (Matthieu, 6 October 2026): the dark central strip of each tepal is green, like the lily in the photo
            ax1 = T.mix(net, 'U30_ax1', T.lin(net, 'U30a_cx1', rx3, 0.0, 1.0, -1.0 / 6, 1.0 / 6), T.const(net, 'U30b_zero', ry, 0.0), 9)
            lv1 = T.lin(net, 'U31_lv_band1', ry, 0.193, 0.388, 0.0, 1.0)
            core1 = T.mix(net, 'U32_core_mask', T.lin(net, 'U32a_near_axis', T.smooth(net, 'U32b', ax1, 0.0, 0.075), 0.0, 1.0, 1.0, 0.0), T.smooth(net, 'U32c_from_top', lv1, 0.05, 0.12), 5)      # 6 October 2026: a wide GRADIENT, full green on the axis, fading into the pink
            gr = T.node(net, 'monotorgb', 'U33_green_ramp', [bands[1]]); gr.parm('ramp').set(color_ramp([(0.0, 0.20, 0.32, 0.10), (0.35, 0.40, 0.53, 0.22), (0.6, 0.62, 0.73, 0.40), (1.0, 0.86, 0.91, 0.70)]))      # green version of the band tone: the texture stays, the hue is green (no magenta left)
            m = T.node(net, 'blend', 'U34_with_green_core', [m, gr, core1], mode=0)
        if k == 6:      # GREEN CORE of the bud: the middle of each lobe is green
            inner = T.smooth(net, 'U35_bud_core_mask', T.node(net, 'blur', 'U35a_bud_soft', [B6.opacity(net, ry, rx3)], units=1, size_pixel=14.0), 0.55, 0.9)
            m = T.node(net, 'blend', 'U36_bud_green_core', [m, flat_colour(net, 'U36a_green', ry, (0.58, 0.68, 0.34)), T.lin(net, 'U36b_amount', inner, 0.0, 1.0, 0.0, 0.85)], mode=0)
        if k == 5:     # colour PADDING (the petals pad themselves: their own ramps already give the ground the petal colour): the part that opacity cuts away gets the colour of the object edge (no dark or pink halo at the cut)
            pad_rgb = (0.24, 0.43, 0.14)
            m = T.node(net, 'blend', 'U7%d_padding' % k, [m, flat_colour(net, 'U7%da_pad' % k, ry, pad_rgb), T.lin(net, 'U7%db_outside' % k, B56.leaf_opacity(net, ry, rx3), 0.0, 1.0, 1.0, 0.0)], mode=0)
        bw = T.mix(net, 'U3%d_colour%d_windowed' % (k, k), m, wins[k], 5); rgb = bw if rgb is None else T.mix(net, 'U4%d_colour_plus_band%d' % (k, k), rgb, bw, 3)
    base = T.node(net, 'null', 'BASECOLOR', [rgb])
    nrm = T.node(net, 'null', 'NORMAL', [T.node(net, 'heighttonormal', 'N10_normal', [fin], scale=2.2)])
    ao = T.node(net, 'null', 'AO', [T.lin(net, 'N21_ao_lifted', T.node(net, 'heighttoambientocclusion', 'N20_ao', [fin], heightscale=0.25, viewradius_pixel=16.0), 0.0, 1.0, 0.35, 1.0)])   # lifted: a trim AO should only darken crevices
    lvl = None
    for k in range(7):
        c = T.mix(net, 'R1%d_level_band%d' % (k, k), T.const(net, 'R0%d_const' % k, ry, ROUGH[k]), wins[k], 5); lvl = c if lvl is None else T.mix(net, 'R2%d_level_plus_band%d' % (k, k), lvl, c, 3)
