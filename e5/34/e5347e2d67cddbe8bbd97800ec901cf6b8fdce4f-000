def zone(net, tag, ax, lv, ax_keys, lv_keys, ax_rng, depth):
    """a 2D shading zone = curve across x (profile of |cx|) x curve along y (profile of lv) x depth (5 nodes with the add made by the caller)."""
    a = T.curve(net, '%s_across' % tag, ax, ax_keys, ax_rng); b = T.curve(net, '%s_along' % tag, lv, lv_keys, 1.0)
    z = T.mix(net, '%s_product' % tag, a, b, 5); return T.lin(net, '%s_depth' % tag, z, 0.0, 1.0, 0.0, depth)
