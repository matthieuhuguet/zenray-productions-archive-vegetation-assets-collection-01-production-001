P = dict(ground=0.55, big_base=0.64, big_dome=0.14, small_base=0.50, small_dome=0.14, vein_count=26.0, vein_depth=0.035, vein_pow=0.6, svein_count=34.0, svein_depth=0.025, fan_origin=1.02, fan_slope=0.9)
MAX_IT = 99   # build only the first MAX_IT iterations, to save one screen per iteration
def build(net, res_label='A'):
    prof = json.load(open(B + 'ref-maps/band0_profile.json')); L = lambda n: n   # names are prefixed by the band letter below
    # 5 October 2026 : the cell coordinates come from two Ramp nodes, NOT from the Tile Pattern UV output: that output has an anti-aliased pixel at every tile boundary (u = 0 there) which printed a one pixel bright line in the middle of the boundary petals (found on the 1024 export, pixel 341). A Ramp with 3 repeating cycles is an exact sawtooth.
    rx = T.node(net, 'ramp', 'A00_ramp__three_cycles_x', signature='f1', cycles=3.0, method=1); ry = T.node(net, 'ramp', 'A01_ramp__down_y', signature='f1', rotation=90.0)
    lv = T.lin(net, 'A03_band__lv_0_top_1_bottom', ry, 0.0, BAND_V1)
    cx = T.lin(net, 'A04_cell__cx_centre', rx, 0.0, 1.0, -1.0 / 6, 1.0 / 6)    # canvas fraction: a cell is 1/3 of the width
    zero = T.const(net, 'A05_const__zero', lv, 0.0)
    ax = T.mix(net, 'A06_cell__abs_cx', cx, zero, 9)
    half = T.const(net, 'A07_const__half_cell', lv, 1.0 / 6)
    ds = T.mix(net, 'A08_cell__dist_to_boundary', half, ax, 4)
    # widths from the measured profile
    wb = T.curve(net, 'B01_big__halfwidth_curve', lv, [(x, y / 0.25) for x, y in zip(prof['lv'], prof['big'])], 1.0, 0.0, 0.25, T.SMOOTH)
    # the boundary petal is ONE tilted petal, not a mirrored pair (reference occupancy, 5 October 2026): signed x from the cell boundary, its left and right edges against lv, its axis and half width, and ds = distance to ITS axis
    sg = T.lin(net, 'A09_cell__side_sign', cx, -0.0005, 0.0005, 1.0, -1.0); xb = T.mix(net, 'A10_cell__signed_x_from_boundary', sg, ds, 5)
    LK = [(0.0, 0.004), (0.013, 0.000), (0.023, -0.008), (0.063, -0.023), (0.165, -0.038), (0.29, -0.049), (0.36, -0.054), (0.40, -0.064), (0.45, -0.085), (0.55, -0.13), (0.65, -0.17), (1.0, -0.17)]   # left edge of the back petal, one smooth arc measured on the 2x zoom (5 October 2026)
    RK = [(0.0, 0.015), (0.02, 0.030), (0.05, 0.043), (0.09, 0.047), (0.146, 0.046), (0.228, 0.043), (0.316, 0.040), (0.37, 0.046), (0.42, 0.062), (0.50, 0.10), (0.60, 0.17), (1.0, 0.17)]   # right edge of the back petal: a plain rounded tip, NO rolled tip (Matthieu, 5 October 2026: a curl makes no sense on a flat texture)
    eL = T.curve(net, 'B02a_small__left_edge', lv, [(x, (y + 0.25) / 0.5) for x, y in LK], 1.0, -0.25, 0.25, T.SMOOTH); eR = T.curve(net, 'B02b_small__right_edge', lv, [(x, (y + 0.25) / 0.5) for x, y in RK], 1.0, -0.25, 0.25, T.SMOOTH)
    half_c = T.const(net, 'B02c_const__half', lv, 0.5)
    axis = T.mix(net, 'B02d_small__axis', T.mix(net, 'B02e_small__edges_sum', eL, eR, 3), half_c, 5)
    ws = T.mix(net, 'B02_small__halfwidth', T.mix(net, 'B02f_small__span', eR, eL, 4), half_c, 5)
    ds = T.mix(net, 'B02g_small__dist_to_axis', T.mix(net, 'B02h_small__signed_dist_to_axis', xb, axis, 4), zero, 9)
    mb_raw = T.mix(net, 'B03_big__edge_distance', wb, ax, 4); mb = T.smooth(net, 'B04_big__mask', mb_raw, -MASK_EDGE, MASK_EDGE)
    ms_raw = T.mix(net, 'B05_small__edge_distance', ws, ds, 4); ms = T.mix(net, 'B06b_small__with_top', T.smooth(net, 'B06_small__mask', ms_raw, -MASK_EDGE, MASK_EDGE), T.smooth(net, 'B06a_small__top_plateau', lv, 0.013, 0.021), 5)   # the back petal does not run into the band top: its rounded top sits at lv 0.017 (reference 4x zoom), ground above
    # big petal relief: dome across the petal and a fan of veins converging at the bottom centre
    tb = T.mix(net, 'C01_big__across_ratio', ax, wb, 6); tb2 = T.mix(net, 'C02_big__across_squared', tb, tb, 5)
    dome = T.lin(net, 'C03_big__dome', tb2, 0.0, 1.0, 1.0, 0.0)
    h_dome = T.lin(net, 'C04_big__dome_height', dome, 0.0, 1.0, P['big_base'], P['big_base'] + P['big_dome'])
    fan = T.curve(net, 'C05_fan__origin_distance', lv, [(0.0, 1.0), (1.0, 1.0 - 0.9 * P['fan_slope'] / 1.02)], 1.0, 0.0, P['fan_origin'])
    f = T.mix(net, 'C06_fan__tangent', cx, fan, 6)
    ph_noise = T.node(net, 'fractalnoise', 'C07_fan__phase_noise', [lv], amp=0.5, center=0.0, elementsize=0.05)
    def veins(tag, count, depth, power, wob):
        k = T.mix(net, 'C%s_fan__phase_%d' % (tag, count), f, T.const(net, 'C%sa_const__count_%d' % (tag, count), lv, count), 5)
        k2 = T.mix(net, 'C%s_fan__phase_wobbled_%d' % (tag, count), k, T.mix(net, 'C%sb_fan__wobble_%d' % (tag, count), ph_noise, T.const(net, 'C%sc_const__wob_%d' % (tag, count), lv, wob), 5), 3)
        sn = T.node(net, 'function', 'C%s_fan__sin_%d' % (tag, count), [k2], func=2, func_trig=0, angleunit=2)
        ab = T.node(net, 'function', 'C%s_fan__abs_%d' % (tag, count), [sn], func=0, func_math=0)
        pw = T.node(net, 'function', 'C%s_fan__pow_%d' % (tag, count), [ab], func=1, func_pow=1)
        if pw.parm('exponent'): pw.parm('exponent').set(power)
        return T.lin(net, 'C%s_fan__relief_%d' % (tag, count), pw, 0.0, 1.0, -depth, depth)
    v1 = veins('08', 46, 0.020, 0.7, 2.0); v2 = veins('09', 120, 0.006, 0.9, 3.0)
    vein = T.mix(net, 'C10_fan__veins_sum', v1, v2, 3)
    # central rib: bright flanks and a thin dark groove on the axis of the big petal
    rib = T.curve(net, 'C10a_rib__profile_across', ax, [(0.0, 0.2), (0.003, 0.0), (0.008, 0.55), (0.02, 1.0), (0.06, 0.6), (0.17, 0.5)], 0.17, -0.06, 0.06)
    vein = T.mix(net, 'C10b_fan__veins_and_rib', vein, rib, 3)
    h_big = T.mix(net, 'C12_big__height', h_dome, vein, 3)
    # small petal relief: dome and parallel veins
    ts = T.mix(net, 'D01_small__across_ratio', ds, ws, 6); ts2 = T.mix(net, 'D02_small__across_squared', ts, ts, 5)
    sdome = T.lin(net, 'D03_small__dome', ts2, 0.0, 1.0, 1.0, 0.0)
    h_sd = T.lin(net, 'D04_small__dome_height', sdome, 0.0, 1.0, P['small_base'], P['small_base'] + P['small_dome'])
    sk = T.mix(net, 'D05_small__vein_phase', ds, T.const(net, 'D05a_const__svein_count', lv, P['svein_count']), 5)
    ssn = T.node(net, 'function', 'D06_small__sin', [sk], func=2, func_trig=0, angleunit=2); sab = T.node(net, 'function', 'D07_small__abs', [ssn], func=0, func_math=0)
    svein = T.lin(net, 'D08_small__vein_relief', sab, 0.0, 1.0, -P['svein_depth'], P['svein_depth'])
    h_small = T.mix(net, 'D09_small__height', h_sd, svein, 3)
    msv = T.node(net, 'clamp', 'B08_small__visible_mask_clamped', [T.mix(net, 'B07_small__visible_mask', ms, mb, 4)])   # the small petal is only seen where the big one is not in front
    # shoulder line: the edge of the big petal casts a thin dark line on the petal; ground gets a fine noise
    rim_d = T.curve(net, 'C13_big__rim_profile', T.lin(net, 'C13a_big__inside_distance', mb_raw, 0.0, 0.03), [(0.0, 0.0), (0.04, 1.0), (0.2, 0.2), (1.0, 0.0)], 1.0, 0.0, 1.0)
    rim = T.mix(net, 'C14_big__rim_darkening', rim_d, T.const(net, 'C14a_const__rim_strength', lv, -0.12), 5)
    h_big = T.mix(net, 'C15_big__height_with_rim', h_big, rim, 4)
    gn = T.node(net, 'fractalnoise', 'E00_ground__noise', [lv], amp=0.04, center=0.0, elementsize=0.02)
    # composition: ground, small petal behind, big petal in front (lerp = a + m * (b - a))
    g0 = T.const(net, 'E01_ground__level', lv, P['ground']); g = T.mix(net, 'E01b_ground__with_noise', g0, gn, 3)
    a = T.mix(net, 'E02_small__minus_ground', h_small, g, 4); a2 = T.mix(net, 'E03_small__times_mask', a, ms, 5); layer1 = T.mix(net, 'E04_layer__ground_small', g, a2, 3)
    b = T.mix(net, 'E05_big__minus_layer', h_big, layer1, 4); b2 = T.mix(net, 'E06_big__times_mask', b, mb, 5); out = T.mix(net, 'E07_band0__height', layer1, b2, 3)
    ctx = dict(eL=eL, eR=eR, xb=xb, lv=lv, cx=cx, ax=ax, ds=ds, mb=mb, ms=ms, mb_raw=mb_raw, ms_raw=ms_raw, wb=wb, ws=ws, f=f, ph_noise=ph_noise, msv=msv)
    if MAX_IT >= 1: out = iteration1(net, out, ctx)
    if MAX_IT >= 2: out = iteration2(net, out, ctx)
    if MAX_IT >= 3: out = iteration3(net, out, ctx)
    if MAX_IT >= 4: out = iteration4(net, out, ctx)
    if MAX_IT >= 5: out = iteration5(net, out, ctx)
    if MAX_IT >= 6: out = iteration6(net, out, ctx)
    if MAX_IT >= 7: out = iteration7(net, out, ctx)
    if MAX_IT >= 8: out = iteration8(net, out, ctx)
    if MAX_IT >= 9: out = iteration9(net, out, ctx)
    tone = T.curve(net, 'F01_band0__tonal_range', out, [(0.0, 0.02), (0.30, 0.19), (0.50, 0.38), (0.66, 0.58), (0.80, 0.76), (1.0, 0.94)], 1.0)
    prune(net, PRUNE_BY_ABLATION, tone)
    return tone

# 5 October 2026 : OPTIMISATION step. Layers listed here were measured by Ablate.py (iterations 1 to 6): either they change nothing (dmean < 1 grey level, no detail energy, no structure gain) or they make the blurred structure error to the reference WORSE (removing them lowers it). prune() rewires the consumers of a listed layer to its base input and then destroys every node that no longer feeds the output (dead code elimination), so the graph shrinks without the 64 node creation asserts changing.
PRUNE_BY_ABLATION = ['I01j_small__fan_added', 'M22_small_fibre_added', 'K14_neck_shadow_subtracted', 'K23_crease_ridge_added', 'L52_shoulder_fibre_added', 'L53_shoulder_fibre_added', 'J21_small_fibre_added', 'J22_small_fibre_added', 'J23_small_fibre_added',
                     'K42_dome_gradient_added', 'L23_ground_darkening_subtracted', 'K32_small_darkening_subtracted', 'I06c_big__axis_brightening_added', 'N21_wings__darkening_added', 'I05c_big__bottom_darkening_added', 'K16_corner_shadow_subtracted',
                     'M21_small_fibre_added', 'Q31_small_bold_fibre_added', 'R41_small_bold_fibre_added', 'R42_small_bold_fibre_added', 'R33_small_rib__added', 'Q02_small_petal_rim_added', 'R11_curl__added', 'I09d_small__tip_rim_added']   # the last eight: the back petal is rebuilt by iteration 9 after Matthieu's feedback (5 October 2026)
def prune(net, names, keep):
    names = list(names) + [c.name() for c in net.children() if re.match(r'^[MNQRS]9\d', c.name())]   # the padding nodes that only fill an iteration up to 64 nodes do nothing: they go too
    for nm in names:
        n = net.node(nm)
        if n is None: continue
        src = n.input(0)
        for c in n.outputs():
            for i, inp in enumerate(c.inputs()):
                if inp is not None and inp.path() == n.path(): c.setInput(i, src)
        n.destroy()
    changed = True
    while changed:
        changed = False
        for c in list(net.children()):
            if c.path() == keep.path() or c.type().name() == 'rop_image' or c.outputs(): continue
            c.destroy(); changed = True

def noise_layer(net, tag, base, ref, mask, amp, size, sx, sy, seed, ntype=1):
    """one detail layer = fractal noise (1 node) x mask (1 node, optional) added to the running height (1 node)."""
    n = T.node(net, 'fractalnoise', '%s_noise' % tag, [ref], amp=amp, center=0.0, elementsize=size, noisetype=ntype); n.parm('elementscalex').set(sx); n.parm('elementscaley').set(sy); n.parm('offx').set(seed)
    m = T.mix(net, '%s_masked' % tag, n, mask, 5) if mask is not None else n
    return T.mix(net, '%s_added' % tag, base, m, 3)
REMOVED_BY_ABLATION = ('I02', 'I03', 'I04', 'I08', 'I10', 'I11')   # measured 5 October 2026 by Ablate.py: vertically stretched fibres, white grain, crease and ground noise change the band by less than 1 grey level
def iteration1(net, h, c, optimized=True):
    """ITERATION 1 of band 0: exactly 64 nodes of detail (5 October 2026): small petal fan veins from the boundary point, fibres along the petals, fine grain, tonal gradients, crease shadow on the small petal side, curled tip, textured ground."""
    lv, ax, ds, mb, ms, mb_raw, ms_raw = c['lv'], c['ax'], c['ds'], c['mb'], c['ms'], c['mb_raw'], c['ms_raw']
    n0 = len(net.children()); box = net.createNetworkBox('Iteration_01'); box.setComment('BAND 0 ITERATION 1 : 64 nodes'); box.setColor(hou.Color((0.6, 0.8, 1.0)))
    # 1. small petal veins fan out from the bottom boundary point (10 nodes)
    fan_s = T.curve(net, 'I01a_small__fan_origin_distance', lv, [(0.0, 1.0), (1.0, 0.12 / 1.12)], 1.0, 0.0, 1.12)
    g = T.mix(net, 'I01b_small__fan_tangent', ds, fan_s, 6)
    c['g'] = g
    gk = T.mix(net, 'I01c_small__fan_phase', g, T.const(net, 'I01d_const__small_vein_count', lv, 30.0), 5)
    sn = T.node(net, 'function', 'I01e_small__fan_sin', [gk], func=2, func_trig=0, angleunit=2); ab = T.node(net, 'function', 'I01f_small__fan_abs', [sn], func=0, func_math=0)
    pw = T.node(net, 'function', 'I01g_small__fan_pow', [ab], func=1, func_pow=1)
    if pw.parm('exponent'): pw.parm('exponent').set(0.7)
    rel = T.lin(net, 'I01h_small__fan_relief', pw, 0.0, 1.0, -0.022, 0.022); relm = T.mix(net, 'I01i_small__fan_masked', rel, c['msv'], 5)
    h = T.mix(net, 'I01j_small__fan_added', h, relm, 3)
    # 2. fibres along the petals, stretched noise (big 3 layers, small 2 layers) = 15 nodes
    for k, (size, amp, sx, sy) in enumerate([] if optimized else [(0.010, 0.05, 0.12, 1.0), (0.006, 0.035, 0.10, 1.0), (0.003, 0.025, 0.08, 1.0)]): h = noise_layer(net, 'I02%s_big_fibre' % 'abc'[k], h, lv, mb, amp, size, sx, sy, 3.1 * (k + 1))
    for k, (size, amp, sx, sy) in enumerate([] if optimized else [(0.008, 0.045, 0.12, 1.0), (0.004, 0.03, 0.10, 1.0)]): h = noise_layer(net, 'I03%s_small_fibre' % 'ab'[k], h, lv, ms, amp, size, sx, sy, 7.7 * (k + 1))
    # 3. fine grain over everything, white noise (3 layers = 9 nodes)
    for k, (size, amp) in enumerate([] if optimized else [(0.004, 0.03), (0.002, 0.022), (0.001, 0.016)]): h = noise_layer(net, 'I04%s_grain' % 'abc'[k], h, lv, None, amp, size, 1.0, 1.0, 11.3 * (k + 1), 4) if False else noise_layer(net, 'I04%s_grain' % 'abc'[k], h, lv, mb, amp, size, 1.0, 1.0, 11.3 * (k + 1), 4)
    # 4. tonal gradients (9 nodes): darker towards the bottom corners, brighter on the axis, brighter small petals near the top
    dark = T.curve(net, 'I05a_big__bottom_darkening_profile', lv, [(0.0, 0.0), (0.6, 0.15), (1.0, 1.0)], 1.0, 0.0, -0.07); darkm = T.mix(net, 'I05b_big__bottom_darkening_masked', dark, mb, 5); h = T.mix(net, 'I05c_big__bottom_darkening_added', h, darkm, 3)
    axis = T.curve(net, 'I06a_big__axis_brightening_profile', c['ax'], [(0.0, 1.0), (0.05, 0.6), (0.17, 0.0)], 0.17, 0.0, 0.05); axm = T.mix(net, 'I06b_big__axis_brightening_masked', axis, mb, 5); h = T.mix(net, 'I06c_big__axis_brightening_added', h, axm, 3)
    top = T.curve(net, 'I07a_small__top_brightening_profile', lv, [(0.0, 1.0), (0.4, 0.2), (1.0, 0.0)], 1.0, 0.0, 0.06); topm = T.mix(net, 'I07b_small__top_brightening_masked', top, ms, 5); h = T.mix(net, 'I07c_small__top_brightening_added', h, topm, 3)
    # 5. crease shadow just outside the big petal edge, on the small petal (4 nodes) and curled tip highlight (5 nodes)
    if not optimized:
        crease = T.curve(net, 'I08a_small__crease_profile', T.lin(net, 'I08b_small__outside_distance', mb_raw, 0.0, -0.02), [(0.0, 0.0), (0.08, 1.0), (0.5, 0.4), (1.0, 0.0)], 1.0, 0.0, -0.08)
        h = T.mix(net, 'I08c_small__crease_added', h, T.mix(net, 'I08d_small__crease_masked', crease, ms, 5), 3)
    tip_rim = T.curve(net, 'I09a_small__tip_rim_profile', T.lin(net, 'I09b_small__inside_distance', ms_raw, 0.0, 0.02), [(0.0, 1.0), (0.12, 0.5), (1.0, 0.0)], 1.0, 0.0, 0.07)
    tip_gate = T.curve(net, 'I09c_small__tip_rim_height_gate', lv, [(0.0, 1.0), (0.2, 0.8), (0.4, 0.0), (1.0, 0.0)], 1.0)
    h = T.mix(net, 'I09d_small__tip_rim_added', h, T.mix(net, 'I09e_small__tip_rim_gated', tip_rim, tip_gate, 5), 3)
    # 6. ground: texture on the dark ground between the petals (2 layers + mask = 8 nodes)
    if not optimized:
      one = T.const(net, 'I10b_const__one', lv, 1.0); nb = T.mix(net, 'I10a_ground__not_big', one, mb, 4); ground = T.mix(net, 'I10c_ground__mask', nb, T.mix(net, 'I10d_ground__not_small', one, ms, 4), 5)
    for k, (size, amp) in enumerate([] if optimized else [(0.03, 0.10), (0.008, 0.06)]): h = noise_layer(net, 'I10%s_ground_noise' % 'fg'[k], h, lv, ground, amp, size, 1.0, 1.0, 5.5 * (k + 1))
    made = len(net.children()) - n0
    if optimized: return finish_it1(net, h, box, n0)
    # pad or report: the iteration must hold exactly 64 nodes
    k = 0
    while made < 64 and not optimized:
        k += 1; h = noise_layer(net, 'I11%s_extra_grain' % chr(96 + k), h, lv, None, 0.004, 0.0015 * k, 1.0, 1.0, 13.7 * k, 4); made = len(net.children()) - n0
    assert optimized or made == 64, 'iteration 1 holds %d nodes, expected 64' % made
    for n in net.children():
        if n.name().startswith('I'): box.addNode(n)
    box.fitAroundContents()
    return h

def finish_it1(net, h, box, n0):
    for n in net.children():
        if n.name().startswith('I'): box.addNode(n)
    box.fitAroundContents(); return h
def veins_layer(net, tag, base, coord, count, wob_noise, wob_const, wob, depth, power, mask, lv):
    """one ORIENTED fibre layer = veins along a fan coordinate with a wobbled phase (10 nodes)."""
    k = T.mix(net, '%s_phase' % tag, coord, T.const(net, '%s_count' % tag, lv, count), 5)
    wc_ = wob_const.get(wob) or wob_const.setdefault(wob, T.const(net, 'J00_const__wobble_%g' % wob, lv, wob * WOBBLE_SCALE))   # one shared constant per wobble strength
    w = T.mix(net, '%s_wobble' % tag, wob_noise, wc_, 5)
    kw = T.mix(net, '%s_phase_wobbled' % tag, k, w, 3)
    sn = T.node(net, 'function', '%s_sin' % tag, [kw], func=2, func_trig=0, angleunit=2); ab = T.node(net, 'function', '%s_abs' % tag, [sn], func=0, func_math=0)
    pw = T.node(net, 'function', '%s_pow' % tag, [ab], func=1, func_pow=1)
    if pw.parm('exponent'): pw.parm('exponent').set(power)
    rel = T.lin(net, '%s_relief' % tag, pw, 0.0, 1.0, -depth, depth); m = T.mix(net, '%s_masked' % tag, rel, mask, 5)
    return T.mix(net, '%s_added' % tag, base, m, 3)
