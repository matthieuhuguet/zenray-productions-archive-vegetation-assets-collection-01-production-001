# rib: median tone vs |dx| px (0..21), rows 40..230
sel = np.zeros((H, 1254), bool); sel[40:230] = True; dxa = np.abs(np.arange(1254) % W - W // 2)[None, :].repeat(H, 0)
out['rib_px'] = [round(float(np.median(a[sel & ina & (dxa == k)])), 3) for k in range(0, 26)]
# rib, row dependent: the centre line is an ABSOLUTE tone (~0.80) whatever the vault is, the ridge and groove beside it are small RELATIVE deltas. weight w(dx) = (tone - base) / (centre - base) over the three lower row groups; rel(dx) = tone - base, averaged over all four groups, for dx >= 4 (base = mean tone for dx 22..25)
w = np.zeros(26); rel = np.zeros(26); ng = 0
for (r0, r1) in [(8, 50), (50, 100), (100, 150), (150, 232)]:
    s_ = np.zeros((H, 1254), bool); s_[r0:r1] = True
    tn = np.array([np.median(a[s_ & ina & (dxa == k)]) for k in range(26)]); base = tn[22:26].mean(); centre = tn[0:2].mean()
    rel += tn - base; ng += 1
    if r0 >= 50: w += np.clip((tn - base) / max(centre - base, 0.05), 0, 1) * 1.0 / 3
out['rib_centre_abs'] = round(float(np.median(a[sel & ina & (dxa <= 1)])), 3)
out['rib_weight'] = [round(float(v), 3) for v in w]
out['rib_rel'] = [round(float(v / ng), 3) if k >= 4 else 0.0 for k, v in enumerate(rel)]
