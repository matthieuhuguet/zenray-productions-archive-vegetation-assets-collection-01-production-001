import unreal, json
B = '/Users/zenray/Create/Build/Productions/ZenRayHoudini/VegetationCollection01/'
P = json.load(open(B + 'unreal/lily_params.json')); J = json.load(open(B + 'unreal/render_job_lily.json'))
