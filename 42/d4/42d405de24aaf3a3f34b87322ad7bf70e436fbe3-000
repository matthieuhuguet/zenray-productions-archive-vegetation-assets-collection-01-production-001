# 5 October 2026 : STAGE FACTORY of the lily trim sheet height. Every band is a chain of exactly 64 small wrangle COPs (phase 1 of the two phase rule: explore with many nodes, optimise later). A stage adds ONE layer to the running height h of the band: a shape, a relief, one vein, one fibre noise, a grain, an edge, a curve. The shapes and numbers come from the measurements of the reference (MeasureTrimBands.py, TrimLab.py); no image is read. Every pattern is periodic in u, so the sheet is seamless by construction. FR : fabrique des 64 etages par bande.
import random, math
HEAD = '''#define PI 3.14159265
float sm(float a; float b; float x) { float t = clamp((x - a) / (b - a), 0.0, 1.0); return t * t * (3.0 - 2.0 * t); }
float pn(float x; float y; float z; float kx) { return 0.5 + 0.5 * pnoise(set(x * kx, y, z), set(kx, 1000.0, 1000.0)); }
float fr(float x) { return x - floor(x); }
float wrapd(float a; float b) { float d = abs(a - b); return min(d, 1.0 - d); }
float u = 0.5 + 0.5 * @P.x; float vt = 0.5 - 0.5 * @P.y;
float V0[] = {%(v0)s}; float V1[] = {%(v1)s};
int band = 0; for (int i = 0; i < 7; i++) if (vt >= V0[i] && vt < V1[i] + 0.0001) band = i;
float lv = clamp((vt - V0[band]) / (V1[band] - V0[band]), 0.0, 1.0);
int on = (band == %(bid)d);
float h = p@C.x; if (!on) h = 0.0;   // outside its band a chain outputs zero (the canvas colour is not trusted)
'''
PRELUDE = {
 0: '''float cx = fr(u * 3.0) - 0.5; float g = 0.30;
float wb = chf("../a_neck") + (0.5 - chf("../a_neck")) * sm(0.08, 0.9, lv); float mb = 1.0 - sm(wb - 0.012, wb + 0.012, abs(cx)); float tb = abs(cx) / max(wb, 0.01);
float cs = 0.5 - abs(cx); float ws = chf("../a_small_w") * pow(sin(PI * clamp(0.03 + 0.94 * lv, 0.0, 1.0)), 0.75); float ms = 1.0 - sm(ws - 0.012, ws + 0.012, cs);
float ang = atan2(cx, 1.35 - lv * 0.95); float tS = cs / max(ws, 0.01);''',
 1: '''float cx = fr(u * 3.0) - 0.5; int cell = int(floor(u * 3.0));
float ww = 0.50 * pow(1.0 - lv * 0.97, 0.9) + 0.045; float inW = 1.0 - sm(ww - 0.012, ww + 0.012, abs(cx)); float t = cx / ww; float at = abs(t);
float bgm = 1.0 - inW;''',
 2: '''float s = fr(u * 3.0); float AX[] = {0.06, 0.18, 0.55, 0.70, 0.86}; float FX[] = {0.27, 0.45, 0.97};''',
 3: '''float s = fr(u * 7.0); float cx = s - 0.5; float fan = 0.10 + 0.40 * pow(1.0 - clamp(lv / 0.72, 0.0, 1.0), 1.7) * chf("../d_fan");
float w = lv < 0.72 ? fan : 0.125; float inW = 1.0 - sm(w - 0.012, w + 0.012, abs(cx)); float t = cx / max(w, 0.02); float bgm = 1.0 - inW;''',
 4: '''float edge = 1.0 - abs(2.0 * lv - 1.0);''',
 5: '''float s = fr(u * 2.0 + 0.5); float w = chf("../f_width") * pow(sin(PI * clamp(s, 0.0, 1.0)), 0.7) * (1.0 + chf("../f_wave") * sin(s * PI * 14.0));
float y = abs(lv - 0.5); float inW = 1.0 - sm(w - 0.012, w + 0.012, y); float t = y / max(w, 0.02);''',
 6: '''float s = fr(u * 3.0); float w = chf("../g_width") * pow(sin(PI * clamp(s, 0.0, 1.0)), 0.85); float y = lv - 0.5; float inW = 1.0 - sm(w - 0.012, w + 0.012, abs(y)); float t = y / max(w, 0.02);''',
}
def lines(rnd, n, mask, coord, f0, f1, a0, a1, power=0.6, tag='line'):
    out = []
    for k in range(n):
        f = rnd.uniform(f0, f1); a = rnd.uniform(a0, a1); ph = rnd.uniform(0, 6.28)
        out.append(('%s_%02d' % (tag, k + 1), 'h += %.4f * (pow(abs(sin((%s) * %.2f + %.2f)), %.2f) - 0.5) * (%s);' % (a, coord, f, ph, power, mask)))
    return out
def noises(rnd, n, mask, kx0, kx1, ky0, ky1, a0, a1, tag='noise', coordv='vt'):
    out = []
    for k in range(n):
        kx = int(rnd.uniform(kx0, kx1)); ky = rnd.uniform(ky0, ky1); a = rnd.uniform(a0, a1)
        out.append(('%s_%02d' % (tag, k + 1), 'h += %.4f * (pn(u, %s * %.1f, %.2f, %d.0) - 0.5) * (%s);' % (a, coordv, ky, rnd.uniform(0, 50), kx, mask)))
    return out
def finish(extra_mask='1.0'):
    return [('contrast_soft', 'h = 0.5 + (h - 0.5) * 1.04;'), ('contrast_mid', 'h = lerp(h, smooth(0.0, 1.0, h), 0.15);'), ('clamp_floor', 'h = max(h, 0.02);'), ('clamp_ceiling', 'h = min(h, 0.98);')]
def stages(band):
    r = random.Random(100 + band); S = []
    if band == 0:
        S += [('ground', 'h = g + 0.012 * (pn(u, vt * 90.0, 1.1, 96.0) - 0.5);'), ('ground_shade', 'h += 0.05 * abs(cx) * (1.0 - lv);'), ('big_fill', 'h = lerp(h, 0.60, mb);'), ('big_dome', 'h += 0.10 * (1.0 - tb * tb) * mb;'),
              ('big_rim', 'h += 0.05 * (1.0 - sm(0.0, 0.04, wb - abs(cx))) * mb;'), ('big_midrib', 'h -= 0.08 * exp(-pow(cx / 0.010, 2.0)) * mb;'), ('big_midrib_flank', 'h += 0.025 * exp(-pow((abs(cx) - 0.03) / 0.012, 2.0)) * mb;'),
              ('small_fill', 'h = lerp(h, 0.70 + 0.10 * tS, ms * (1.0 - mb));'), ('small_curl_rim', 'h += 0.08 * exp(-pow((cs - ws * 0.95) / 0.015, 2.0)) * ms;')]
        S += lines(r, 15, 'mb', 'ang', 24, 72, 0.006, 0.020, 0.6, 'big_vein')
        S += lines(r, 8, 'ms', 'cs * 1.0 + lv * 0.08', 40, 130, 0.006, 0.016, 0.7, 'small_vein')
        S += noises(r, 8, 'mb', 60, 300, 200, 800, 0.004, 0.012, 'fibre')
        S += noises(r, 8, '1.0', 150, 500, 150, 500, 0.002, 0.006, 'grain')
        S += [('fold_1', 'h += 0.03 * sin(cx * 5.0 + lv * 2.0) * mb;'), ('fold_2', 'h += 0.02 * sin(cx * 9.0 - lv * 3.0) * mb;'), ('fold_3', 'h += 0.015 * sin(lv * 11.0 + cx * 3.0) * ms;'), ('fold_4', 'h -= 0.02 * (1.0 - tb) * lv * mb;')]
        S += [('gap_dark_1', 'h -= 0.04 * (1.0 - mb) * (1.0 - ms) * lv;'), ('gap_dark_2', 'h -= 0.02 * (1.0 - mb) * (1.0 - ms) * (1.0 - lv);'), ('overlap_shadow', 'h -= 0.05 * exp(-pow((abs(cx) - wb) / 0.02, 2.0)) * (1.0 - mb);'), ('petal_tip_curl', 'h += 0.04 * exp(-pow(lv / 0.04, 2.0)) * mb;')]
        S += [('cavity_1', 'h -= 0.03 * clamp(0.65 - h, 0.0, 1.0) * mb;'), ('cavity_2', 'h -= 0.02 * clamp(0.75 - h, 0.0, 1.0) * ms;'), ('base_pinch', 'h -= 0.05 * sm(0.85, 1.0, lv) * mb;'), ('base_soften', 'h = lerp(h, 0.5, 0.15 * sm(0.9, 1.0, lv));')]
    elif band == 1:
        S += [('ground', 'h = 0.27 + 0.07 * abs(cx) + 0.015 * pn(u, vt * 40.0, 3.3, 60.0);'), ('arch_shade', 'h -= 0.05 * exp(-pow(cx / 0.18, 2.0)) * (1.0 - lv) * bgm;'), ('wedge_fill', 'h = lerp(h, 0.58, inW);'),
              ('wedge_dome', 'h += 0.05 * (1.0 - at) * inW;'), ('wedge_center_ridge', 'h += 0.06 * exp(-pow(t / 0.06, 2.0)) * inW;'), ('stripe_left_right', 'h -= 0.22 * exp(-pow((at - 0.45) / 0.14, 2.0)) * (cell != 1 ? 1.0 : 0.0) * chf("../b_stripe") * inW;'),
              ('wedge_rim', 'h += 0.05 * (1.0 - sm(0.0, 0.08, 1.0 - at)) * inW;')]
        S += lines(r, 16, 'inW', 't', 8, 40, 0.008, 0.030, 0.8, 'ridge')
        S += lines(r, 8, 'inW * (cell != 1 ? 1.0 : 0.0)', 't', 30, 90, 0.006, 0.016, 0.6, 'stripe_fibre')
        S += noises(r, 8, 'inW', 60, 200, 100, 400, 0.004, 0.012, 'fibre')
        S += noises(r, 8, 'bgm', 40, 120, 20, 60, 0.004, 0.010, 'gap_grain')
        S += noises(r, 5, '1.0', 150, 500, 150, 500, 0.002, 0.005, 'grain')
        S += [('base_taper_dark', 'h -= 0.06 * sm(0.8, 1.0, lv) * inW;'), ('gap_base_dark', 'h -= 0.05 * sm(0.5, 1.0, lv) * bgm;'), ('wedge_shadow', 'h -= 0.05 * exp(-pow((abs(cx) - ww) / 0.03, 2.0)) * bgm;'), ('wedge_lift', 'h += 0.03 * (1.0 - lv) * inW;')]
    elif band == 2:
        for i in range(5):
            S += [('anther%d_head' % (i + 1), 'float dx = wrapd(s, AX[%d]) * 3.0 * 0.333; float ex = dx / chf("../c_anther_w"); float ey = (lv - 0.30) / chf("../c_anther_l"); float rr = sqrt(ex * ex + ey * ey); float m = 1.0 - sm(0.88, 1.0, rr); h = max(h, lerp(h, 0.62 + 0.16 * (1.0 - rr * rr), m));' % i),
                  ('anther%d_pollen' % (i + 1), 'float dx = wrapd(s, AX[%d]) * 3.0 * 0.333; float ex = dx / chf("../c_anther_w"); float ey = (lv - 0.30) / chf("../c_anther_l"); float rr = sqrt(ex * ex + ey * ey); float m = 1.0 - sm(0.88, 1.0, rr); h += chf("../c_pollen") * (noise(set(u * 420.0, vt * 420.0, %d.1)) - 0.5) * m;' % (i, i)),
                  ('anther%d_stalk' % (i + 1), 'float dx = wrapd(s, AX[%d]) * 3.0 * 0.333; float st = (1.0 - sm(0.006, 0.010, dx)) * sm(0.45, 0.50, lv); h = max(h, lerp(h, 0.55, st));' % i)]
        for i in range(3):
            S += [('filament%d_tip' % (i + 1), 'float dx = wrapd(s, FX[%d]) * 3.0 * 0.333; float top = %.2f; float ex = dx / 0.010; float ey = (lv - top) / 0.07; float rr = sqrt(ex * ex + ey * ey); h = max(h, lerp(h, 0.56, 1.0 - sm(0.9, 1.0, rr)));' % (i, 0.36 + 0.06 * i)),
                  ('filament%d_stalk' % (i + 1), 'float dx = wrapd(s, FX[%d]) * 3.0 * 0.333; float top = %.2f; float m = (1.0 - sm(0.006, 0.009, dx)) * sm(top, top + 0.02, lv); h = max(h, lerp(h, 0.56, m));' % (i, 0.36 + 0.06 * i))]
        S += [('stigma_head', 'float dx = wrapd(s, 0.37) * 3.0 * 0.333; float ex = dx / chf("../c_stigma_w"); float ey = (lv - 0.15) / 0.11; float rr = sqrt(ex * ex + ey * ey); h = max(h, lerp(h, 0.66 + 0.10 * (1.0 - rr * rr), 1.0 - sm(0.9, 1.0, rr)));'),
              ('stigma_rough', 'float dx = wrapd(s, 0.37) * 3.0 * 0.333; float ex = dx / chf("../c_stigma_w"); float ey = (lv - 0.15) / 0.11; float rr = sqrt(ex * ex + ey * ey); h += 0.10 * (noise(set(u * 300.0, vt * 300.0, 7.7)) - 0.5) * (1.0 - sm(0.9, 1.0, rr));'),
              ('stigma_stalk', 'float dx = wrapd(s, 0.37) * 3.0 * 0.333; float stw = 0.020 + 0.012 * sm(0.5, 1.0, lv); float m = (1.0 - sm(stw - 0.003, stw + 0.003, dx)) * sm(0.2, 0.26, lv); h = max(h, lerp(h, 0.58 + 0.05 * (1.0 - dx / stw), m));')]
        bg = 'h = 0.40 + 0.03 * pn(u, vt * 30.0, 4.4, 30.0);'
        S = [('ground', bg)] + S
        S += noises(r, 8, '1.0', 100, 300, 100, 300, 0.003, 0.008, 'bg_grain') + noises(r, 8, '(h > 0.5 ? 1.0 : 0.0)', 300, 700, 300, 700, 0.01, 0.03, 'pollen_micro')
        S += [('edge_shadow_1', 'h -= 0.03 * clamp(0.5 - h, 0.0, 1.0);'), ('edge_shadow_2', 'h -= 0.02 * clamp(0.45 - h, 0.0, 1.0);')]
    elif band == 3:
        S += [('ground', 'h = 0.30 + 0.06 * abs(cx);'), ('fan_fill', 'h = lerp(h, 0.52, inW);'), ('fan_dome', 'h += 0.05 * (1.0 - abs(t)) * inW;'), ('fan_ribs', 'h += 0.10 * (0.5 + 0.5 * cos(t * PI * 5.0)) * inW;'), ('cup_lip', 'h += 0.06 * sm(0.72, 0.76, lv) * inW;'), ('stalk_flute', 'h += 0.03 * cos(t * PI * 9.0) * sm(0.74, 0.80, lv) * inW;')]
        S += lines(r, 16, 'inW', 't', 4, 30, 0.008, 0.026, 0.8, 'rib')
        S += noises(r, 12, 'inW', 60, 220, 80, 300, 0.004, 0.012, 'texture')
        S += noises(r, 10, 'bgm', 40, 120, 20, 60, 0.004, 0.010, 'gap_grain')
        S += noises(r, 8, '1.0', 150, 500, 150, 500, 0.002, 0.005, 'grain')
        S += [('gap_shade', 'h -= 0.05 * bgm * (1.0 - lv);'), ('fan_shadow', 'h -= 0.05 * exp(-pow((abs(cx) - w) / 0.03, 2.0)) * bgm;'), ('stalk_dark_ring', 'h -= 0.05 * exp(-pow((lv - 0.72) / 0.015, 2.0)) * inW;'), ('base_pinch', 'h -= 0.04 * sm(0.92, 1.0, lv);')]
    elif band == 4:
        S += [('ground', 'h = 0.40 + 0.05 * edge;')]
        S += noises(r, 14, '1.0', 40, 160, 90, 260, 0.010, 0.040, 'fibre_long')
        S += noises(r, 14, '1.0', 120, 320, 200, 520, 0.006, 0.020, 'fibre_fine')
        for k in range(14):
            S += [('hair_%02d' % (k + 1), 'h += 0.07 * pow(pn(u + lv * %.3f, lv * %.1f, %.1f, %d.0), 14.0);' % (r.uniform(-0.05, 0.05), r.uniform(100, 400), r.uniform(0, 60), int(r.uniform(150, 420))))]
        for k in range(14):
            S += [('nodule_%02d' % (k + 1), 'h += %.3f * pow(pn(u, lv * %.1f, %.1f, %d.0), 6.0);' % (r.uniform(0.04, 0.12), r.uniform(30, 90), r.uniform(0, 60), int(r.uniform(120, 300))))]
        S += [('edge_shade_top', 'h -= 0.05 * sm(0.0, 0.1, 1.0 - edge) * 0.0 + 0.0;'), ('edge_shade_bottom', 'h -= 0.03 * sm(0.9, 1.0, lv);'), ('edge_shade_top2', 'h -= 0.03 * sm(0.1, 0.0, lv);'), ('mid_lift', 'h += 0.03 * edge;')]
    elif band == 5:
        S += [('ground', 'h = 0.36 + 0.03 * y;'), ('leaf_fill', 'h = lerp(h, 0.52, inW);'), ('leaf_dome', 'h += 0.06 * (1.0 - t * t) * inW;'), ('midrib', 'h += 0.14 * (1.0 - sm(0.0, 0.016, y)) * inW;'), ('midrib_groove', 'h -= 0.05 * exp(-pow((y - 0.028) / 0.008, 2.0)) * inW;'), ('leaf_rim', 'h += 0.05 * (1.0 - sm(0.0, 0.03, w - y)) * inW;'), ('wavy_rim_lift', 'h += 0.03 * sin(s * PI * 30.0) * (1.0 - sm(0.0, 0.05, w - y)) * inW;')]
        S += lines(r, 16, 'inW', '(y * 1.0 + s * 0.9)', 60, 140, 0.006, 0.022, 0.8, 'vein_oblique')
        S += lines(r, 8, 'inW', '(y * 1.0 - s * 0.9)', 40, 100, 0.004, 0.012, 0.8, 'vein_cross')
        S += noises(r, 10, 'inW', 60, 240, 60, 240, 0.004, 0.012, 'lamina')
        S += noises(r, 6, '1.0', 150, 450, 150, 450, 0.002, 0.005, 'grain')
        S += [('tip_pinch', 'h -= 0.04 * exp(-pow(s / 0.03, 2.0)) * inW;'), ('base_shade', 'h -= 0.02 * y * inW;'), ('outside_shade', 'h -= 0.03 * sm(0.0, 0.2, y - w) * (1.0 - inW);'), ('outside_shade_2', 'h += 0.02 * sm(0.3, 0.5, y) * (1.0 - inW);')]
    else:
        S += [('ground', 'h = 0.36 + 0.02 * pn(u, vt * 40.0, 3.0, 40.0);'), ('bud_fill', 'h = lerp(h, 0.50, inW);'), ('bud_dome', 'h += 0.20 * (1.0 - t * t) * inW;'), ('groove_1', 'h -= chf("../g_groove") * exp(-pow((abs(t) - 0.34) / 0.05, 2.0)) * inW;'), ('groove_2', 'h -= 0.08 * exp(-pow((abs(t) - 0.66) / 0.04, 2.0)) * inW;'), ('rim', 'h += 0.04 * (1.0 - sm(0.0, 0.04, w - abs(y))) * inW;'), ('tip_pinch', 'h -= 0.06 * exp(-pow(s / 0.03, 2.0)) * inW;')]
        S += lines(r, 16, 'inW', 't', 6, 30, 0.006, 0.020, 0.8, 'lobe_fibre')
        S += noises(r, 12, 'inW', 60, 240, 80, 320, 0.004, 0.012, 'texture')
        S += noises(r, 8, 'inW', 150, 450, 150, 450, 0.002, 0.006, 'wrinkle')
        S += noises(r, 6, '1.0', 150, 500, 150, 500, 0.002, 0.005, 'grain')
        S += [('groove_depth_1', 'h -= 0.03 * exp(-pow((abs(t) - 0.34) / 0.02, 2.0)) * inW;'), ('groove_depth_2', 'h -= 0.02 * exp(-pow((abs(t) - 0.66) / 0.02, 2.0)) * inW;')]
    S += finish()
    # exactly 64 stages: pad with fine grain layers or cut the finest grain layers
    while len(S) < 64: S.insert(len(S) - 4, ('extra_grain_%02d' % (len(S)), 'h += 0.003 * (pn(u, vt * %.1f, %.1f, %d.0) - 0.5);' % (r.uniform(200, 700), r.uniform(0, 90), int(r.uniform(200, 600)))))
    while len(S) > 64: del S[len(S) - 5]
    return S
