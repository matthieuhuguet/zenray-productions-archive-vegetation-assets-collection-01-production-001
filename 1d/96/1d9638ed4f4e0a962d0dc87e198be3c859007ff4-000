# 5 October 2026 : BAND 4 (stem) version 2, same protocol. The reference is a hairy cylinder seen from the side: a dark background above and below, a body band between lv 0.15 and 0.82, fine bright hairs flowing from rising to the right at the top (about +55 degrees) through horizontal in the middle to falling at the bottom (-55 degrees), as on a cylinder; bulbous hair bases (bright dots), and long guard hairs that cross the silhouette. The flow is a coordinate phi = y - x * k(y) with k = tan(angle(y)); the angle crosses zero at lv 0.5. Slanted lines cannot tile exactly, so the band is built on a sawtooth x of 4 cells: the hair strokes are short and a cell boundary is invisible, while the canvas edges stay seamless (every cell is identical). FR : bande 4 version 2, tige.
import hou, sys
sys.path.insert(0, '/Users/zenray/Create/Build/Productions/ZenRayHoudini/VegetationCollection01/Scripts')
import TrimNodes as T
import BuildBand0V2 as V
B = '/Users/zenray/Create/Build/Productions/ZenRayHoudini/VegetationCollection01/'
V0, V1, CELLS = 0.609, 0.725, 4; P = 1.0 / CELLS; HC = V1 - V0
UPTO = 99
ANGLE = [(0.0, 1.05), (0.15, 0.95), (0.3, 0.55), (0.5, 0.0), (0.7, -0.55), (0.85, -0.95), (1.0, -1.05)]   # tangent of the hair angle against lv (+55 degrees at the top, -55 at the bottom)
BODY = [(0.0, 0.0), (0.12, 0.0), (0.17, 1.0), (0.80, 1.0), (0.85, 0.0), (1.0, 0.0)]                           # silhouette mask of the cylinder against lv
def build(net):
    rx = T.node(net, 'ramp', 'A00_ramp__cycles_x', signature='f1', cycles=float(CELLS), method=1); ry = T.node(net, 'ramp', 'A01_ramp__down_y', signature='f1', rotation=90.0)
    lv = T.lin(net, 'A03_band__lv_0_top_1_bottom', ry, V0, V1); one = T.const(net, 'A04_one', lv, 1.0)
    body = T.curve(net, 'B01_body__mask', lv, BODY, 1.0, 0.0, 1.0, T.SMOOTH)
    tone = T.curve(net, 'B02_body__tone', lv, [(0.0, 0.22), (0.14, 0.24), (0.2, 0.38), (0.4, 0.44), (0.6, 0.44), (0.78, 0.38), (0.84, 0.25), (1.0, 0.22)], 1.0, 0.0, 1.0, T.SMOOTH)
    h = tone
    k = T.curve(net, 'B03_flow__tangent', lv, [(x, (y + 1.2) / 2.4) for x, y in ANGLE], 1.0, -1.2, 1.2, T.SMOOTH)
    kx = T.mix(net, 'B04_flow__k_times_x', k, T.lin(net, 'B04a_x_cell', rx, 0.0, 1.0, 0.0, P), 5)
    # canvas units: x within a cell (0 to 0.25), y within the band (0 to 0.116): phi in y units
    phi = T.mix(net, 'B05_flow__phi', T.lin(net, 'B05a_y', lv, 0.0, 1.0, 0.0, HC), kx, 4)
    soft = T.node(net, 'fractalnoise', 'B06_soft_phase_noise', [lv], amp=0.5, center=0.0, elementsize=0.05)
    c = dict(lv=lv, body=body, phi=phi, one=one, soft=soft, rx=rx)
    if UPTO >= 1: h = iteration1(net, h, c)
    return h
def iteration1(net, h, c):
    """ITERATION 1 (64 nodes): hairs. Dense fine dark grooves and bright fine hairs along the flow, each broken into short strokes by a noise mask; long sparse guard hairs that also cross the silhouette; bulbous bases (bright dots); fine grain."""
    lv, body, phi, one, soft = c['lv'], c['body'], c['phi'], c['one'], c['soft']
    n0 = len(net.children()); b = V.box(net, 'C', 'BAND 4 V2 ITERATION 1 : 64 nodes, hairs', (0.8, 1.0, 0.9))
    def strokes(tag, size, sx, sy, seed, lo):
        m = V.modulation(net, tag + '_noise', lv, size, sx, sy, seed, lo)
        return T.mix(net, tag + '_masked', body, m, 5)   # squared: short, sparse strokes
    m1 = strokes('C01_strokes_a', 0.008, 2.5, 1.0, 3.1, 0.0); m2 = strokes('C02_strokes_b', 0.006, 2.5, 1.0, 9.7, 0.0)
    h = V.lines_layer(net, 'C11_grooves_fine', h, phi, 330, soft, 0.04, 0.22, 0.25, m1, lv)
    h = V.lines_layer(net, 'C12_hairs_bright', h, phi, 180, soft, 0.04, -0.55, 0.22, m2, lv)
    h = V.lines_layer(net, 'C13_hairs_bright_b', h, phi, 260, soft, 0.04, -0.45, 0.22, m1, lv)
    sp = T.mix(net, 'C21_guard__mask', one, V.modulation(net, 'C20_guard__noise', lv, 0.03, 3.0, 0.4, 21.3, 0.0), 5)
    h = V.lines_layer(net, 'C22_guard_hairs', h, phi, 55, soft, 0.04, -0.70, 0.10, sp, lv)
    h = V.dots_layer(net, 'C31_bases', h, lv, body, 0.0030, 5.5, 0.60, 0.40)
    h = V.pads(net, 'C', h, n0); V.close(net, b, 'C', n0); return h
if __name__ == '__main__':
    hou.hipFile.clear(suppress_save_prompt=True); net = hou.node('/obj').createNode('copnet', 'Band4V2_test'); res = int(sys.argv[3]) if len(sys.argv) > 3 else 2048
