# 6 October 2026 : TWO movies from the v004 montage (Matthieu): HOOK = the flower bed orbit (title keyed at FULL RESOLUTION 3840 x 2160 from 1.0 s), then either 'petals' (height storyboard + the 3 petals) or 'trim' (height_evolution_complete.mp4), and the END = the single flower close orbit retimed to 5 s. No Karma render, no turn over, no trim sheet stills any more. Canvas 2048 x 2048 (the 2K renders and the 2048 height evolution are native).
# Usage: python3 AssembleLilyMovieV5.py petals|trim [version]. FR : deux montages, hook parterre, titre pleine resolution, fin sur la fleur seule en 5 s.
import os, sys, glob, json, subprocess, shutil
import numpy as np
from PIL import Image
P = '/Users/zenray/Create/Build/Productions/ZenRayHoudini/VegetationCollection01/'; TMP = '/Users/zenray/.claude/tmp/tmp-vegetation-assets-collection-01/'
KIND = sys.argv[1]; VER = sys.argv[2] if len(sys.argv) > 2 else 'v005'; assert KIND in ('petals', 'trim')
OUT = P + 'video/'; WORK = OUT + '_work_%s/' % KIND; TITLEDIR = OUT + '_work_title/'
SQ, FPS = 2048, 24; W, H = SQ, int(round(SQ / 1.727))        # petal storyboard ratio 418 x 242 = 1.727
HOOK_S, TITLE_START_S, TITLE_S, END_S = 6.0, 1.0, 5.0, 5.0
STEP, LAST_HOLD, PETAL_S = 8, 24, 24
TITLE = P + 'maps/trim/petals/title-animation/vogun-cyber/vogun-cyber-pingpong-yellow.mov'
MUSIC = TMP + 'audio/Grandbrothers - Sonic Riots (3m59 to end).mp3'; HEIGHT_EVO = P + 'versions/height_evolution/height_evolution_complete.mp4'
BED = P + 'render/bed_orbit_flat_2k/flat_%04d.png'; CLOSE = P + 'render/flower_close_orbit_2k/close_%04d.png'
os.makedirs(WORK + 'imgs', exist_ok=True)
def run(cmd): subprocess.run(cmd, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
def prep(src, name):
    im = Image.open(src).convert('RGB'); canvas = Image.new('RGB', (SQ, SQ), (0, 0, 0))
    if abs(im.size[0] - im.size[1]) < 4: canvas = im.resize((SQ, SQ), Image.LANCZOS)
    else: canvas.paste(im.resize((W, H), Image.LANCZOS), (0, (SQ - H) // 2))
    p = WORK + 'imgs/' + name + '.png'; canvas.save(p); return p
def seg_from_shots(shots, out):
    lst = ['ffconcat version 1.0']
    for name, src, n in shots: lst += ["file '%s'" % prep(src, name), 'duration %.6f' % (n / float(FPS))]
    lst.append("file '%s'" % (WORK + 'imgs/' + shots[-1][0] + '.png')); open(out + '.txt', 'w').write('\n'.join(lst))
    run(['ffmpeg', '-y', '-f', 'concat', '-safe', '0', '-i', out + '.txt', '-vf', 'fps=%d,format=yuv420p' % FPS, '-frames:v', str(sum(n for _, _, n in shots)), '-c:v', 'libx264', '-crf', '8', out])
if not glob.glob(TITLEDIR + 't_*.png'):
    os.makedirs(TITLEDIR, exist_ok=True); run(['ffmpeg', '-y', '-i', TITLE, '-t', '%g' % TITLE_S, '-vf', 'fps=%d' % FPS, TITLEDIR + 'raw_%04d.png'])      # NO downscale: the keyed title is 3840 x 2160
    subprocess.run('ls %sraw_*.png | xargs -n 8 -P 16 python3 %sScripts/KeyTitleFrame.py' % (TITLEDIR, P), shell=True, check=True)
# hook: the bed orbit (240 frames, 10 s) compressed to HOOK_S, camera easing kept
n_hook = int(HOOK_S * FPS); run(['ffmpeg', '-y', '-framerate', '%g' % (240 / HOOK_S), '-i', BED, '-vf', 'fps=%d,format=yuv420p' % FPS, '-frames:v', str(n_hook), '-c:v', 'libx264', '-crf', '8', WORK + 'seg_hook.mp4'])
# end: the single flower close orbit (240 frames, 10 s) compressed to 5 s
n_end = int(END_S * FPS); run(['ffmpeg', '-y', '-framerate', '%g' % (240 / END_S), '-i', CLOSE, '-vf', 'fps=%d,format=yuv420p' % FPS, '-frames:v', str(n_end), '-c:v', 'libx264', '-crf', '8', WORK + 'seg_end.mp4'])
shots = [('hook_bed_orbit_flat_2k', BED, n_hook)]; segs = [WORK + 'seg_hook.mp4']
if KIND == 'petals':
    rest = []; hf = sorted(glob.glob(TMP + 'petal_movie/frames/f*.png'))
    for i, f in enumerate(hf): rest.append(('h%03d' % (i + 1), f, LAST_HOLD if i == len(hf) - 1 else STEP))
    for k in (1, 2, 3): rest.append(('petal%d' % k, P + 'maps/trim/petals/lily_petal_0%d_basecolor.png' % k, PETAL_S))
    seg_from_shots(rest, WORK + 'seg_mid.mp4'); shots += rest
else:
    run(['ffmpeg', '-y', '-i', HEIGHT_EVO, '-vf', 'fps=%d,scale=%d:%d,format=yuv420p' % (FPS, SQ, SQ), '-c:v', 'libx264', '-crf', '8', WORK + 'seg_mid.mp4'])
    d = float(subprocess.run(['ffprobe', '-v', 'error', '-show_entries', 'format=duration', '-of', 'csv=p=0', WORK + 'seg_mid.mp4'], capture_output=True, text=True).stdout); shots.append(('height_evolution_complete', HEIGHT_EVO, int(round(d * FPS))))
segs += [WORK + 'seg_mid.mp4', WORK + 'seg_end.mp4']; shots.append(('flower_close_orbit_2k_5s', CLOSE, n_end))
open(WORK + 'segs.txt', 'w').write('\n'.join("file '%s'" % s for s in segs)); run(['ffmpeg', '-y', '-f', 'concat', '-safe', '0', '-i', WORK + 'segs.txt', '-c', 'copy', WORK + 'body.mp4'])
total_s = sum(n for _, _, n in shots) / float(FPS); th = int(round(SQ * 9 / 16.0))
vf = "[1:v]scale=%d:%d:flags=lanczos,setpts=PTS+%g/TB[t];[0:v][t]overlay=0:%d:eof_action=pass,format=yuv420p[v]" % (SQ, th, TITLE_START_S, (SQ - th) // 2)
af = 'loudnorm=I=-14:TP=-1.5:LRA=11,afade=t=in:st=0:d=0.4,afade=t=out:st=%.3f:d=1.5' % (total_s - 1.5)      # 6 October 2026: -14 LUFS, true peak -1.5 dB (one pass here; the two released v005 files were normalised in two passes)
base = ['ffmpeg', '-y', '-i', WORK + 'body.mp4', '-framerate', str(FPS), '-i', TITLEDIR + 't_%04d.png', '-i', MUSIC, '-filter_complex', vf, '-map', '[v]', '-map', '2:a', '-af', af, '-t', '%.3f' % total_s, '-r', str(FPS)]
tag = 'LilyHeight_%s_%s' % (KIND, VER)
run(base + ['-c:v', 'hevc_videotoolbox', '-b:v', '24M', '-tag:v', 'hvc1', '-color_primaries', 'bt709', '-color_trc', 'bt709', '-colorspace', 'bt709', '-c:a', 'aac', '-b:a', '320k', '-movflags', '+faststart', OUT + tag + '.mov'])
run(base + ['-c:v', 'libx264', '-crf', '17', '-pix_fmt', 'yuv420p', '-c:a', 'aac', '-b:a', '320k', '-movflags', '+faststart', OUT + tag + '.mp4'])
t = 0.0; rows = []
for name, src, n in shots: rows.append((t, t + n / float(FPS), name, src)); t += n / float(FPS)
json.dump(dict(movie=tag, fps=FPS, size=[SQ, SQ], seconds=round(total_s, 3), title=TITLE, title_resolution=[3840, 2160], title_start_s=TITLE_START_S, music=MUSIC, timeline=[dict(start=round(a, 3), end=round(b, 3), shot=n, source=s) for a, b, n, s in rows]), open(OUT + tag + '.manifest.json', 'w'), indent=1)
shutil.rmtree(WORK); print(tag, round(total_s, 2), 's')
